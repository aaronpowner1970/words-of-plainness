---
layout: layouts/page.njk
title: Send a correction
pageTitle: Send a correction
pageSubtitle: "If we have cited your tradition wrongly, please tell us."
permalink: /corrections/
description: "Tell us where we have cited a church's text wrongly."
noindex: true
pagefindIgnore: true
eleventyExcludeFromCollections: true
---
{#- HIDDEN PAGE (CODE-AOID2-110). Not linked from anywhere, out of every collection (so out of the
    sitemap), out of site search, and noindex. The form is SWITCHED OFF: api/corrections.js refuses every
    submission unless CORRECTIONS_ENABLED is "true". No email address appears in this page or the repo. -#}
<link rel="stylesheet" href="/css/corrections.css?v={{ site.version }}">
<section class="content-section" id="corrections">
  <div class="content-wrapper cx" data-pagefind-ignore>
    {%- if not correctionsForm.enabled %}
    <p class="cx-closed" role="status">This form is not yet open. Nothing sent from it will be delivered yet.</p>
    {%- endif %}

    <p>Every field is optional except the last. If you give an email address we can reply to you; we keep nothing else about you.</p>

    <form class="cx-form" id="cx-form" action="/api/corrections" method="post" novalidate>
      <label class="cx-label" for="cx-name">Your name <span class="cx-opt">(optional)</span></label>
      <input class="cx-field" type="text" id="cx-name" name="name" maxlength="200" autocomplete="name">

      <label class="cx-label" for="cx-email">Your email, if you would like a reply <span class="cx-opt">(optional)</span></label>
      <input class="cx-field" type="email" id="cx-email" name="email" maxlength="254" autocomplete="email">

      <label class="cx-label" for="cx-tradition">Tradition <span class="cx-opt">(optional)</span></label>
      <select class="cx-field" id="cx-tradition" name="tradition">
        <option value="">Choose one</option>
        {%- for b in livingTree.branches %}{% if b.kind == "family" %}
        <option value="{{ b.label }}">{{ b.label }}</option>
        {%- endif %}{% endfor %}
        <option value="Other">Other</option>
      </select>

      <label class="cx-label" for="cx-page">The Article or page concerned <span class="cx-opt">(optional)</span></label>
      <input class="cx-field" type="text" id="cx-page" name="page" maxlength="300">

      <label class="cx-label" for="cx-cited">What we cited <span class="cx-opt">(optional)</span></label>
      <textarea class="cx-field" id="cx-cited" name="cited" rows="3" maxlength="3000"></textarea>

      <label class="cx-label" for="cx-wrong">What is wrong <span class="cx-opt">(optional)</span></label>
      <textarea class="cx-field" id="cx-wrong" name="wrong" rows="3" maxlength="5000"></textarea>

      <label class="cx-label" for="cx-source">A link to a source that supports the correction <span class="cx-opt">(optional)</span></label>
      <input class="cx-field" type="url" id="cx-source" name="source" maxlength="1000" placeholder="https://">

      <label class="cx-label" for="cx-message">Your correction, in your own words <span class="cx-req">(required)</span></label>
      <textarea class="cx-field" id="cx-message" name="message" rows="6" maxlength="8000" required aria-required="true"></textarea>

      {#- Honeypot: people never see or reach this field; a bot that fills it in is refused. -#}
      <div class="cx-hp" aria-hidden="true">
        <label for="cx-website">Leave this field empty</label>
        <input type="text" id="cx-website" name="website" tabindex="-1" autocomplete="off">
      </div>
      <input type="hidden" name="elapsed_ms" id="cx-elapsed" value="0">

      {%- if correctionsForm.siteKey %}
      <div class="cf-turnstile cx-turnstile" data-sitekey="{{ correctionsForm.siteKey }}" data-theme="dark"></div>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      {%- else %}
      <p class="cx-small">The check that guards this form against automated sending is not set up yet.</p>
      {%- endif %}

      <button type="submit" class="cx-btn" id="cx-send">Send</button>
      <p class="cx-result" id="cx-result" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
(function () {
  var form = document.getElementById('cx-form');
  if (!form || !window.fetch) return;
  var started = Date.now();
  var result = document.getElementById('cx-result'), send = document.getElementById('cx-send');
  var elapsed = document.getElementById('cx-elapsed');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    elapsed.value = String(Date.now() - started);
    var data = {};
    new FormData(form).forEach(function (v, k) { data[k] = typeof v === 'string' ? v : ''; });
    send.disabled = true;
    result.className = 'cx-result';
    result.textContent = 'Sending…';
    fetch(form.action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) })
      .then(function (r) { return r.json().catch(function () { return { ok: false, message: 'Something went wrong, and nothing was sent.' }; }); })
      .then(function (out) {
        result.textContent = out.message || (out.ok ? 'Sent.' : 'Nothing was sent.');
        result.className = 'cx-result ' + (out.ok ? 'cx-ok' : 'cx-err');
        if (out.ok) { form.reset(); started = Date.now(); }
        if (window.turnstile && !out.ok) { try { window.turnstile.reset(); } catch (err) {} }
      })
      .catch(function () {
        result.textContent = 'The form could not reach the server, and nothing was sent. Please try again later.';
        result.className = 'cx-result cx-err';
      })
      .then(function () { send.disabled = false; });
  });
})();
</script>
