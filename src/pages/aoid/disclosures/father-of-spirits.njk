---js
{
  layout: "layouts/study.njk",
  title: "Of the Father of Spirits: A Disclosure of Witness",
  pageTitle: "Of the Father of Spirits",
  pageSubtitle: "A Disclosure of Witness",
  permalink: "/aoid/disclosures/father-of-spirits/",
  description: "Why the teaching that God is the Father of our spirits, in Article 2, is set down as biblically anchored witness rather than as common ground: how sixteen Christian traditions stand on it, by their own adopted texts.",
  eleventyExcludeFromCollections: true,
  // Non-rendered record. Scored by Chat (CHAT-AOID2-18a), 9 Oct 2026, against WoP-Teaching-Practices-Standard.md.
  teachingPracticesScore: {
    score: "about 16/20 (13 of 16 scored, criteria 2 and 7 N/A) with the correction line",
    notApplicable: [2, 7],
    gaps: [1, 5, 9],
    gates: "met (G3 read as not applying to adherent estimates required by codex B4)",
    scoredBy: "Chat (CHAT-AOID2-18a)",
    scoredOn: "2026-10-09",
    revised: "row, count and terminology wording revised 11 Oct 2026 (CHAT-AOID2-22a), not rescored"
  },
  // The disclosure text is read and rendered at build time by src/_data/aoidDisclosures.js
  // (the same reader the Article tabs use), so later source edits flow through.
}
---

<style>
.disc { max-width: 760px; margin: 0 auto; padding: 0 1.25rem; font-family: 'Crimson Pro', Georgia, serif; font-size: 1.1rem; line-height: 1.75; color: var(--cream); }
.disc p, .disc li { opacity: .94; }
.disc p { margin: 0 0 1rem; }
.disc ul, .disc ol { margin: 0 0 1.1rem; padding-left: 1.5rem; }
.disc li { margin-bottom: .5rem; }
.disc strong { color: var(--gold-primary); font-weight: 600; }
.disc a { color: var(--gold-primary); text-decoration: none; border-bottom: 1px dotted rgba(196,148,58,0.5); }
.disc a:hover { color: var(--gold-light); border-bottom-color: var(--gold-light); }
.disc-record { margin: 2rem 0 1.5rem; }
.disc-record > summary { cursor: pointer; list-style: none; font-size: 1.05rem; font-weight: 600; color: var(--gold-primary); padding: .5rem 0; }
.disc-record > summary::-webkit-details-marker { display: none; }
.disc-record > summary::before { content: '\25B8'; display: inline-block; margin-right: .5rem; transition: transform .2s; }
.disc-record[open] > summary::before { transform: rotate(90deg); }
.disc-record-body { font-size: .98rem; line-height: 1.65; padding-top: .5rem; }
.disc-table-wrap { overflow-x: auto; margin: 0 0 1.25rem; }
.disc table { border-collapse: collapse; width: 100%; font-size: .9rem; line-height: 1.5; }
.disc th, .disc td { border: 1px solid rgba(196,148,58,0.2); padding: .45rem .6rem; text-align: left; vertical-align: top; }
.disc th { color: var(--gold-primary); background: rgba(196,148,58,0.06); }
.disc-correction { margin: 2.25rem 0 1rem; padding: .9rem 1.2rem; border-left: 3px solid rgba(196,148,58,0.55); background: rgba(196,148,58,0.06); border-radius: 0 4px 4px 0; font-size: 1rem; }
.disc-correction p { margin: 0; }
</style>

<div class="disc">
{{ aoidDisclosures.fatherOfSpirits.standalone.body | safe }}

<details class="disc-record">
<summary>The record behind the counts</summary>
<div class="disc-record-body">
{{ aoidDisclosures.fatherOfSpirits.standalone.record | safe }}
</div>
</details>

<div class="disc-correction">
<p>{{ aoidDisclosures.correctionHtml | safe }}</p>
</div>
</div>

<script>
// The "What the sixteen cover" link in the study points into the collapsed record: open it, then go there.
(function () {
  var d = document.querySelector('.disc-record');
  function go() {
    var id = decodeURIComponent(location.hash.slice(1));
    var t = id && document.getElementById(id);
    if (d && t && d.contains(t)) { d.open = true; t.scrollIntoView(); }
  }
  window.addEventListener('hashchange', go);
  document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a[href^="#"]')) setTimeout(go, 0); });
  go();
})();
</script>
