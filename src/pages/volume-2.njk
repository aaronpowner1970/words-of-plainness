---
layout: layouts/page.njk
title: "Volume 2: Covenants and Theology"
permalink: /volume-2/
description: "Covenants and Theology of The Church of Jesus Christ of Latter-day Saints — 23 chapters tracing God's plan from premortal life to eternal inheritance."
---

<style>
/* ── HERO TITLE — matches vol1-hero-title ──── */
.vol2-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--cream);
    text-align: center;
    line-height: 1.3;
    margin: 0 auto var(--space-xs);
    padding-top: var(--space-lg);
}

.vol2-hero-title .vol2-series {
    display: block;
    font-size: 0.6em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 0.3em;
}

/* ── INTRO & NOTE ───────────────────────────── */
.vol2-intro {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.9;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    color: var(--cream);
}

.vol2-note {
    max-width: 640px;
    margin: var(--space-md) auto 0;
    padding: var(--space-sm) var(--space-md);
    background: rgba(196, 148, 58, 0.08);
    border: 1px solid rgba(196, 148, 58, 0.2);
    border-radius: var(--radius-md);
    text-align: center;
    font-size: 0.95rem;
    color: var(--cream);
    opacity: 0.85;
}

.vol2-note a {
    color: var(--gold-primary);
    border-bottom: 1px dotted var(--gold-primary);
}

.vol2-note a:hover {
    border-bottom-style: solid;
}

/* ── ACCORDION — matches vol1 ──────────────── */
.movement-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
}

.movement-section {
    background: var(--overlay-medium);
    border: 1px solid rgba(196, 148, 58, 0.15);
    border-radius: var(--radius-md);
    overflow: hidden;
}

.movement-section.is-open {
    border-color: rgba(196, 148, 58, 0.35);
}

.movement-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md);
    cursor: pointer;
    user-select: none;
    border-left: 3px solid var(--gold-primary);
    transition: background var(--transition-fast);
    background: transparent;
    width: 100%;
    text-align: left;
    color: var(--cream);
    font-family: inherit;
}

.movement-header:hover {
    background: rgba(196, 148, 58, 0.06);
}

.movement-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.movement-header-label {
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--gold-primary);
    line-height: 1;
}

.movement-header-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--cream-soft);
    line-height: 1.2;
}

.movement-header-meta {
    font-size: 0.82rem;
    color: var(--cream);
    opacity: 0.6;
    margin-top: 0.15rem;
}

.movement-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
}

.movement-header-desc {
    font-size: 0.85rem;
    color: var(--cream);
    opacity: 0.65;
    max-width: 340px;
    line-height: 1.5;
    text-align: right;
}

.movement-chevron {
    width: 20px;
    height: 20px;
    color: var(--gold-primary);
    opacity: 0.7;
    flex-shrink: 0;
    transition: transform var(--transition-normal);
}

.movement-section.is-open .movement-chevron {
    transform: rotate(180deg);
}

.movement-body {
    display: none;
    padding: 0 var(--space-md) var(--space-md);
}

.movement-section.is-open .movement-body {
    display: block;
}

/* ── CHAPTER LIST ──────────────────────────── */
.chapter-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
}

.chapter-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.75rem var(--space-sm);
    background: rgba(26, 21, 16, 0.4);
    border: 1px solid rgba(196, 148, 58, 0.1);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    text-decoration: none;
    color: var(--cream);
}

.chapter-item.disabled {
    opacity: 0.55;
    cursor: default;
}

.chapter-item-info {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
}

.chapter-num {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--gold-primary);
    font-size: 0.9rem;
    white-space: nowrap;
}

.chapter-title {
    font-size: 0.95rem;
    color: var(--cream);
}

.badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
}

.badge-soon {
    background: rgba(232, 220, 196, 0.08);
    color: var(--cream);
    opacity: 0.5;
    border: 1px solid rgba(232, 220, 196, 0.12);
}

/* ── CONTENT SECTION SPACING — matches vol1 ── */
.content-section {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
}

/* ── CTA ───────────────────────────────────── */
.vol2-cta {
    text-align: center;
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(196, 148, 58, 0.2);
    margin-top: var(--space-lg);
}

.vol2-cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-md);
}

/* ── MOBILE ─────────────────────────────────── */
@media (max-width: 768px) {
    .movement-header-desc {
        display: none;
    }
    .chapter-item {
        flex-wrap: wrap;
        gap: 0.35rem;
    }
    .vol2-cta-buttons {
        flex-direction: column;
        align-items: center;
    }
    .vol2-cta-buttons .btn {
        width: 100%;
        max-width: 280px;
    }
    .page-header {
        padding-bottom: var(--space-xs);
    }
    .vol2-hero-title {
        padding-top: var(--space-sm);
    }
    .content-section {
        padding-top: var(--space-sm);
        padding-bottom: var(--space-sm);
    }
}
</style>

<!-- Custom Hero Title — matches vol1-hero-title pattern -->
<h1 class="vol2-hero-title">
    <span class="vol2-series">Words of Plainness &mdash; Volume 2</span>
    Covenants and Theology of The Church of Jesus&nbsp;Christ of Latter-day Saints
</h1>

<!-- Introduction -->
<section class="content-section">
    <div class="content-wrapper">
        <p class="vol2-intro">
            Volume 1 invited you to meet Christ first. Volume 2 goes deeper&mdash;into
            the covenants and theology that Latter-day Saints hold sacred. From the nature
            of God and the spiritual creation to the Plan of Salvation and our eternal
            inheritance, these chapters present the full framework of restored truth.
            Designed for readers ready to go further.
        </p>
        <p class="vol2-note">
            Volume 2 builds naturally on <a href="/volume-1/">Volume 1</a>
            but can also be studied independently by readers with a foundation
            in the restored gospel.
        </p>
    </div>
</section>

<!-- Chapter Listing -->
<section class="content-section alt">
    <div class="content-wrapper" style="max-width: 900px;">

        {% set volume = chapterStatus.volume_2 %}
        {% include "components/volume-accordion.njk" %}

        <!-- CTA -->
        <div class="vol2-cta">
            <h2 style="color: var(--gold-primary);">Stay Updated</h2>
            <p style="opacity: 0.85; font-size: 1.05rem; line-height: 1.7;">
                Subscribe to be notified as Volume 2 chapters become available,
                or start with Volume 1 if you haven&rsquo;t yet.
            </p>
            <div class="vol2-cta-buttons">
                <a href="/volume-1/" class="btn btn-primary">Explore Volume 1</a>
                <a href="/connect/#newsletter" class="btn btn-outline-gold">Subscribe for Updates</a>
            </div>
        </div>

    </div>
</section>

<script>
(function () {
    'use strict';

    const STORAGE_KEY = 'wop_vol2_accordion';
    const DEFAULT_OPEN = ['v2m1'];

    function loadState() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : null;
        } catch (e) {
            return null;
        }
    }

    function saveState(openIds) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(openIds));
        } catch (e) { /* storage unavailable */ }
    }

    function applyState(section, isOpen) {
        const btn = section.querySelector('.movement-header');
        section.classList.toggle('is-open', isOpen);
        btn.setAttribute('aria-expanded', String(isOpen));
    }

    function toggle(section) {
        const isNowOpen = !section.classList.contains('is-open');
        applyState(section, isNowOpen);

        const openIds = Array.from(
            document.querySelectorAll('.movement-section.is-open')
        ).map(function (s) { return s.id.replace('acc-', ''); });
        saveState(openIds);
    }

    document.addEventListener('DOMContentLoaded', function () {
        var sections = document.querySelectorAll('.movement-section');
        var saved    = loadState();
        var openIds  = saved !== null ? saved : DEFAULT_OPEN;

        sections.forEach(function (section) {
            var id     = section.id.replace('acc-', '');
            var isOpen = openIds.includes(id);
            applyState(section, isOpen);

            section.querySelector('.movement-header').addEventListener('click', function () {
                toggle(section);
            });
        });
    });
}());
</script>