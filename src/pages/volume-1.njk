<script>
(function () {
    'use strict';

    const STORAGE_KEY = 'wop_vol1_accordion';
    const DEFAULT_OPEN = ['m1'];

    // ── Read / write localStorage ───────────────────────────────
    function loadState() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : null;
        } catch (e) {
            return null;
        }
    }

    function saveState(openIds) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(openIds));
        } catch (e) { /* storage unavailable — silent */ }
    }

    // ── Apply open/closed state to a section ───────────────────
    function applyState(section, isOpen) {
        const btn  = section.querySelector('.movement-header');
        const body = section.querySelector('.movement-body');
        section.classList.toggle('is-open', isOpen);
        btn.setAttribute('aria-expanded', String(isOpen));
    }

    // ── Toggle a single section ─────────────────────────────────
    function toggle(section) {
        const isNowOpen = !section.classList.contains('is-open');
        applyState(section, isNowOpen);

        // Persist new state
        const openIds = Array.from(
            document.querySelectorAll('.movement-section.is-open')
        ).map(s => s.id.replace('acc-', ''));
        saveState(openIds);
    }

    // ── Decorate chapter rows from localStorage flags ────────
    function decorateChapterStatus() {
        try {
            document.querySelectorAll('.chapter-item[data-chapter-id]').forEach(function (row) {
                const id = row.dataset.chapterId;
                const bookmarked = localStorage.getItem('wop-bookmark-flag-' + id) === 'true';
                const completed  = localStorage.getItem('wop-complete-' + id)   === 'true';
                const bmIcon = row.querySelector('.ch-icon-bookmark');
                const cpIcon = row.querySelector('.ch-icon-complete');
                if (bmIcon) bmIcon.classList.toggle('visible', bookmarked);
                if (cpIcon) cpIcon.classList.toggle('visible', completed);
            });
        } catch (e) { /* localStorage unavailable */ }
    }

    // ── Initialise ──────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        const sections = document.querySelectorAll('.movement-section');
        const saved    = loadState();
        const openIds  = saved !== null ? saved : DEFAULT_OPEN;

        sections.forEach(function (section) {
            const id     = section.id.replace('acc-', '');
            const isOpen = openIds.includes(id);
            applyState(section, isOpen);

            section.querySelector('.movement-header').addEventListener('click', function () {
                toggle(section);
            });
        });

        // Decorate chapter rows with bookmark / complete icons
        decorateChapterStatus();

        // Keep in sync if another tab writes to localStorage
        window.addEventListener('storage', function (e) {
            if (e.key && (e.key.startsWith('wop-bookmark-flag-') || e.key.startsWith('wop-complete-'))) {
                decorateChapterStatus();
            }
        });
    });
}());
</script>
