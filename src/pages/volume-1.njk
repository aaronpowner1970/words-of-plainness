---
layout: layouts/page.njk
title: "Volume 1: Christ-Centered Discipleship"
permalink: /volume-1/
---

<style>
.vol1-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--cream);
    text-align: center;
    line-height: 1.3;
    margin: 0 auto var(--space-xs);
}

.vol1-hero-title .vol1-series {
    display: block;
    font-size: 0.6em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 0.3em;
}

.vol1-intro {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.9;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    color: var(--cream);
}

/* ── ACCORDION ─────────────────────────────── */
.movement-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
}

.movement-section {
    background: var(--overlay-medium);
    border: 1px solid rgba(196, 148, 58, 0.15);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-normal);
}

.movement-section.is-open {
    border-color: rgba(196, 148, 58, 0.35);
}

.movement-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-md);
    cursor: pointer;
    user-select: none;
    border-left: 3px solid var(--gold-primary);
    transition: background var(--transition-fast);
    /* no default button styles */
    background: transparent;
    width: 100%;
    text-align: left;
    color: var(--cream);
    font-family: inherit;
}

.movement-header:hover {
    background: rgba(196, 148, 58, 0.06);
}

.movement-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.movement-header-label {
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--gold-primary);
    line-height: 1;
}

.movement-header-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--cream-soft);
    line-height: 1.2;
}

.movement-header-meta {
    font-size: 0.82rem;
    color: var(--cream);
    opacity: 0.6;
    margin-top: 0.15rem;
}

.movement-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
}

.movement-header-desc {
    font-size: 0.85rem;
    color: var(--cream);
    opacity: 0.65;
    max-width: 340px;
    line-height: 1.5;
    text-align: right;
}

.movement-chevron {
    width: 20px;
    height: 20px;
    color: var(--gold-primary);
    opacity: 0.7;
    flex-shrink: 0;
    transition: transform var(--transition-normal);
}

.movement-section.is-open .movement-chevron {
    transform: rotate(180deg);
}

/* ── ACCORDION BODY ────────────────────────── */
.movement-body {
    display: none;
    padding: 0 var(--space-md) var(--space-md);
}

.movement-section.is-open .movement-body {
    display: block;
}

/* ── CHAPTER LIST ──────────────────────────── */
.chapter-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
}

.chapter-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.75rem var(--space-sm);
    background: rgba(26, 21, 16, 0.4);
    border: 1px solid rgba(196, 148, 58, 0.1);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    text-decoration: none;
    color: var(--cream);
}

a.chapter-item:hover {
    border-color: var(--gold-primary);
    background: rgba(45, 32, 22, 0.92);
}

.chapter-item-info {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
}

.chapter-num {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--gold-primary);
    font-size: 0.9rem;
    white-space: nowrap;
}

.chapter-title {
    font-size: 0.95rem;
    color: var(--cream);
}

.badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
}

.badge-available {
    background: rgba(76, 175, 80, 0.15);
    color: #81C784;
    border: 1px solid rgba(76, 175, 80, 0.3);
}

.badge-soon {
    background: rgba(232, 220, 196, 0.08);
    color: var(--cream);
    opacity: 0.5;
    border: 1px solid rgba(232, 220, 196, 0.12);
}

.chapter-item.disabled {
    opacity: 0.55;
    cursor: default;
}

/* ── CHAPTER STATUS ICONS ─────────────────── */
.chapter-status-icons {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    margin-right: 6px;
    flex-shrink: 0;
}

.ch-icon {
    display: none;          /* hidden until flag is set */
    width: 18px;
    height: 18px;
    opacity: 0.9;
}

.ch-icon.visible {
    display: block;
}

.ch-icon-bookmark { color: var(--gold-primary); }
.ch-icon-complete  { color: var(--gold-light); }

.chapter-status-label {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
}
.chapter-status-label.label-bookmark { color: var(--gold-primary); opacity: 0.85; }
.chapter-status-label.label-complete  { color: var(--gold-light);   opacity: 0.85; }

/* ── DESKTOP SPACING — page-specific overrides ── */
/*
  The global .page-header has 4rem bottom padding and .content-section
  has 4rem top/bottom padding — too generous for this two-section layout.
  These overrides apply at all screen sizes above the 768px mobile breakpoint.
*/
.vol1-hero-title {
    padding-top: var(--space-lg);
}
.content-section {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
}

/* ── CTA ───────────────────────────────────── */
.vol1-cta {
    text-align: center;
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(196, 148, 58, 0.2);
    margin-top: var(--space-lg);
}

.vol1-cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-md);
}

@media (max-width: 768px) {
    .movement-header-desc {
        display: none;
    }
    .chapter-item {
        flex-wrap: wrap;
        gap: 0.35rem;
    }
    .vol1-cta-buttons {
        flex-direction: column;
        align-items: center;
    }
    .vol1-cta-buttons .btn {
        width: 100%;
        max-width: 280px;
    }
    /* Tighten all vertical spacing on mobile */
    .page-header {
        padding-bottom: var(--space-xs);
    }
    .vol1-hero-title {
        padding-top: var(--space-sm);
    }
    .content-section {
        padding-top: var(--space-sm);
        padding-bottom: var(--space-sm);
    }
}
</style>

