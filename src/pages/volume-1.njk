---
layout: layouts/page.njk
title: "Volume 1: Christ-Centered Discipleship"
permalink: /volume-1/
description: "Christ-Centered Discipleship — 37 chapters from finding faith through knowing Christ to practicing discipleship and understanding the Restoration."
---

<style>
.vol1-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--cream);
    text-align: center;
    line-height: 1.3;
    margin: 0 auto var(--space-xs);
}

.vol1-hero-title .vol1-series {
    display: block;
    font-size: 0.6em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 0.3em;
}

.vol1-intro {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.9;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    color: var(--cream);
}

/* ── ACCORDION ─────────────────────────────── */
.movement-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
}

.movement-section {
    background: var(--overlay-medium);
    border: 1px solid rgba(196, 148, 58, 0.15);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-normal);
}

.movement-section.is-open {
    border-color: rgba(196, 148, 58, 0.35);
}

.movement-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-md);
    cursor: pointer;
    user-select: none;
    border-left: 3px solid var(--gold-primary);
    transition: background var(--transition-fast);
    /* no default button styles */
    background: transparent;
    width: 100%;
    text-align: left;
    color: var(--cream);
    font-family: inherit;
}

.movement-header:hover {
    background: rgba(196, 148, 58, 0.06);
}

.movement-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.movement-header-label {
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--gold-primary);
    line-height: 1;
}

.movement-header-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--cream-soft);
    line-height: 1.2;
}

.movement-header-meta {
    font-size: 0.82rem;
    color: var(--cream);
    opacity: 0.6;
    margin-top: 0.15rem;
}

.movement-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
}

.movement-header-desc {
    font-size: 0.85rem;
    color: var(--cream);
    opacity: 0.65;
    max-width: 340px;
    line-height: 1.5;
    text-align: right;
}

.movement-chevron {
    width: 20px;
    height: 20px;
    color: var(--gold-primary);
    opacity: 0.7;
    flex-shrink: 0;
    transition: transform var(--transition-normal);
}

.movement-section.is-open .movement-chevron {
    transform: rotate(180deg);
}

/* ── MOVEMENT THEMING (per-tier tag colors) ─────────────────────
   Each of the three movement panels carries the color identity of a
   card-chapter commitment-tier tag. The RGB values are taken verbatim
   from src/css/card-chapter.css (.tag-explore / .tag-seeker / .tag-covenant).
   The Conclusion panel (#acc-hinge) is intentionally not themed. */
.movement-section--explore  { --mv-tag-r: 107; --mv-tag-g:  61; --mv-tag-b:  61; }
.movement-section--seeker   { --mv-tag-r:  74; --mv-tag-g: 107; --mv-tag-b: 107; }
.movement-section--covenant { --mv-tag-r: 196; --mv-tag-g: 148; --mv-tag-b:  58; }

/* Single tint knob — increase for a more vivid look */
.movement-section--explore,
.movement-section--seeker,
.movement-section--covenant { --mv-tint: 0.15; }

.movement-section--explore,
.movement-section--seeker,
.movement-section--covenant {
    background:
        linear-gradient(
            rgba(var(--mv-tag-r), var(--mv-tag-g), var(--mv-tag-b), var(--mv-tint)),
            rgba(var(--mv-tag-r), var(--mv-tag-g), var(--mv-tag-b), var(--mv-tint))
        ),
        var(--overlay-medium);
    border-color: rgba(var(--mv-tag-r), var(--mv-tag-g), var(--mv-tag-b), 0.25);
}

.movement-section--explore.is-open,
.movement-section--seeker.is-open,
.movement-section--covenant.is-open {
    border-color: rgba(var(--mv-tag-r), var(--mv-tag-g), var(--mv-tag-b), 0.5);
}

.movement-section--explore  .movement-header,
.movement-section--seeker   .movement-header,
.movement-section--covenant .movement-header {
    border-left-color: rgb(var(--mv-tag-r), var(--mv-tag-g), var(--mv-tag-b));
}

.movement-section--explore  .movement-header-label,
.movement-section--seeker   .movement-header-label,
.movement-section--covenant .movement-header-label {
    color: rgb(var(--mv-tag-r), var(--mv-tag-g), var(--mv-tag-b));
}

.movement-section--explore  .movement-header:hover,
.movement-section--seeker   .movement-header:hover,
.movement-section--covenant .movement-header:hover {
    background: rgba(var(--mv-tag-r), var(--mv-tag-g), var(--mv-tag-b), 0.08);
}

/* ── ACCORDION BODY ────────────────────────── */
.movement-body {
    display: none;
    padding: 0 var(--space-md) var(--space-md);
}

.movement-section.is-open .movement-body {
    display: block;
}

/* ── CHAPTER LIST ──────────────────────────── */
.chapter-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
}

.chapter-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.75rem var(--space-sm);
    background: rgba(26, 21, 16, 0.4);
    border: 1px solid rgba(196, 148, 58, 0.1);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    text-decoration: none;
    color: var(--cream);
}

a.chapter-item:hover {
    border-color: var(--gold-primary);
    background: rgba(45, 32, 22, 0.92);
}

.chapter-item-info {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
}

.chapter-num {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--gold-primary);
    font-size: 0.9rem;
    white-space: nowrap;
}

.chapter-title {
    font-size: 0.95rem;
    color: var(--cream);
}

.badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
}

.badge-available {
    background: rgba(76, 175, 80, 0.15);
    color: #81C784;
    border: 1px solid rgba(76, 175, 80, 0.3);
}

.badge-soon {
    background: rgba(232, 220, 196, 0.08);
    color: var(--cream);
    opacity: 0.5;
    border: 1px solid rgba(232, 220, 196, 0.12);
}

.chapter-item.disabled {
    opacity: 0.55;
    cursor: default;
}

/* ── CHAPTER STATUS ICONS ─────────────────── */
.chapter-status-icons {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    margin-right: 6px;
    flex-shrink: 0;
}

.ch-icon {
    display: none;          /* hidden until flag is set */
    width: 18px;
    height: 18px;
    opacity: 0.9;
}

.ch-icon.visible {
    display: block;
}

.ch-icon-bookmark { color: var(--gold-primary); }
.ch-icon-complete  { color: var(--gold-light); }

.chapter-status-label {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
}
.chapter-status-label.label-bookmark { color: var(--gold-primary); opacity: 0.85; }
.chapter-status-label.label-complete  { color: var(--gold-light);   opacity: 0.85; }

/* ── DESKTOP SPACING — page-specific overrides ── */
/*
  The global .page-header has 4rem bottom padding and .content-section
  has 4rem top/bottom padding — too generous for this two-section layout.
  These overrides apply at all screen sizes above the 768px mobile breakpoint.
*/
.vol1-hero-title {
    padding-top: var(--space-lg);
}
.content-section {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
}

/* ── CTA ───────────────────────────────────── */
.vol1-cta {
    text-align: center;
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(196, 148, 58, 0.2);
    margin-top: var(--space-lg);
}

.vol1-cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-md);
}

@media (max-width: 768px) {
    .movement-header-desc {
        display: none;
    }
    .chapter-item {
        flex-wrap: wrap;
        gap: 0.35rem;
    }
    .vol1-cta-buttons {
        flex-direction: column;
        align-items: center;
    }
    .vol1-cta-buttons .btn {
        width: 100%;
        max-width: 280px;
    }
    /* Tighten all vertical spacing on mobile */
    .page-header {
        padding-bottom: var(--space-xs);
    }
    .vol1-hero-title {
        padding-top: var(--space-sm);
    }
    .content-section {
        padding-top: var(--space-sm);
        padding-bottom: var(--space-sm);
    }
}
</style>

<!-- Custom Hero Title -->
<h1 class="vol1-hero-title">
    <span class="vol1-series">Words of Plainness &mdash; Volume 1</span>
    Christ-Centered Discipleship
</h1>

<!-- Introduction -->
<section class="content-section">
    <div class="content-wrapper">
        <p class="vol1-intro">
            <em>Words of Plainness</em>, Volume 1 is an interfaith journey through Christ-centered
            discipleship. Beginning with the foundations of faith and moving through an intimate
            study of Jesus Christ&rsquo;s life and character, it invites readers of every background
            to explore discipleship practices that transform daily living. Whether you are a lifelong
            believer deepening your walk or a curious seeker taking your first steps, this volume
            meets you where you are.
        </p>
    </div>
</section>

<!-- Chapter Listing — Accordion -->
<section class="content-section alt">
    <div class="content-wrapper" style="max-width: 900px;">

        {% set volume = chapterStatus.volume_1 %}
        {% include "components/volume-accordion.njk" %}

        <!-- CTA -->
        <div class="vol1-cta">
            <h2 style="color: var(--gold-primary);">Begin Your Journey</h2>
            <p style="opacity: 0.85; font-size: 1.05rem; line-height: 1.7;">
                Start with Chapter 1 and discover the foundations of Christ-centered faith,
                or subscribe to be notified as new chapters become available.
            </p>
            <div class="vol1-cta-buttons">
                <a href="/chapters/01-introduction/" class="btn btn-primary">Begin with Chapter 1</a>
                <a href="/connect/#newsletter" class="btn btn-outline-gold">Subscribe for Updates</a>
            </div>
        </div>

    </div>
</section>

<script>
(function () {
    'use strict';

    const STORAGE_KEY = 'wop_vol1_accordion';
    const DEFAULT_OPEN = ['m1'];

    // ── Read / write localStorage ───────────────────────────────
    function loadState() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : null;
        } catch (e) {
            return null;
        }
    }

    function saveState(openIds) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(openIds));
        } catch (e) { /* storage unavailable — silent */ }
    }

    // ── Apply open/closed state to a section ───────────────────
    function applyState(section, isOpen) {
        const btn  = section.querySelector('.movement-header');
        const body = section.querySelector('.movement-body');
        section.classList.toggle('is-open', isOpen);
        btn.setAttribute('aria-expanded', String(isOpen));
    }

    // ── Toggle a single section ─────────────────────────────────
    function toggle(section) {
        const isNowOpen = !section.classList.contains('is-open');
        applyState(section, isNowOpen);

        // Persist new state
        const openIds = Array.from(
            document.querySelectorAll('.movement-section.is-open')
        ).map(s => s.id.replace('acc-', ''));
        saveState(openIds);
    }

    // ── Decorate chapter rows from localStorage flags ────────
    function decorateChapterStatus() {
        try {
            document.querySelectorAll('.chapter-item[data-chapter-id]').forEach(function (row) {
                const id = row.dataset.chapterId;
                const bookmarked = localStorage.getItem('wop-bookmark-flag-' + id) === 'true';
                const completed  = localStorage.getItem('wop-complete-' + id)   === 'true';
                const bmIcon = row.querySelector('.ch-icon-bookmark');
                const cpIcon = row.querySelector('.ch-icon-complete');
                if (bmIcon) bmIcon.classList.toggle('visible', bookmarked);
                if (cpIcon) cpIcon.classList.toggle('visible', completed);
            });
        } catch (e) { /* localStorage unavailable */ }
    }

    // ── Initialise ──────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        const sections = document.querySelectorAll('.movement-section');
        const saved    = loadState();
        const openIds  = saved !== null ? saved : DEFAULT_OPEN;

        sections.forEach(function (section) {
            const id     = section.id.replace('acc-', '');
            const isOpen = openIds.includes(id);
            applyState(section, isOpen);

            section.querySelector('.movement-header').addEventListener('click', function () {
                toggle(section);
            });
        });

        // Decorate chapter rows with bookmark / complete icons
        decorateChapterStatus();

        // Keep in sync if another tab writes to localStorage
        window.addEventListener('storage', function (e) {
            if (e.key && (e.key.startsWith('wop-bookmark-flag-') || e.key.startsWith('wop-complete-'))) {
                decorateChapterStatus();
            }
        });
    });
}());
</script>
