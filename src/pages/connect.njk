<!-- Newsletter -->
<section class="content-section alt" id="newsletter">
    <div class="content-wrapper">
        <h2>Newsletter</h2>

        <p>
            Periodic updates directly to your inbox&mdash;new writings, app launches, VR session
            schedules, and occasional personal reflections from the road. No spam, no selling
            your information, just genuine connection.
        </p>

        <form class="newsletter-form newsletter-form--page" id="connectNewsletterForm" style="margin-top: 1.5rem; max-width: 500px;">
            <div class="form-group">
                <label for="connectNlName">Your Name</label>
                <input type="text" id="connectNlName" name="name" placeholder="How should I address you?">
                <small class="newsletter-field-error hidden" data-nl-error="name"></small>
            </div>

            <div class="form-group">
                <label for="connectNlEmail">Email Address <span class="text-gold">*</span></label>
                <input type="email" id="connectNlEmail" name="email" required placeholder="your@email.com">
                <small class="newsletter-field-error hidden" data-nl-error="email"></small>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">
                Subscribe
            </button>
        </form>
        <div class="newsletter-message hidden" id="connectNlMessage" style="max-width: 500px;"></div>
    </div>
</section>

<!-- Prayer Requests -->
<section class="content-section" id="prayer">
    <div class="content-wrapper">
        <h2>Prayer &amp; Reflection Requests</h2>

        <p>
            If you'd like me to hold you in prayer or simply want someone to know what you're
            carrying, you can share here. These are read personally and held in confidence.
        </p>

        <form class="prayer-form" style="margin-top: 1.5rem; max-width: 600px;">
            <div class="form-group">
                <label for="prayer-name">Your Name (optional)</label>
                <input type="text" id="prayer-name" name="name" placeholder="Or how you'd like to be addressed">
            </div>

            <div class="form-group">
                <label for="prayer-email">Email (optional, if you'd like a response)</label>
                <input type="email" id="prayer-email" name="email" placeholder="your@email.com">
            </div>

            <div class="form-group">
                <label for="prayer-request">Your Request or What's on Your Heart</label>
                <textarea id="prayer-request" name="request" placeholder="Share what you'd like prayer for, or simply what you're carrying..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Submit Request
            </button>
        </form>

        <p style="margin-top: 1.5rem; font-size: 0.9rem; opacity: 0.8;">
            <strong>Note:</strong> While I'm not a counselor or therapist, I do care. If you're in crisis,
            please reach out to appropriate professional resources. If you're simply seeking a fellow
            traveler to walk with you in prayer, I'm honored to do so.
        </p>
    </div>
</section>

<!-- Contact -->
<section class="content-section alt" id="contact">
    <div class="content-wrapper">
        <h2>Contact Brother Aaron</h2>

        <p>
            Questions about the ministry? Feedback on the writings? Want to arrange a visit
            during our RV travels? I'd love to hear from you.
        </p>

        <div id="contactFormWrapper" style="margin-top: 1.5rem; max-width: 600px;">
            <form class="contact-form" id="contactForm">
                <div class="form-group">
                    <label for="contact-name">Name <span class="text-gold">*</span></label>
                    <input type="text" id="contact-name" name="name" required placeholder="Your name">
                    <small class="form-field-error hidden" data-contact-error="name"></small>
                </div>

                <div class="form-group">
                    <label for="contact-email">Email Address <span class="text-gold">*</span></label>
                    <input type="email" id="contact-email" name="email" required placeholder="your@email.com">
                    <small class="form-field-error hidden" data-contact-error="email"></small>
                </div>

                <div class="form-group">
                    <label for="contact-type">Type <span class="text-gold">*</span></label>
                    <select id="contact-type" name="submission_type" required>
                        <option value="">Select a topic...</option>
                        <option value="general">General Inquiry</option>
                        <option value="suggestion">Content Suggestion</option>
                        <option value="technical">Technical Issue</option>
                        <option value="prayer">Prayer Request</option>
                        <option value="other">Other</option>
                    </select>
                    <small class="form-field-error hidden" data-contact-error="submission_type"></small>
                </div>

                <div class="form-group">
                    <label for="contact-subject">Subject <span class="text-gold">*</span></label>
                    <input type="text" id="contact-subject" name="subject" required placeholder="What is this about?">
                    <small class="form-field-error hidden" data-contact-error="subject"></small>
                </div>

                <div class="form-group">
                    <label for="contact-message">Message <span class="text-gold">*</span></label>
                    <textarea id="contact-message" name="message" required placeholder="What would you like to share or ask?"></textarea>
                    <small class="form-field-error hidden" data-contact-error="message"></small>
                </div>

                <div class="contact-form-error hidden" id="contactFormError"></div>

                <button type="submit" class="btn btn-primary" id="contactSubmit">
                    Send Message
                </button>
            </form>

            <div class="contact-success hidden" id="contactSuccess">
                <h3 style="color: var(--gold-primary); margin-bottom: var(--space-sm);">Message Sent!</h3>
                <p>Thank you for reaching out! We'll respond as soon as possible.</p>
                <a href="#" id="contactSendAnother" style="color: var(--gold-primary); margin-top: var(--space-md); display: inline-block;">Send Another Message</a>
            </div>
        </div>
    </div>
</section>

