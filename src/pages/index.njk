        <h1 class="hero-title">WORDS OF PLAINNESS</h1>
        <p class="hero-subtitle">A Christ-Centered Ministry</p>

        <!-- Anthem Divider -->
        <div class="anthem-rule"></div>

        <!-- Anthem Player -->
        <div class="anthem-block">
