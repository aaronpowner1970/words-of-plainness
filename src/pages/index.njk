            <h2 class="anthem-title">The Marks of Your Worth</h2>
            <p class="anthem-subtitle">A Come Thou Fount Adaptation · Sacred Americana</p>

            <div class="anthem-play-area" id="anthemPlayArea">
                <button class="anthem-play-btn" id="anthemPlayBtn" aria-label="Play anthem">
                    <svg class="icon-play" viewBox="0 0 24 24"><polygon points="6,3 20,12 6,21"/></svg>
                    <svg class="icon-pause" viewBox="0 0 24 24"><rect x="5" y="3" width="4" height="18"/><rect x="15" y="3" width="4" height="18"/></svg>
                </button>

                <div class="anthem-waveform">
                    <div class="anthem-waveform-bars">
                        <span></span><span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span><span></span>
