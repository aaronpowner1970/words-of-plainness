---
layout: layouts/base.njk
title: Music
description: "Sacred Americana Testimonies — original songs by Aaron Powner, inspired by the themes of each Words of Plainness chapter."
permalink: /music/
---

{% block styles %}
<link rel="stylesheet" href="/css/music.css">
<link rel="stylesheet" href="/css/wop-player.css?v={{ site.version }}">
{% endblock %}

<!-- Music Layout — sticky mini-player + anchored lyrics drawer render from
     /js/wop-player.js (shared with /articles/ and chapter pages). -->
<div class="music-layout">

{#- Row actions: Listen (always) + Watch (only when a youtubeId exists). The Watch
    slot is always emitted so the two columns stay aligned down the table. -#}
{%- macro rowActions(title, style, youtubeId) -%}
{%- set full = title + (' (' + style + ')' if style else '') -%}
<td class="col-actions">
    <div class="row-actions">
        <span class="row-action-slot">
            <button type="button" class="row-action-btn" data-action="listen"
                    aria-label="Listen to {{ full }}">
                <svg class="row-action-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>
                <span class="row-action-label">Listen</span>
            </button>
        </span>
        <span class="row-action-slot{% if not youtubeId %} row-action-slot--empty{% endif %}">
            {%- if youtubeId %}
            <button type="button" class="row-action-btn" data-action="watch"
                    data-youtube-id="{{ youtubeId }}" data-video-title="{{ full }}"
                    aria-label="Watch the video of {{ full }}"
                    aria-haspopup="dialog">
                <svg class="row-action-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15.033 9.44a.647.647 0 0 1 0 1.12l-4.065 2.352a.645.645 0 0 1-.968-.56V7.648a.645.645 0 0 1 .968-.56z"/><path d="M12 17v4"/><path d="M8 21h8"/><rect x="2" y="3" width="20" height="14" rx="2"/></svg>
                <span class="row-action-label">Watch</span>
            </button>
            {%- endif %}
        </span>
    </div>
</td>
{%- endmacro -%}

<!-- ==========================================
     Page Content
     ========================================== -->
<div class="music-page">
    <div class="music-header">
        <h1 class="music-title">Complete Collection of Musical Testimonies</h1>
    </div>

    <!-- Concert Hall Card -->
    <a href="/concert/" class="concert-hall-card">
        <div class="chc-thumbnail">
            <img src="https://media.wordsofplainness.org/images/concert_hall_thumbnail.png"
                 alt="Concert Hall — sacred narrative suites for narrator and orchestra"
                 loading="lazy">
        </div>
        <div class="chc-body">
            <span class="chc-label">Concert Hall</span>
            <span class="chc-title">Symphonic Productions with Spoken Word</span>
            <span class="chc-subtitle">Sacred narrative suites for narrator and orchestra</span>
        </div>
        <span class="chc-arrow" aria-hidden="true">&rarr;</span>
    </a>

    <!-- ==========================================
         Track List
         ========================================== -->
    <div class="playlist-container">

        <!-- Options row: label, Continuous play (aria-pressed), then the collection-scope
             segmented toggle (radiogroup). Scope governs which rows are in the auto-advance,
             shuffle, and repeat queue; individual rows stay clickable in both modes.
             Scope is persisted in localStorage as 'wop-music-queue-scope' ('core' | 'full');
             continuous play as 'wop-music-continuous' = 'off' when switched off. -->
        <div class="options-row" role="group" aria-labelledby="optionsLabel">
            <span class="options-label" id="optionsLabel">Options:</span>
            <div class="queue-scope" id="continuousScope">
                <button type="button" class="queue-scope-btn" id="continuousToggle"
                        aria-pressed="true">Continuous play: On</button>
            </div>
            <div class="queue-scope" id="queueScope" role="radiogroup" aria-label="Collection">
                <button type="button" class="queue-scope-btn" data-scope="core"
                        role="radio" aria-checked="true">Core Collection</button>
                <button type="button" class="queue-scope-btn" data-scope="full"
                        role="radio" aria-checked="false">Full Collection</button>
            </div>
        </div>

        <!-- Section 0: Ministry Collection -->
        <div class="playlist-section-header">
            <h2 class="section-title">Ministry Anthems</h2>
            <p class="section-subtitle">Sacred music at the heart of this ministry</p>
        </div>

        <table class="playlist-table" id="playlistTable">
            <thead>
                <tr>
                    <th class="col-num">#</th>
                    <th class="col-title">Title</th>
                    <th class="col-chapter">Chapter</th>
                    <th class="col-actions"><span class="visually-hidden">Listen or watch</span></th>
                    <th class="col-duration">Duration</th>
                </tr>
            </thead>
            <tbody>
                {%- set trackNum = 1 -%}
                {%- for item in ministryMusic.collection -%}
                <tr class="playlist-row"
                    data-play-file="{{ item.file }}">
                    <td class="col-num">{{ trackNum }}</td>
                    <td class="col-title">
                        <div class="track-title-group">
                            <span class="song-title">{{ item.title }}</span>
                            <span class="song-label">&mdash; {{ item.label }}</span>
                        </div>
                    </td>
                    <td class="col-chapter"></td>
                    {{ rowActions(item.title, item.label, item.youtubeId) }}
                    <td class="col-duration" data-duration>{{ item.duration if item.duration else '&mdash;' | safe }}</td>
                </tr>
                {%- set trackNum = trackNum + 1 -%}
                {%- endfor -%}

                <!-- Section 1: The Core Journey (Primaries) -->
                <tr class="playlist-section-divider">
                    <td colspan="5">
                        <div class="playlist-section-header playlist-section-header--inline">
                            <h2 class="section-title">Core Discipleship Journey</h2>
                            <p class="section-subtitle">The core musical testimony, chapter by chapter</p>
                        </div>
                    </td>
                </tr>

                {%- for chapter in collections.chapters -%}
                {%- if chapter.data.audio and chapter.data.audio.testimony and chapter.data.audio.testimony.file -%}
                <tr class="playlist-row"
                    data-play-file="{{ chapter.data.audio.testimony.file }}">
                    <td class="col-num">{{ trackNum }}</td>
                    <td class="col-title">
                        <div class="track-title-group">
                            <span class="song-title">{{ chapter.data.audio.testimony.title }}</span>
                            {% if chapter.data.audio.testimony.label %}<span class="song-label">&mdash; {{ chapter.data.audio.testimony.label }}</span>{% endif %}
                            <span class="track-chapter-mobile">Ch. {{ chapter.data.chapter }}</span>
                        </div>
                    </td>
                    <td class="col-chapter">
                        <a href="{{ chapter.url }}" class="chapter-link">Ch. {{ chapter.data.chapter }}</a>
                    </td>
                    {{ rowActions(chapter.data.audio.testimony.title, chapter.data.audio.testimony.label, chapter.data.audio.testimony.youtubeId) }}
                    <td class="col-duration" data-duration>{{ chapter.data.audio.testimony.duration if chapter.data.audio.testimony.duration else '&mdash;' | safe }}</td>
                </tr>
                {%- set trackNum = trackNum + 1 -%}
                {%- endif -%}
                {%- endfor -%}

                <!-- Section 2: More Arrangements (Alternates) -->
                <tr class="playlist-section-divider" id="altSectionDivider">
                    <td colspan="5">
                        <div class="playlist-section-header playlist-section-header--inline">
                            <h2 class="section-title">Alternate Arrangements</h2>
                            <p class="section-subtitle">The same truths in different musical languages</p>
                        </div>
                    </td>
                </tr>

                {#- Ministry anthem alternates -#}
                {%- for item in ministryMusic.collection -%}
                {%- if item.alternates and item.alternates.length > 0 -%}
                {%- for alt in item.alternates -%}
                <tr class="playlist-row playlist-row--alt"
                    data-play-file="{{ alt.file }}">
                    <td class="col-num">{{ trackNum }}</td>
                    <td class="col-title">
                        <div class="track-title-group">
                            <span class="song-title">{{ item.title }}</span>
                            <span class="song-label">&mdash; {{ alt.label }}</span>
                        </div>
                    </td>
                    <td class="col-chapter"></td>
                    {{ rowActions(item.title, alt.label, alt.youtubeId) }}
                    <td class="col-duration" data-duration>{{ alt.duration if alt.duration else '&mdash;' | safe }}</td>
                </tr>
                {%- set trackNum = trackNum + 1 -%}
                {%- endfor -%}
                {%- endif -%}
                {%- endfor -%}

                {%- for chapter in collections.chapters -%}
                {%- if chapter.data.audio and chapter.data.audio.testimony and chapter.data.audio.testimony.alternates and chapter.data.audio.testimony.alternates.length > 0 -%}
                {%- for alt in chapter.data.audio.testimony.alternates -%}
                <tr class="playlist-row playlist-row--alt"
                    data-play-file="{{ alt.file }}">
                    <td class="col-num">{{ trackNum }}</td>
                    <td class="col-title">
                        <div class="track-title-group">
                            <span class="song-title">{{ chapter.data.audio.testimony.title }}</span>
                            <span class="song-label">&mdash; {{ alt.label }}</span>
                            <span class="track-chapter-mobile">Ch. {{ chapter.data.chapter }}</span>
                        </div>
                    </td>
                    <td class="col-chapter">
                        <a href="{{ chapter.url }}" class="chapter-link">Ch. {{ chapter.data.chapter }}</a>
                    </td>
                    {{ rowActions(chapter.data.audio.testimony.title, alt.label, alt.youtubeId) }}
                    <td class="col-duration" data-duration>{{ alt.duration if alt.duration else '&mdash;' | safe }}</td>
                </tr>
                {%- set trackNum = trackNum + 1 -%}
                {%- endfor -%}
                {%- endif -%}
                {%- endfor -%}
            </tbody>
        </table>
    </div>

    <div class="music-footer">
        <p>Each chapter of <a href="/writings/">Words of Plainness</a> includes a musical testimony — an original song inspired by the themes explored in that chapter.</p>
        <p>All music written and produced by Aaron Powner.</p>
    </div>
</div>

</div><!-- /.music-layout -->

<!-- Video modal: the iframe is created on open and removed on close. -->
<div class="video-modal" id="videoModal" hidden>
    <div class="video-modal-backdrop" data-close></div>
    <div class="video-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="videoModalTitle">
        <div class="video-modal-head">
            <h2 class="video-modal-title" id="videoModalTitle"></h2>
            <button type="button" class="video-modal-close" id="videoModalClose" aria-label="Close video">&times;</button>
        </div>
        <div class="video-modal-frame" id="videoModalFrame"></div>
        <div class="video-modal-foot">
            <a id="videoModalYt" href="#" target="_blank" rel="noopener">Open on YouTube</a>
        </div>
    </div>
</div>

{% block scripts %}
<script>window.WOP_MUSIC_CATALOG = {{ collections.chapters | musicCatalog | safe }};</script>
<script src="/js/wop-player.js?v={{ site.version }}" defer></script>
<script>
// /music/ playlist controller — thin wrapper over WopPlayer's opt-in
// playlist mode. Row clicks call WopPlayer.play(file); the transport
// (shuffle/prev/next/repeat) lives inside the player itself and only
// renders because we call setQueue() below.
(function () {
    var SCOPE_KEY = 'wop-music-queue-scope';

    function loadScope() {
        try { return localStorage.getItem(SCOPE_KEY) === 'full' ? 'full' : 'core'; }
        catch (_) { return 'core'; }
    }

    function saveScope(v) {
        try { localStorage.setItem(SCOPE_KEY, v); } catch (_) {}
    }

    function collectQueue(scope) {
        var sel = scope === 'full'
            ? '.playlist-row[data-play-file]'
            : '.playlist-row:not(.playlist-row--alt)[data-play-file]';
        return Array.prototype.map.call(
            document.querySelectorAll(sel),
            function (row) { return row.getAttribute('data-play-file'); }
        );
    }

    function applyScope(scope) {
        // Rebuild the queue + reshuffle. Does NOT interrupt the current
        // track (WopPlayer.setQueue only updates queue/queueIndex/shuffleOrder;
        // audio playback isn't touched). If the currently-playing track was
        // removed from the new queue (queueIndex = -1), the auto-advance
        // fallback in getNextAutoAdvance drops the reader into the new set
        // when this song ends.
        if (window.WopPlayer) window.WopPlayer.setQueue(collectQueue(scope));

        document.querySelectorAll('#queueScope .queue-scope-btn').forEach(function (b) {
            var on = b.dataset.scope === scope;
            b.setAttribute('aria-checked', on ? 'true' : 'false');
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Row clicks always play the clicked file — even if it isn't in the
        // current scope's queue (spec: alternates stay clickable in Core mode).
        document.querySelectorAll('.playlist-row[data-play-file]').forEach(function (row) {
            row.addEventListener('click', function (e) {
                if (e.target.closest('a')) return;   // let chapter-link anchors navigate
                if (e.target.closest('[data-action="watch"]')) return;   // Watch opens the video modal, not the player
                var file = row.getAttribute('data-play-file');
                if (file && window.WopPlayer) window.WopPlayer.play(file);
            });
        });

        // ---- Video modal ----
        var modal = document.getElementById('videoModal');
        var frameBox = document.getElementById('videoModalFrame');
        var modalTitle = document.getElementById('videoModalTitle');
        var ytLink = document.getElementById('videoModalYt');
        var closeBtn = document.getElementById('videoModalClose');
        var opener = null;

        function focusables() {
            return Array.prototype.slice.call(modal.querySelectorAll('button, a[href], iframe'));
        }

        function openVideo(btn) {
            var id = btn.getAttribute('data-youtube-id');
            if (!id || !/^[\w-]{11}$/.test(id)) return;
            opener = btn;
            // Pause the built-in player; its queue and position are left alone.
            try { if (window.WopPlayer && window.WopPlayer.audio) window.WopPlayer.audio.pause(); } catch (_) {}
            var title = btn.getAttribute('data-video-title') || '';
            modalTitle.textContent = title;
            var ifr = document.createElement('iframe');
            ifr.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
            ifr.title = 'Video: ' + title;
            ifr.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen';
            ifr.setAttribute('allowfullscreen', '');
            ifr.referrerPolicy = 'strict-origin-when-cross-origin';
            frameBox.appendChild(ifr);
            ytLink.href = 'https://youtu.be/' + id;
            ytLink.setAttribute('aria-label', 'Open ' + title + ' on YouTube (new tab)');
            var sbw = window.innerWidth - document.documentElement.clientWidth;
            document.body.style.overflow = 'hidden';
            if (sbw > 0) document.body.style.paddingRight = sbw + 'px';
            modal.hidden = false;
            closeBtn.focus();
            document.addEventListener('keydown', onKey, true);
            document.addEventListener('focusin', onFocusIn, true);
        }

        function closeVideo() {
            if (modal.hidden) return;
            document.removeEventListener('keydown', onKey, true);
            document.removeEventListener('focusin', onFocusIn, true);
            frameBox.textContent = '';   // removing the iframe stops playback
            modal.hidden = true;
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            if (opener) { try { opener.focus(); } catch (_) {} }
            opener = null;
        }

        function onKey(e) {
            if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); closeVideo(); return; }
            if (e.key !== 'Tab') return;
            var f = focusables();
            if (!f.length) return;
            var first = f[0], last = f[f.length - 1];
            if (!modal.contains(document.activeElement)) { e.preventDefault(); first.focus(); }
            else if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }

        function onFocusIn(e) {
            if (!modal.hidden && !modal.contains(e.target)) closeBtn.focus();
        }

        document.querySelectorAll('.row-action-btn[data-action="watch"]').forEach(function (btn) {
            btn.addEventListener('click', function (e) { e.stopPropagation(); openVideo(btn); });
        });
        modal.addEventListener('click', function (e) { if (e.target.hasAttribute('data-close')) closeVideo(); });
        closeBtn.addEventListener('click', closeVideo);

        // Continuous play switch (default on; only 'off' is stored).
        var contBtn = document.getElementById('continuousToggle');
        function setCont(on) {
            if (window.WopPlayer) window.WopPlayer.setContinuous(on);
            if (contBtn) {
                contBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
                contBtn.textContent = 'Continuous play: ' + (on ? 'On' : 'Off');
            }
        }
        var contOn = true;
        try { contOn = localStorage.getItem('wop-music-continuous') !== 'off'; } catch (_) {}
        setCont(contOn);
        if (contBtn) contBtn.addEventListener('click', function () {
            contOn = !contOn;
            try { localStorage.setItem('wop-music-continuous', contOn ? 'on' : 'off'); } catch (_) {}
            setCont(contOn);
        });

        // Scope toggle: buttons, persistence, initial state.
        var currentScope = loadScope();
        applyScope(currentScope);
        document.querySelectorAll('#queueScope .queue-scope-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var s = btn.dataset.scope;
                if (s === currentScope) return;
                currentScope = s;
                saveScope(s);
                applyScope(s);
            });
        });
    });
})();
</script>
{% endblock %}
