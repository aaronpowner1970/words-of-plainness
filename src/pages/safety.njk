<script>
/**
 * Safety Report Form Handler
 * Posts to the existing Django contact endpoint with submission_type "safety_report".
 * The category and phone fields are embedded into the subject/message for Aaron's review.
 */
(function() {
    const form = document.getElementById('safetyForm');
    const submitBtn = document.getElementById('safetySubmit');
    if (!form) return;

    // Set honeypot timestamp
    const loadedAt = form.querySelector('[name="loaded_at"]');
    if (loadedAt) loadedAt.value = Date.now().toString();

    // Pre-fill from auth if available
    if (window.API && window.API.isAuthenticated && window.API.isAuthenticated() && window.API.user) {
        const emailInput = document.getElementById('safety-email');
        const nameInput = document.getElementById('safety-name');
        if (emailInput && !emailInput.value && window.API.user.email) emailInput.value = window.API.user.email;
        if (nameInput && !nameInput.value && window.API.user.name) nameInput.value = window.API.user.name;
    }

    // Clear field errors on input
    form.querySelectorAll('input, textarea, select').forEach(function(el) {
        el.addEventListener('input', function() {
            var errEl = document.querySelector('[data-safety-error="' + el.name + '"]');
            if (errEl) { errEl.textContent = ''; errEl.classList.add('hidden'); }
        });
    });

    // Send another
    document.getElementById('safetySendAnother').addEventListener('click', function(e) {
        e.preventDefault();
        form.reset();
        clearErrors();
        document.getElementById('safetySuccess').classList.add('hidden');
        form.classList.remove('hidden');
        if (loadedAt) loadedAt.value = Date.now().toString();
    });

    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        clearErrors();

        // Honeypot check
        var hp = form.querySelector('[name="website"]');
        if (hp && hp.value) return; // bot filled honeypot

        var ts = loadedAt ? parseInt(loadedAt.value, 10) : 0;
        if (ts && (Date.now() - ts) < 3000) return; // submitted too fast

        // Validate
        var category = document.getElementById('safety-category').value;
        var description = document.getElementById('safety-description').value.trim();
        var email = document.getElementById('safety-email').value.trim();
        var valid = true;

        if (!category) {
            showFieldError('category', 'Please select a category.');
            valid = false;
        }
        if (!description || description.length < 10) {
            showFieldError('description', 'Please share what is happening (at least 10 characters).');
            valid = false;
        }
        if (!email || !email.includes('@')) {
            showFieldError('email', 'Please enter a valid email address.');
            valid = false;
        }
        if (!valid) return;

        // Build the data for the contact endpoint
        var categoryLabels = {
            'own_safety': "I'm worried about my own safety",
            'someone_else': "I'm worried about someone else's safety",
            'report_content': "I want to report content that concerns me",
            'other': "Something else"
        };
        var categoryLabel = categoryLabels[category] || category;
        var name = document.getElementById('safety-name').value.trim() || 'Anonymous';
        var phone = document.getElementById('safety-phone').value.trim();

        var subject = '⚠️ Safety Report: ' + categoryLabel;
        var message = 'SAFETY REPORT\n'
            + '━━━━━━━━━━━━━\n'
            + 'Category: ' + categoryLabel + '\n'
            + (phone ? 'Phone: ' + phone + '\n' : '')
            + '━━━━━━━━━━━━━\n\n'
            + description;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        try {
            if (window.API && window.API.submitContact) {
                await window.API.submitContact({
                    name: name,
                    email: email,
                    submission_type: 'safety_report',
                    subject: subject,
                    message: message
                });
            } else {
                // Fallback: direct POST if API not available
                var resp = await fetch('/api/v1/contact/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: name,
                        email: email,
                        submission_type: 'safety_report',
                        subject: subject,
                        message: message
                    })
                });
                if (!resp.ok) throw new Error('Server error');
            }

            form.classList.add('hidden');
            document.getElementById('safetySuccess').classList.remove('hidden');

        } catch (err) {
            showFormError(
                'Unable to send your report right now. Please try again, or contact Brother Aaron directly at the Contact page.'
            );
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Report';
        }
    });

    function showFieldError(field, msg) {
        var el = document.querySelector('[data-safety-error="' + field + '"]');
        if (el) { el.textContent = msg; el.classList.remove('hidden'); }
    }
    function showFormError(msg) {
        var el = document.getElementById('safetyFormError');
        if (el) { el.textContent = msg; el.classList.remove('hidden'); }
    }
    function clearErrors() {
        document.querySelectorAll('[data-safety-error]').forEach(function(el) {
            el.textContent = ''; el.classList.add('hidden');
        });
        var fe = document.getElementById('safetyFormError');
        if (fe) { fe.textContent = ''; fe.classList.add('hidden'); }
    }
})();
</script>
