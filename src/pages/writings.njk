<style>
.page-header {
    display: none;
}

.volume-hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
}

.volume-hub-card {
    display: block;
    background: var(--overlay-medium);
    border: 1px solid rgba(196, 148, 58, 0.15);
    border-left: 4px solid var(--gold-primary);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: all var(--transition-normal);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
}

.volume-hub-card:hover {
    border-color: var(--gold-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold);
}

.volume-hub-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 0.25rem;
}

.volume-hub-card h3 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--cream-soft);
    margin-bottom: var(--space-xs);
}

.volume-hub-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--cream);
    opacity: 0.85;
    margin-bottom: var(--space-md);
}

.volume-hub-meta {
    font-size: 0.85rem;
    color: var(--cream);
    opacity: 0.6;
    margin-bottom: var(--space-sm);
}

.writings-hero {
    text-align: center;
    padding: calc(80px + var(--space-xxl)) var(--space-xl) var(--space-xl);
    background:
        linear-gradient(to bottom, var(--overlay-lighter) 0%, var(--overlay-light) 100%),
        url('/assets/images/library-empty.png') center center / cover no-repeat;
    position: relative;
}

.writings-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse at top, rgba(196,148,58,0.08) 0%, transparent 60%);
    pointer-events: none;
}

.writings-hero-title {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--cream-soft);
    line-height: 1.15;
    margin: 0 auto var(--space-sm);
    position: relative;
}

.writings-hero-title .title-main {
    display: block;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-primary);
}

.writings-hero-title .title-sub {
    display: block;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--cream);
    margin-top: 0.2em;
    font-style: italic;
}

.writings-hero-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--gold-primary);
    opacity: 0.8;
    letter-spacing: 0.06em;
    position: relative;
}
</style>

<!-- Custom hero — bypasses pageTitle/pageSubtitle to allow two-line title layout -->
<div class="writings-hero">
    <h1 class="writings-hero-title">
        <span class="title-main">Words of Plainness</span>
        <span class="title-sub">A Latter-day Witness of Jesus Christ</span>
    </h1>
    <p class="writings-hero-tagline">Where Seekers and Saints Find Common Ground</p>
</div>

<!-- Words of Plainness Volumes -->
<section class="content-section alt" id="volumes">
    <div class="content-wrapper" style="max-width: 900px;">
        <div class="volume-hub-grid">
            <a href="/volume-1/" class="volume-hub-card">
                <div class="volume-hub-label">Volume 1</div>
                <h3>Christ-Centered Discipleship</h3>
                <p>
                    Volume 1 is a journey for all who consider Jesus Christ. Beginning with the
                    foundations of faith, moving through the life and character of Jesus, and
                    arriving at discipleship practices that shape anyone who follows Him&mdash;a
                    path any seeker can walk. No prior beliefs required. No proselytizing. Just
                    a willing heart.
                </p>
                <div class="volume-hub-meta">37 chapters &bull; 6 available now</div>
                <span class="btn btn-primary">Explore Volume 1</span>
            </a>

            <a href="/volume-2/" class="volume-hub-card">
                <div class="volume-hub-label">Volume 2</div>
                <h3>Covenants &amp; Theology</h3>
                <p>
                    Volume 1 invited you to meet Christ with us first. Now, if the Spirit moves
                    you, come see the fullness of what we believe about His Church. A deep study
                    of Latter-day Saint covenants and theology&mdash;from the nature of God and
                    the spiritual creation to the Plan of Salvation and our eternal inheritance.
                    For the seeker who is ready to go further.
                </p>
                <div class="volume-hub-meta">29 chapters &bull; Coming soon</div>
                <span class="btn btn-outline-gold">Explore Volume 2</span>
            </a>
        </div>

    </div>
</section>

