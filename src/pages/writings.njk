<script>
// ─────────────────────────────────────────────────────────
// Appendix Filter & Sort
// Default sort: Volume → Chapter → Title (with dividers).
// Other modes flatten the list; dividers are hidden via CSS.
// ─────────────────────────────────────────────────────────
(function () {
    'use strict';

    const list = document.getElementById('appendix-list');
    if (!list) return;

    const buttons = document.querySelectorAll('.appendix-filter-btn');
    const entries = Array.from(list.querySelectorAll('.appendix-entry'));
    const dividers = Array.from(list.querySelectorAll('.appendix-divider'));

    // Preserve the original DOM order so we can restore "default" cleanly
    // (the source order in the .njk file IS the default-sort canonical order).
    const defaultOrder = Array.from(list.children);

    function applySort(mode) {
        // Set data attribute so CSS can hide dividers in non-default modes
        list.setAttribute('data-sort-mode', mode);

        // Remove all current children
        while (list.firstChild) list.removeChild(list.firstChild);

        if (mode === 'default') {
            // Restore the source order (volume dividers in place)
            defaultOrder.forEach(node => list.appendChild(node));
            return;
        }

        // For non-default modes, sort entries and append (no dividers in DOM,
        // but they remain hidden by CSS — easier than re-inserting/removing).
        // Re-add hidden dividers first (so they're in the DOM but invisible)
        dividers.forEach(d => list.appendChild(d));

        const sorted = entries.slice();

        if (mode === 'chapter') {
            sorted.sort((a, b) => {
                // Cross-Volume Companions (Articles-companion essays) are
                // pinned to the top regardless of chapter sort — they sit
                // at a higher level of ministry standard than chapter-bound
                // studies. Detected by the chapter-999 sentinel.
                const aIsCompanion = parseInt(a.getAttribute('data-accompanies-chapter'), 10) === 999 ? 1 : 0;
                const bIsCompanion = parseInt(b.getAttribute('data-accompanies-chapter'), 10) === 999 ? 1 : 0;
                if (aIsCompanion !== bIsCompanion) return bIsCompanion - aIsCompanion;

                // Within companions, sort alphabetically by title.
                // Within chapter-bound entries, sort by chapter number.
                if (aIsCompanion === 1) {
                    return a.getAttribute('data-sort-title')
                            .localeCompare(b.getAttribute('data-sort-title'));
                }
                const ca = parseInt(a.getAttribute('data-accompanies-chapter'), 10);
                const cb = parseInt(b.getAttribute('data-accompanies-chapter'), 10);
                if (ca !== cb) return ca - cb;
                // Same-chapter tie-breaker: alphabetical
                return a.getAttribute('data-sort-title')
                        .localeCompare(b.getAttribute('data-sort-title'));
            });
        } else if (mode === 'title') {
            sorted.sort((a, b) => {
                return a.getAttribute('data-sort-title')
                        .localeCompare(b.getAttribute('data-sort-title'));
            });
        }

        sorted.forEach(node => list.appendChild(node));
    }

    buttons.forEach(btn => {
        btn.addEventListener('click', function () {
            const mode = this.getAttribute('data-sort');
            buttons.forEach(b => b.classList.toggle('is-active', b === this));
            applySort(mode);
        });
    });

    // Initialize: source order is already default, but set the attribute
    // so future toggles work consistently.
    list.setAttribute('data-sort-mode', 'default');
})();
</script>

