{# Articles Presentation — slide-01 poster opens an 18-slide WebP carousel.
   Slides on R2: media.wordsofplainness.org/web/aoid-slides/slide-NN.webp
   Trigger: #pwPresentation (placed in the Learning Pathways band on /articles/). #}
<style>
.ps-poster{display:block;width:100%;margin:1.75rem 0 .5rem;padding:0;border:1px solid rgba(212,175,105,.4);border-radius:14px;overflow:hidden;background:#2a1618;cursor:pointer;position:relative;line-height:0;transition:transform .2s,box-shadow .2s,border-color .2s;}
.ps-poster:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(0,0,0,.45);border-color:rgba(212,175,105,.7);}
.ps-poster:focus-visible{outline:3px solid #d4af69;outline-offset:3px;}
.ps-poster-img{width:100%;height:auto;display:block;}
.ps-poster-badge{position:absolute;left:14px;bottom:14px;display:inline-flex;align-items:center;gap:7px;padding:7px 13px;background:rgba(20,10,12,.72);border:1px solid rgba(212,175,105,.5);border-radius:999px;color:#f3e9e0;font-family:'Crimson Pro',Georgia,serif;font-size:.9rem;transition:background .2s;}
.ps-poster:hover .ps-poster-badge{background:rgba(20,10,12,.9);}
.ps-backdrop{position:fixed;inset:0;background:rgba(12,6,8,.86);opacity:0;visibility:hidden;transition:opacity .25s;z-index:1200;}
.ps-backdrop.open{opacity:1;visibility:visible;}
.ps-modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-48%);width:min(1100px,96vw);max-height:94vh;display:flex;flex-direction:column;background:#1c1012;border:1px solid rgba(212,175,105,.35);border-radius:14px;box-shadow:0 24px 60px rgba(0,0,0,.6);opacity:0;visibility:hidden;transition:opacity .25s,transform .25s;z-index:1201;overflow:hidden;}
.ps-modal.open{opacity:1;visibility:visible;transform:translate(-50%,-50%);}
.ps-bar{display:flex;align-items:center;justify-content:space-between;padding:11px 15px;border-bottom:1px solid rgba(212,175,105,.22);}
.ps-eyebrow{font-family:'Cinzel',serif;font-size:.95rem;letter-spacing:.04em;color:#d4af69;}
.ps-bar-actions{display:flex;gap:4px;}
.ps-bar button{background:none;border:none;color:#d9c4b0;cursor:pointer;padding:6px;border-radius:6px;line-height:0;}
.ps-bar button:hover{color:#fff;background:rgba(212,175,105,.14);}
.ps-stage{position:relative;background:#000;flex:1 1 auto;display:flex;align-items:center;justify-content:center;aspect-ratio:16/9;min-height:0;}
.ps-stage img{width:100%;height:100%;object-fit:contain;display:block;}
.ps-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:46px;height:46px;border-radius:50%;background:rgba(20,10,12,.6);border:1px solid rgba(212,175,105,.4);color:#f3e9e0;font-size:24px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s;}
.ps-nav:hover{background:rgba(20,10,12,.9);}
.ps-nav:disabled{opacity:.3;cursor:default;}
.ps-prev{left:14px;} .ps-next{right:14px;}
.ps-footer{position:relative;display:flex;align-items:center;justify-content:center;padding:9px;border-top:1px solid rgba(212,175,105,.22);color:#c8b3a3;font-size:.85rem;font-variant-numeric:tabular-nums;}
.ps-jump{position:absolute;right:12px;top:50%;transform:translateY(-50%);display:inline-flex;align-items:center;gap:5px;padding:5px 11px;background:rgba(212,175,105,.12);border:1px solid rgba(212,175,105,.4);border-radius:999px;color:#e8d3a8;font-size:.8rem;text-decoration:none;cursor:pointer;opacity:.72;transition:opacity .15s,background .15s,color .15s;}
.ps-jump:hover,.ps-jump:focus-visible{opacity:1;background:rgba(212,175,105,.22);color:#fff;}
.ps-jump[hidden]{display:none;}
@media(max-width:640px){.ps-jump{font-size:.72rem;padding:4px 9px;right:8px;}}
/* Deep-zoom layer — only present on slides listed in ZOOMABLE (see script). */
.ps-zoom-btn[hidden]{display:none;}
.ps-zoom-btn[aria-pressed="true"]{color:#d4af69;background:rgba(212,175,105,.16);}
.ps-zoom-badge{position:absolute;left:14px;bottom:14px;z-index:3;display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:rgba(20,10,12,.74);border:1px solid rgba(212,175,105,.5);border-radius:999px;color:#f3e9e0;font-family:'Crimson Pro',Georgia,serif;font-size:.82rem;cursor:pointer;transition:background .2s,border-color .2s;}
.ps-zoom-badge:hover,.ps-zoom-badge:focus-visible{background:rgba(20,10,12,.94);border-color:rgba(212,175,105,.85);color:#fff;}
.ps-zoom-badge[hidden]{display:none;}
.ps-osd{position:absolute;inset:0;z-index:2;background:#000;touch-action:none;}
.ps-osd[hidden]{display:none;}
/* OpenSeadragon writes position:relative inline onto whatever element it mounts
   into, which would override .ps-osd's absolute fill and collapse it to 0×0.
   It mounts into this inner div instead, sized by percentage so relative is harmless. */
.ps-osd-mount{width:100%;height:100%;}
.ps-osd-wait{position:absolute;inset:0;z-index:1;display:flex;align-items:center;justify-content:center;padding:0 2rem;text-align:center;color:#c8b3a3;font-family:'Crimson Pro',Georgia,serif;font-size:.9rem;pointer-events:none;}
.ps-osd-wait[hidden]{display:none;}
.ps-zoom-exit{position:absolute;right:14px;top:14px;z-index:4;display:inline-flex;align-items:center;gap:6px;padding:7px 13px;background:rgba(20,10,12,.82);border:1px solid rgba(212,175,105,.5);border-radius:999px;color:#f3e9e0;font-family:'Crimson Pro',Georgia,serif;font-size:.85rem;cursor:pointer;transition:background .15s,color .15s;}
.ps-zoom-exit:hover,.ps-zoom-exit:focus-visible{background:rgba(20,10,12,.96);color:#fff;}
.ps-zoom-exit[hidden]{display:none;}
.ps-modal:fullscreen{width:100vw;height:100vh;max-height:none;border:none;border-radius:0;top:0;left:0;transform:none;}
.ps-modal:fullscreen .ps-stage{aspect-ratio:auto;}
@media(max-width:640px){.ps-nav{width:38px;height:38px;font-size:20px;}.ps-poster-badge{font-size:.8rem;}
  .ps-zoom-badge{font-size:.72rem;padding:5px 10px;left:8px;bottom:8px;}
  .ps-zoom-exit{font-size:.75rem;padding:5px 10px;right:8px;top:8px;}}
</style>

<button class="ps-poster" type="button" id="pwPresentation" aria-haspopup="dialog" aria-controls="psModal"
        aria-label="Open the presentation — The Common Ground We Share, a visual walkthrough of the thirteen Articles">
  <img class="ps-poster-img" src="https://media.wordsofplainness.org/web/aoid-slides/slide-01.webp"
       alt="The Common Ground We Share — Presentation: Articles of Interfaith Discipleship" loading="lazy" decoding="async">
  <span class="ps-poster-badge" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/></svg>
    Open the presentation · 18 slides
  </span>
</button>

<div class="ps-backdrop" id="psBackdrop" aria-hidden="true"></div>
<div class="ps-modal" id="psModal" role="dialog" aria-modal="true" aria-label="The Common Ground We Share — presentation" aria-hidden="true" tabindex="-1">
  <div class="ps-bar">
    <span class="ps-eyebrow">The Common Ground We Share</span>
    <div class="ps-bar-actions">
      <button class="ps-zoom-btn" type="button" hidden aria-pressed="false" aria-label="Zoom to explore this slide" title="Zoom to explore"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></button>
      <button class="ps-fs" type="button" aria-label="Toggle fullscreen"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg></button>
      <button class="ps-close" type="button" aria-label="Close presentation"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
  </div>
  <div class="ps-stage">
    <button class="ps-nav ps-prev" type="button" aria-label="Previous slide">‹</button>
    <img id="psImg" alt="">
    <div class="ps-osd" id="psOsd" hidden><div class="ps-osd-mount" id="psOsdMount"></div><span class="ps-osd-wait" id="psOsdMsg" hidden></span></div>
    <button class="ps-zoom-exit" id="psZoomExit" type="button" hidden><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Back to slides</button>
    <button class="ps-zoom-badge" id="psZoomBadge" type="button" hidden><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>Zoomable — tap to explore</button>
    <button class="ps-nav ps-next" type="button" aria-label="Next slide">›</button>
  </div>
  <div class="ps-footer">
    <span id="psCounter">1 / 18</span>
    <a class="ps-jump" id="psJump" href="#" hidden>Open Article <span id="psJumpNum">1</span> ↗</a>
  </div>
</div>

<script>
(function () {
  var BASE = 'https://media.wordsofplainness.org/web/aoid-slides/', COUNT = 18, STORE = 'wop-aoid-pres-slide';
  var ANCHORS = ['of-plainness','of-god','of-creation-and-life','of-gods-word','of-jesus-christ','of-salvation','of-the-kingdom-at-hand','of-fellow-believers','of-finding-our-way','of-living-by-grace','of-covenants-and-commitments','of-immortality-and-eternal-life','of-our-confidence'];
  var FIRST_ARTICLE_SLIDE = 4;  // slide 4 = Article 1, one slide per article
  function url(n){ return BASE + 'slide-' + String(n).padStart(2,'0') + '.webp'; }
  function articleFor(s){ var i = s - FIRST_ARTICLE_SLIDE; return (i >= 0 && i < ANCHORS.length) ? { num: i + 1, anchor: ANCHORS[i] } : null; }
  var poster=document.getElementById('pwPresentation'), backdrop=document.getElementById('psBackdrop'), modal=document.getElementById('psModal');
  if(!poster||!modal||!backdrop) return;
  var img=document.getElementById('psImg'), counter=document.getElementById('psCounter');
  var jump=document.getElementById('psJump'), jumpNum=document.getElementById('psJumpNum');
  var prevBtn=modal.querySelector('.ps-prev'), nextBtn=modal.querySelector('.ps-next'), fsBtn=modal.querySelector('.ps-fs'), closeBtn=modal.querySelector('.ps-close');
  var idx=(function(){ try{ var v=parseInt(localStorage.getItem(STORE),10); return (v>=1&&v<=COUNT)?v:1; }catch(e){ return 1; } })();
  function pre(n){ if(n>=1&&n<=COUNT){ var i=new Image(); i.src=url(n); } }

  /* ── Deep zoom ──────────────────────────────────────────────────────────
     Slide number -> Deep Zoom pyramid. Add an entry to make another slide
     zoomable; the control and badge appear automatically. Tiles live on R2,
     never in the repo. OpenSeadragon is fetched on first open only, so the
     carousel's initial weight is unchanged.

     The descriptor is declared inline rather than pointed at tree.dzi, because
     reading the .dzi would be a cross-origin XHR and the R2 bucket serves no
     CORS headers — OpenSeadragon fails with "Unable to open". Tiles are plain
     <img> loads, which need no CORS, so inlining the same values the .dzi
     carries sidesteps the problem and saves a round-trip. The .dzi is still
     published beside the tiles as the manifest of record; keep these numbers in
     step with it. */
  var ZOOMABLE = {
    2: { dzi:'https://media.wordsofplainness.org/web/aoid-slides/tree-of-christ/tree.dzi',
         width:7680, height:4320, tileSize:254, overlap:1, format:'webp' }
  };
  function tileSourceFor(z){
    return { Image: {
      xmlns:'http://schemas.microsoft.com/deepzoom/2008',
      Url: z.dzi.replace(/\.dzi$/, '_files/'),
      Format: z.format, Overlap: String(z.overlap), TileSize: String(z.tileSize),
      Size: { Width: String(z.width), Height: String(z.height) }
    } };
  }
  var OSD_SRC = 'https://cdnjs.cloudflare.com/ajax/libs/openseadragon/4.1.1/openseadragon.min.js';
  var OSD_SRI = 'sha512-LbaoUnRCul2C+I4cdS/EMnMbynmZMU58AApBnZkhMzp/r8rOS7htjTsox7g6rf5ZXkSx56F5dDYmhLwqV1Zt4A==';
  var osdBox=document.getElementById('psOsd'), osdMount=document.getElementById('psOsdMount');
  var osdMsg=document.getElementById('psOsdMsg'), zoomBtn=modal.querySelector('.ps-zoom-btn');
  var zoomBadge=document.getElementById('psZoomBadge'), zoomExit=document.getElementById('psZoomExit');
  var osdPromise=null, viewer=null, zoomOpen=false;

  function loadOSD(){
    if(window.OpenSeadragon) return Promise.resolve(window.OpenSeadragon);
    if(osdPromise) return osdPromise;
    osdPromise=new Promise(function(resolve,reject){
      var s=document.createElement('script');
      s.src=OSD_SRC; s.integrity=OSD_SRI; s.crossOrigin='anonymous'; s.async=true;
      s.onload=function(){ window.OpenSeadragon ? resolve(window.OpenSeadragon) : reject(new Error('OpenSeadragon absent after load')); };
      s.onerror=function(){ osdPromise=null; reject(new Error('OpenSeadragon failed to load')); };
      document.head.appendChild(s);
    });
    return osdPromise;
  }
  function syncZoomControls(){
    var can=!!ZOOMABLE[idx];
    zoomBtn.hidden=!can;
    zoomBadge.hidden=!can||zoomOpen;
    zoomBtn.setAttribute('aria-pressed', zoomOpen?'true':'false');
  }
  function closeZoom(){
    if(viewer){ try{ viewer.destroy(); }catch(e){} viewer=null; }
    osdMount.innerHTML=''; osdMount.removeAttribute('style');
    osdMsg.hidden=true; osdMsg.textContent='';
    osdBox.hidden=true; zoomExit.hidden=true;
    zoomOpen=false; syncZoomControls();
  }
  function openZoom(){
    var src=ZOOMABLE[idx]; if(!src||zoomOpen) return;
    var forIdx=idx;
    zoomOpen=true; osdBox.hidden=false; zoomExit.hidden=false; syncZoomControls();
    osdMsg.textContent='Loading the deep-zoom view…'; osdMsg.hidden=false;
    loadOSD().then(function(OSD){
      if(!zoomOpen||idx!==forIdx) return;   /* closed or navigated while loading */
      osdMsg.hidden=true;
      viewer=OSD({
        element:osdMount, tileSources:tileSourceFor(src), prefixUrl:'',
        showNavigationControl:false, showNavigator:false, showSequenceControl:false,
        visibilityRatio:1, constrainDuringPan:true, minZoomImageRatio:0.9, maxZoomPixelRatio:2,
        animationTime:0.6, springStiffness:7, blendTime:0, imageLoaderLimit:6,
        gestureSettingsMouse:{ scrollToZoom:true, clickToZoom:false, dblClickToZoom:true, dragToPan:true },
        gestureSettingsTouch:{ pinchToZoom:true, dragToPan:true, flickEnabled:true, dblClickToZoom:true }
      });
      /* Re-sync to the stage's real size once the pyramid opens. If the viewer
         was built in the same tick the modal was revealed, OpenSeadragon can
         measure a stale container and land the tree off-centre; forcing the
         container size and going home here fixes that without depending on any
         frame or timer having fired first. */
      viewer.addHandler('open', function(){
        try{
          viewer.viewport.resize(new OSD.Point(osdMount.clientWidth, osdMount.clientHeight), false);
          viewer.viewport.goHome(true);
          viewer.forceRedraw();
          viewer.canvas.focus();   /* so the arrow keys pan */
        }catch(e){}
      });
    }).catch(function(){
      if(!zoomOpen) return;
      osdMsg.textContent='The deep-zoom view could not load. Press Escape to return to the slides.';
      osdMsg.hidden=false;
    });
  }
  /* Entering or leaving fullscreen resizes the stage under the viewer. Rather
     than wait on OpenSeadragon's polled autoResize, re-sync explicitly and keep
     the reader's current zoom and centre (maintain=true). */
  document.addEventListener('fullscreenchange', function(){
    if(!viewer) return;
    setTimeout(function(){
      if(!viewer||!window.OpenSeadragon) return;
      try{
        viewer.viewport.resize(new window.OpenSeadragon.Point(osdMount.clientWidth, osdMount.clientHeight), true);
        viewer.viewport.applyConstraints(true);
        viewer.forceRedraw();
      }catch(e){}
    }, 60);
  });
  function panZoom(dx,dy){
    if(!viewer||!window.OpenSeadragon) return;
    var step=viewer.viewport.getBounds().width*0.12;
    viewer.viewport.panBy(new window.OpenSeadragon.Point(dx*step, dy*step));
    viewer.viewport.applyConstraints();
  }

  function render(){
    if(zoomOpen) closeZoom();   /* any slide change drops the viewer */
    img.src=url(idx); img.alt='Slide '+idx+' of '+COUNT;
    counter.textContent=idx+' / '+COUNT;
    prevBtn.disabled=(idx===1); nextBtn.disabled=(idx===COUNT);
    var art=articleFor(idx);
    if(art){ jumpNum.textContent=art.num; jump.href='#'+art.anchor; jump.hidden=false; } else { jump.hidden=true; }
    try{ localStorage.setItem(STORE, idx); }catch(e){}
    syncZoomControls();
    pre(idx+1); pre(idx-1);
  }
  function nav(d){ var n=idx+d; if(n<1||n>COUNT) return; idx=n; render(); }
  function open(){ render(); backdrop.classList.add('open'); modal.classList.add('open'); backdrop.setAttribute('aria-hidden','false'); modal.setAttribute('aria-hidden','false'); modal.focus(); }
  function openAt(n){ idx = (n<1)?1:((n>COUNT)?COUNT:n); open(); }
  function hide(){ closeZoom(); backdrop.classList.remove('open'); modal.classList.remove('open'); backdrop.setAttribute('aria-hidden','true'); modal.setAttribute('aria-hidden','true'); }
  function close(){ if(document.fullscreenElement){ document.exitFullscreen(); } hide(); poster.focus(); }
  function fs(){ if(!document.fullscreenElement){ modal.requestFullscreen && modal.requestFullscreen(); } else { document.exitFullscreen(); } }
  function goToArticle(anchor){ var el=document.getElementById(anchor); if(!el) return; el.scrollIntoView({behavior:'smooth', block:'start'}); history.replaceState(null,'','#'+anchor); }
  function jumpToArticle(){ var art=articleFor(idx); if(!art) return; hide(); if(document.fullscreenElement){ document.addEventListener('fullscreenchange', function once(){ document.removeEventListener('fullscreenchange', once); setTimeout(function(){ goToArticle(art.anchor); }, 60); }); document.exitFullscreen(); } else { goToArticle(art.anchor); } }
  poster.addEventListener('click', open);
  prevBtn.addEventListener('click', function(){ nav(-1); });
  nextBtn.addEventListener('click', function(){ nav(1); });
  fsBtn.addEventListener('click', fs);
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);
  jump.addEventListener('click', function(e){ e.preventDefault(); jumpToArticle(); });
  zoomBtn.addEventListener('click', function(){ zoomOpen ? closeZoom() : openZoom(); });
  zoomBadge.addEventListener('click', openZoom);
  zoomExit.addEventListener('click', closeZoom);
  document.addEventListener('keydown', function(e){
    if(!modal.classList.contains('open')) return;
    /* Zoom open: arrows pan the tree instead of changing slides, and the first
       Escape returns to the flat slide — a second Escape then leaves the modal. */
    if(zoomOpen){
      if(e.key==='Escape'||e.key==='Esc'){ e.preventDefault(); closeZoom(); return; }
      if(e.key==='ArrowLeft'){ e.preventDefault(); panZoom(-1,0); }
      else if(e.key==='ArrowRight'){ e.preventDefault(); panZoom(1,0); }
      else if(e.key==='ArrowUp'){ e.preventDefault(); panZoom(0,-1); }
      else if(e.key==='ArrowDown'){ e.preventDefault(); panZoom(0,1); }
      return;
    }
    if(e.key==='ArrowRight') nav(1); else if(e.key==='ArrowLeft') nav(-1);
    else if(e.key==='Escape'||e.key==='Esc'){ document.fullscreenElement ? document.exitFullscreen() : close(); }
  });

  /* Take over each article's "Slides" button: open THIS deck at the matching slide (Article N -> slide N+3). */
  function injectArticleButtons(){
    document.querySelectorAll('.article-section[data-audio]').forEach(function(section){
      if(section.querySelector('.article-slides-btn')) return;
      var m = /AP_(A\d{2})_/.exec(section.dataset.audio || ''); if(!m) return;
      var slide = parseInt(m[1].slice(1), 10) + 3;
      if(slide < FIRST_ARTICLE_SLIDE || slide > COUNT) return;
      var titleEl = section.querySelector('.article-title');
      var titleText = titleEl ? titleEl.textContent.trim() : 'this article';
      var b = document.createElement('button');
      b.className = 'article-slides-btn';
      b.type = 'button';
      b.setAttribute('aria-label', 'Open presentation slide for ' + titleText);
      b.dataset.slide = slide;
      b.innerHTML = '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg><span class="asb-label">Slides</span>';
      var listenBtn = section.querySelector('.article-read-aloud-btn');
      if(listenBtn){ listenBtn.insertAdjacentElement('afterend', b); }
      else if(titleEl){ var next = titleEl.nextElementSibling; if(next){ section.insertBefore(b, next); } else { section.appendChild(b); } }
      b.addEventListener('click', function(){ openAt(parseInt(b.dataset.slide, 10)); });
    });
  }
  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', injectArticleButtons); } else { injectArticleButtons(); }
})();
</script>
