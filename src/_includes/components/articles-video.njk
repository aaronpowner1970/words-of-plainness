{# Articles Video — per-article "Video" pill → that article's reading page.

   Each pill is a link to /articles/video-NN/, where the reading plays with the
   article following it line by line and the citation apparatus beside it. The
   old in-page modal is gone: a film watched together in VR needs its own page,
   not an overlay on a page of thirteen articles.

   Article 3 has no reading video. /articles/video-03/ redirects to /creation/
   (vercel.json), where "His Work and Glory" already has its own synced
   transcript and citations — so A03 gets a pill like every other article.

   Add a reading by adding the article code to VIDEOS below and an entry to
   src/_data/aoid_videos.json. #}
<style>
/* ── Video pill — twin of .article-slides-btn ─────────────── */
.article-video-btn{display:inline-flex;align-items:center;gap:.38rem;margin-left:.5rem;margin-bottom:.9rem;padding:.28rem .75rem;background:rgba(196,148,58,.06);border:1px solid rgba(196,148,58,.2);border-radius:20px;color:rgba(196,148,58,.7);font-family:var(--font-sans,sans-serif);font-size:.68rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;line-height:1;text-decoration:none;transition:background .18s ease,border-color .18s ease,color .18s ease;}
.article-video-btn svg{flex-shrink:0;opacity:.7;transition:opacity .18s ease;}
.article-video-btn:hover{background:rgba(196,148,58,.13);border-color:rgba(196,148,58,.42);color:var(--gold-primary,#C4943A);text-decoration:none;}
.article-video-btn:hover svg{opacity:1;}
.article-video-btn:active{transform:scale(.97);}
.article-video-btn:focus-visible{outline:2px solid var(--gold-primary,#C4943A);outline-offset:2px;}
</style>

<script>
(function(){
  /* Article code → its reading page. A03 rides the redirect to /creation/. */
  var VIDEOS = ['A01','A02','A03','A04','A05','A06','A07','A08','A09','A10','A11','A12','A13'];

  function icon(){ return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>'; }

  function inject(){
    document.querySelectorAll('.article-section[data-audio]').forEach(function(section){
      if(section.querySelector('.article-video-btn')) return;
      var m=/AP_(A\d{2})_/.exec(section.dataset.audio||''); if(!m) return;
      if(VIDEOS.indexOf(m[1])===-1) return;
      var titleEl=section.querySelector('.article-title');
      var titleText=titleEl?titleEl.textContent.trim():'this article';
      var a=document.createElement('a');
      a.className='article-video-btn';
      a.href='/articles/video-'+m[1].slice(1)+'/';
      a.setAttribute('aria-label','Watch the video reading of '+titleText);
      a.innerHTML=icon()+'<span class="avb-label">Video</span>';
      var slidesBtn=section.querySelector('.article-slides-btn');
      var listenBtn=section.querySelector('.article-read-aloud-btn');
      if(slidesBtn){ slidesBtn.insertAdjacentElement('afterend', a); }
      else if(listenBtn){ listenBtn.insertAdjacentElement('afterend', a); }
      else if(titleEl){ var n=titleEl.nextElementSibling; n?section.insertBefore(a,n):section.appendChild(a); }
    });
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', inject); } else { inject(); }
})();
</script>
