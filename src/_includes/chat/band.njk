{#
  chat/band.njk — mockup F. When the page is too narrow for even one side
  column beside the film (container query in chat-session.css), the same
  facts collapse into one band under the video:
  mic badge · title · time left · short message · host, with Focus at the
  right end. Same [data-chat] hooks as the wings, so chat-session.js writes
  both without knowing which one is on screen.

  Context: chatTitle
#}
<div class="chat-band" aria-label="Session status">
    <p class="chat-mic chat-mic--band" data-chat="mic" data-state="muted" role="status">
        <span class="chat-mic-dot" aria-hidden="true"></span>
        <span class="chat-mic-text" data-chat="mic-text">Visitor mics off</span>
    </p>
    <span class="chat-band-title" data-chat="title">{{ chatTitle }}</span>
    <span class="chat-band-time" data-chat="timeleft">Starting shortly</span>
    <span class="chat-band-msg" data-chat="message-short">Mics open at the end for Q/A.</span>
    <span class="chat-band-host">Host: Brother Aaron</span>
    {% if chatParts %}<button class="chat-mode-btn chat-mode-btn--band" type="button" data-chat="mode">&#8644; Part 1 only</button>{% endif %}
    <button class="chat-focus-btn chat-focus-btn--band" type="button" data-chat="focus">Focus video</button>
</div>
