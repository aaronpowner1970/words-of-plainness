    <!-- Shared medallion minimize/restore controller (used by the seals below) -->
    <script>
    window.WopSeal = (function () {
        'use strict';
        function isMin(el) { return !!el && el.classList.contains('minimized'); }

        function makeMinimizable(widget, closeBtn, prefix, dock) {
            if (!widget) return { minimizedOnLoad: false };
            var MIN = prefix + '-min';
            var POS = prefix + '-minpos';

            function applyDock() {
                widget.style.left = 'auto';
                widget.style.bottom = 'auto';
                widget.style.right = dock.right;
                widget.style.top = dock.top;
            }

            function minimize() {
                sessionStorage.setItem(POS, JSON.stringify({ left: widget.style.left, top: widget.style.top }));
                sessionStorage.setItem(MIN, '1');
                widget.classList.add('minimized');
                widget.classList.add('articles-seal-widget--visible');
                widget.style.transform = '';
                widget.style.pointerEvents = 'all';
                widget.setAttribute('title', 'Click to restore');
                applyDock();
            }

            function restore() {
                widget.classList.remove('minimized');
                widget.removeAttribute('title');
                sessionStorage.removeItem(MIN);
                var saved = sessionStorage.getItem(POS);
                sessionStorage.removeItem(POS);
                if (saved) {
                    try {
                        var p = JSON.parse(saved);
                        if (p.left && p.top) {
                            widget.style.left = p.left;
                            widget.style.top = p.top;
                            widget.style.right = 'auto';
                            widget.style.bottom = 'auto';
                            return;
                        }
                    } catch (e) {}
                }
                widget.style.left = ''; widget.style.top = '';
                widget.style.right = ''; widget.style.bottom = '';
            }

            if (closeBtn) {
                closeBtn.addEventListener('click', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    if (!isMin(widget)) minimize();
                });
            }
            widget.addEventListener('mousedown', function (e) {
                if (isMin(widget)) { e.stopImmediatePropagation(); e.preventDefault(); }
            }, true);
            widget.addEventListener('click', function (e) {
                if (isMin(widget)) { e.stopImmediatePropagation(); e.preventDefault(); restore(); }
            }, true);

            if (sessionStorage.getItem(MIN) === '1') {
                widget.classList.add('minimized');
                widget.classList.add('articles-seal-widget--visible');
                widget.style.pointerEvents = 'all';
                widget.setAttribute('title', 'Click to restore');
                applyDock();
                return { minimizedOnLoad: true };
            }
            return { minimizedOnLoad: false };
        }

        return { makeMinimizable: makeMinimizable, isMin: isMin };
    })();
    </script>

    <!-- =====================================================
         ARTICLES SEAL WIDGET
         Floating / draggable link to /articles/
         Suppressed on chapter-hero pages (chapters, card-
         chapters, /articles/ itself). Session-dismissed.
         ===================================================== -->
    <div id="articlesSealWidget" class="articles-seal-widget" role="complementary" aria-label="Articles of Interfaith Discipleship">
        <a href="/articles/" class="articles-seal-widget-link" title="Articles of Interfaith Discipleship — Christ-Centered Declarations of Shared Beliefs" draggable="false">
            <img src="/assets/images/articles_banner_shadow.png"
                 alt="Articles of Interfaith Discipleship"
                 class="articles-seal-widget-img"
                 draggable="false">
        </a>
        <button class="articles-seal-widget-close" id="articlesSealWidgetClose" aria-label="Minimize Articles seal">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </button>
        <span class="articles-seal-widget-drag" aria-hidden="true">drag</span>
    </div>

    <script>
    (function() {
        'use strict';

        // Suppress on chapter, card-chapter, and /articles/ pages
        // All three layouts use .chapter-hero
        if (document.querySelector('.chapter-hero')) return;

        var widget = document.getElementById('articlesSealWidget');
        if (!widget) return;

        // Minimize-to-thumbnail (session-persisted). The corner chevron tucks
        // this seal to a docked thumbnail instead of dismissing it; clicking the
        // thumbnail restores it. Replaces the former hard dismissal.
        var minCtl = WopSeal.makeMinimizable(widget, document.getElementById('articlesSealWidgetClose'), 'wop-seal', { right: '16px', top: '40%' });

        // Size modifier: homepage + /writings/ get the large seal
        var path       = window.location.pathname;
        var isHomePage = path === '/' || path === '/index.html';
        var isLargeSeal = isHomePage || path === '/writings/' || path === '/writings';
        if (isLargeSeal) widget.classList.add('articles-seal-widget--home');

        if (minCtl.minimizedOnLoad) { /* came up docked — skip default placement & fade */ } else {
        // Restore position saved earlier in this session
        var savedPos = sessionStorage.getItem('wop-seal-pos');
        if (savedPos) {
            try {
                var pos = JSON.parse(savedPos);
                var maxLeft = window.innerWidth  - widget.offsetWidth  - 24;
                var maxTop  = window.innerHeight - widget.offsetHeight - 24;
                var safeLeft = Math.max(24, Math.min(maxLeft, parseInt(pos.left, 10)));
                var safeTop  = Math.max(24, Math.min(maxTop,  parseInt(pos.top,  10)));
                widget.style.left   = safeLeft + 'px';
                widget.style.top    = safeTop  + 'px';
                widget.style.bottom = 'auto';
                widget.style.right  = 'auto';
            } catch (e) {}
        }

        // Desktop homepage only: position to the right of the hero CTA buttons
        // (not on mobile — stacked layout has no room to the right;
        //  not on /writings/ — no .hero-cta element there)
        var isDesktop = !window.matchMedia('(pointer: coarse)').matches;
        if (isHomePage && !savedPos && isDesktop) {
            // Wait one frame so layout is fully rendered before measuring
            requestAnimationFrame(function() {
                var cta = document.querySelector('.hero-cta');
                if (!cta) return;
                var rect   = widget.getBoundingClientRect();
                var ctaRect = cta.getBoundingClientRect();
                var gap    = 48;  // px gap between CTA right edge and seal left edge
                var leftPos = ctaRect.right + gap;
                // Clamp: don't overflow right edge
                if (leftPos + rect.width > window.innerWidth - 24) {
                    leftPos = window.innerWidth - rect.width - 24;
                }
                // Vertically: align center of seal with center of CTA group
                var topPos = ctaRect.top + (ctaRect.height / 2) - (rect.height / 2);
                // Clamp: keep on screen
                topPos = Math.max(24, Math.min(window.innerHeight - rect.height - 24, topPos));
                widget.style.left   = leftPos + 'px';
                widget.style.top    = topPos  + 'px';
                widget.style.bottom = 'auto';
                widget.style.right  = 'auto';
            });
        }

        // 2-second delay, then fade in
        setTimeout(function() {
            widget.classList.add('articles-seal-widget--visible');
        }, 2000);
        }

        // (Minimize/restore is wired by WopSeal.makeMinimizable above.)

        // Drag — desktop (fine pointer) only
        var isTouch = window.matchMedia('(pointer: coarse)').matches;
        if (isTouch) return;

        var isDragging = false;
        var hasMoved   = false;
        var startX, startY, startLeft, startTop;
        var THRESHOLD  = 6; // px before drag activates

        widget.addEventListener('mousedown', function(e) {
            if (e.target.closest('#articlesSealWidgetClose')) return;
            isDragging = true;
            hasMoved   = false;
            startX     = e.clientX;
            startY     = e.clientY;
            var rect   = widget.getBoundingClientRect();
            startLeft  = rect.left;
            startTop   = rect.top;
            // Convert bottom/right to explicit top/left so we can freely position
            widget.style.transition = 'none';
            widget.style.left       = rect.left + 'px';
            widget.style.top        = rect.top  + 'px';
            widget.style.right      = 'auto';
            widget.style.bottom     = 'auto';
            widget.classList.add('articles-seal-widget--dragging');
            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup',   stopDrag);
            e.preventDefault();
        });

        function onDrag(e) {
            if (!isDragging) return;
            var dx = e.clientX - startX;
            var dy = e.clientY - startY;
            if (Math.abs(dx) > THRESHOLD || Math.abs(dy) > THRESHOLD) hasMoved = true;
            var newLeft = Math.max(0, Math.min(window.innerWidth  - widget.offsetWidth,  startLeft + dx));
            var newTop  = Math.max(0, Math.min(window.innerHeight - widget.offsetHeight, startTop  + dy));
            widget.style.left = newLeft + 'px';
            widget.style.top  = newTop  + 'px';
        }

        function stopDrag() {
            if (!isDragging) return;
            isDragging = false;
            widget.classList.remove('articles-seal-widget--dragging');
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup',   stopDrag);
            if (hasMoved) snapToGrid();
            // Save position for this session
            sessionStorage.setItem('wop-seal-pos', JSON.stringify({
                left: widget.style.left,
                top:  widget.style.top
            }));
        }

        function snapToGrid() {
            var wW     = widget.offsetWidth;
            var wH     = widget.offsetHeight;
            var wRect  = widget.getBoundingClientRect();
            var cx     = wRect.left + wW / 2;
            var cy     = wRect.top  + wH / 2;
            var vW     = window.innerWidth;
            var vH     = window.innerHeight;
            // Dynamic margins: 20% of each viewport dimension
            // Outer snap positions are inset from screen edges by this amount,
            // so the medallion never touches the edge regardless of screen size
            var mX = Math.round(vW * 0.20);
            var mY = Math.round(vH * 0.20);

            // Divide viewport into thirds to determine snap zone
            // col: 0 = left, 1 = center, 2 = right
            var col = cx < vW / 3 ? 0 : (cx < 2 * vW / 3 ? 1 : 2);
            // row: 0 = top,  1 = middle, 2 = bottom
            var row = cy < vH / 3 ? 0 : (cy < 2 * vH / 3 ? 1 : 2);

            var snapX = col === 0 ? mX
                      : col === 1 ? Math.round((vW - wW) / 2)
                      :             vW - wW - mX;

            var snapY = row === 0 ? mY
                      : row === 1 ? Math.round((vH - wH) / 2)
                      :             vH - wH - mY;

            widget.style.transition = 'left 0.3s ease, top 0.3s ease';
            widget.style.left   = snapX + 'px';
            widget.style.top    = snapY + 'px';
            widget.style.right  = 'auto';
            widget.style.bottom = 'auto';

            setTimeout(function() { widget.style.transition = ''; }, 350);
        }

        // Prevent link navigation when user has dragged
        var link = widget.querySelector('.articles-seal-widget-link');
        if (link) {
            link.addEventListener('click', function(e) {
                if (hasMoved) { e.preventDefault(); hasMoved = false; }
            });
        }

    }());
    </script>

    {% if page.url == '/' %}
    <!-- =====================================================
         LIVE GATHERING BADGE  (homepage only)
         Floating / draggable link to the #gathering section.
         Mirrors the Articles seal and stacks just above it.
         Session-dismissed; own position persistence.
         ===================================================== -->
    <div id="gatheringSealWidget" class="articles-seal-widget gathering-seal-widget articles-seal-widget--home" role="complementary" aria-label="The Live Gathering — weekly Christ-centered interfaith forum">
        <a href="#gathering" class="articles-seal-widget-link gathering-seal-widget-link" title="The Live Gathering — Wednesdays 7:00 PM Mountain Time" draggable="false">
            <img src="/assets/images/chat_banner_shadow.png"
                 alt="The Live Gathering — weekly Christ-centered interfaith forum"
                 class="articles-seal-widget-img"
                 draggable="false">
        </a>
        <button class="articles-seal-widget-close" id="gatheringSealWidgetClose" aria-label="Minimize Live Gathering badge">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </button>
        <span class="articles-seal-widget-drag" aria-hidden="true">drag</span>
    </div>

    <script>
    (function() {
        'use strict';
        var widget = document.getElementById('gatheringSealWidget');
        if (!widget) return;
        var GAP = 18; // px gap above the Articles seal

        // Minimize-to-thumbnail (session-persisted)
        var minCtl = WopSeal.makeMinimizable(widget, document.getElementById('gatheringSealWidgetClose'), 'wop-gathering', { right: '16px', top: 'calc(40% + 70px)' });

        var articles = document.getElementById('articlesSealWidget');
        function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

        // Lay out BOTH seals as one aligned vertical pair: the Articles seal on
        // TOP, this Live Gathering badge directly BELOW it, sharing a center line.
        // The pair is built from the bottom up off the Articles seal's anchored
        // spot (desktop: beside the hero CTA; mobile: bottom-right), so the badge
        // never overflows and the Articles seal always leads.
        function placeDefault() {
            var gW = widget.offsetWidth, gH = widget.offsetHeight;
            if (!articles || articles.style.display === 'none' || articles.offsetWidth === 0 || WopSeal.isMin(articles)) {
                widget.style.left = clamp(window.innerWidth - gW - 24, 12, window.innerWidth - gW - 12) + 'px';
                widget.style.top  = clamp(window.innerHeight - gH - 24, 12, window.innerHeight - gH - 12) + 'px';
                widget.style.right = 'auto';
                widget.style.bottom = 'auto';
                return;
            }
            var aRect = articles.getBoundingClientRect();
            var aW = aRect.width, aH = aRect.height;
            var centerX = aRect.left + aW / 2;

            var gTop = aRect.bottom - gH;        // badge takes the bottom slot
            var aTop = gTop - GAP - aH;          // Articles lifts above the badge
            if (aTop < 84) { var d = 84 - aTop; aTop += d; gTop += d; }  // clear the header

            widget.style.left = clamp(centerX - gW / 2, 12, window.innerWidth - gW - 12) + 'px';
            widget.style.top  = clamp(gTop, 12, window.innerHeight - gH - 12) + 'px';
            widget.style.right = 'auto';
            widget.style.bottom = 'auto';

            // Lift the Articles seal above the badge unless the reader dragged it
            // or it has been tucked to a thumbnail.
            if (!sessionStorage.getItem('wop-seal-pos') && !WopSeal.isMin(articles)) {
                articles.style.left = clamp(centerX - aW / 2, 12, window.innerWidth - aW - 12) + 'px';
                articles.style.top  = clamp(aTop, 12, window.innerHeight - aH - 12) + 'px';
                articles.style.right = 'auto';
                articles.style.bottom = 'auto';
            }
        }

        if (minCtl.minimizedOnLoad) { /* came up docked — skip default placement */ } else {
        var savedPos = sessionStorage.getItem('wop-gathering-pos');
        if (savedPos) {
            try {
                var pos = JSON.parse(savedPos);
                var maxLeft = window.innerWidth - widget.offsetWidth - 12;
                var maxTop  = window.innerHeight - widget.offsetHeight - 12;
                widget.style.left = clamp(parseInt(pos.left, 10), 12, maxLeft) + 'px';
                widget.style.top  = clamp(parseInt(pos.top, 10), 12, maxTop) + 'px';
                widget.style.right = 'auto';
                widget.style.bottom = 'auto';
            } catch (e) { placeDefault(); }
        } else {
            // Two frames so the Articles seal finishes its own positioning first
            requestAnimationFrame(function() { requestAnimationFrame(placeDefault); });
        }
        }

        // Fade in just after the Articles seal so the stack cascades
        setTimeout(function() {
            widget.classList.add('articles-seal-widget--visible');
        }, 2300);

        // (Minimize/restore is wired by WopSeal.makeMinimizable above.)

        // Drag — desktop (fine pointer) only
        if (window.matchMedia('(pointer: coarse)').matches) return;

        var isDragging = false, hasMoved = false, startX, startY, startLeft, startTop;
        var THRESHOLD = 6;

        widget.addEventListener('mousedown', function(e) {
            if (e.target.closest('#gatheringSealWidgetClose')) return;
            isDragging = true; hasMoved = false;
            startX = e.clientX; startY = e.clientY;
            var rect = widget.getBoundingClientRect();
            startLeft = rect.left; startTop = rect.top;
            widget.style.transition = 'none';
            widget.style.left = rect.left + 'px';
            widget.style.top  = rect.top + 'px';
            widget.style.right = 'auto'; widget.style.bottom = 'auto';
            widget.classList.add('articles-seal-widget--dragging');
            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup', stopDrag);
            e.preventDefault();
        });

        function onDrag(e) {
            if (!isDragging) return;
            var dx = e.clientX - startX, dy = e.clientY - startY;
            if (Math.abs(dx) > THRESHOLD || Math.abs(dy) > THRESHOLD) hasMoved = true;
            widget.style.left = clamp(startLeft + dx, 0, window.innerWidth - widget.offsetWidth) + 'px';
            widget.style.top  = clamp(startTop + dy, 0, window.innerHeight - widget.offsetHeight) + 'px';
        }

        function stopDrag() {
            if (!isDragging) return;
            isDragging = false;
            widget.classList.remove('articles-seal-widget--dragging');
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup', stopDrag);
            if (hasMoved) snapToGrid();
            sessionStorage.setItem('wop-gathering-pos', JSON.stringify({ left: widget.style.left, top: widget.style.top }));
        }

        function snapToGrid() {
            var wW = widget.offsetWidth, wH = widget.offsetHeight;
            var r = widget.getBoundingClientRect();
            var cx = r.left + wW / 2, cy = r.top + wH / 2;
            var vW = window.innerWidth, vH = window.innerHeight;
            var mX = Math.round(vW * 0.20), mY = Math.round(vH * 0.20);
            var col = cx < vW / 3 ? 0 : (cx < 2 * vW / 3 ? 1 : 2);
            var row = cy < vH / 3 ? 0 : (cy < 2 * vH / 3 ? 1 : 2);
            var snapX = col === 0 ? mX : col === 1 ? Math.round((vW - wW) / 2) : vW - wW - mX;
            var snapY = row === 0 ? mY : row === 1 ? Math.round((vH - wH) / 2) : vH - wH - mY;
            widget.style.transition = 'left 0.3s ease, top 0.3s ease';
            widget.style.left = snapX + 'px'; widget.style.top = snapY + 'px';
            widget.style.right = 'auto'; widget.style.bottom = 'auto';
            setTimeout(function() { widget.style.transition = ''; }, 350);
        }

        var link = widget.querySelector('.gathering-seal-widget-link');
        if (link) {
            link.addEventListener('click', function(e) {
                if (hasMoved) { e.preventDefault(); hasMoved = false; }
            });
        }
    }());
    </script>
    {% endif %}

