<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description | default(site.description) }}">

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.wordsofplainness.org{{ page.url }}">

    <!-- Open Graph -->
    <meta property="og:type" content="{% if layout == 'layouts/chapter.njk' %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ og_title | default(title) | default(site.name) }}">
    <meta property="og:description" content="{{ description | default(site.description) }}">
    <meta property="og:url" content="https://www.wordsofplainness.org{{ page.url }}">
    <meta property="og:site_name" content="Words of Plainness">
    <meta property="og:image" content="https://www.wordsofplainness.org/assets/images/og-default.png">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ og_title | default(title) | default(site.name) }}">
    <meta name="twitter:description" content="{{ description | default(site.description) }}">
    <meta name="twitter:image" content="https://www.wordsofplainness.org/assets/images/og-default.png">

    <!-- JSON-LD Structured Data — sitewide Organization + WebSite -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://www.wordsofplainness.org/#organization",
      "name": "Words of Plainness",
      "url": "https://www.wordsofplainness.org",
      "logo": "https://www.wordsofplainness.org/assets/images/lantern_logo_line_art.png",
      "sameAs": [
        "https://www.facebook.com/profile.php?id=61577415137382",
        "https://x.com/WoPlainness",
        "https://discord.gg/UKEBz2YmdF",
        "https://aaronpowner.com",
        "https://www.pub.powner.org"
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://www.wordsofplainness.org/#website",
      "url": "https://www.wordsofplainness.org",
      "name": "Words of Plainness",
      "description": "A Christ-Centered Ministry for Seekers and Latter-day Saints",
      "publisher": { "@id": "https://www.wordsofplainness.org/#organization" }
    }
    </script>
    {%- set _articleByLayout = layout == "layouts/chapter.njk" or layout == "layouts/study.njk" or layout == "layouts/articles.njk" -%}
    {%- set _articleByStudiesUrl = page.url and page.url.startsWith("/studies/") and page.url != "/studies/" and page.url != "/studies/declarations/" and not _articleByLayout -%}
    {% if _articleByLayout %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ (og_title or title) | dump | safe }},
      "description": {{ (description or site.description) | dump | safe }},
      "url": "https://www.wordsofplainness.org{{ page.url }}",
      "datePublished": "{{ page.date | isoDate }}",
      "dateModified": "{% if dateModified %}{{ dateModified | isoDate }}{% else %}{{ page.date | isoDate }}{% endif %}",
      "image": "https://www.wordsofplainness.org/assets/images/og-default.png",
      "author": { "@type": "Person", "name": "Aaron Powner" },
      "publisher": { "@id": "https://www.wordsofplainness.org/#organization" },
      "isPartOf": { "@id": "https://www.wordsofplainness.org/#website" },
      "mainEntityOfPage": "https://www.wordsofplainness.org{{ page.url }}"
    }
    </script>
    {% elif _articleByStudiesUrl %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ (og_title or title) | dump | safe }},
      "description": {{ (description or site.description) | dump | safe }},
      "url": "https://www.wordsofplainness.org{{ page.url }}",
      "author": { "@type": "Person", "name": "Aaron Powner" },
      "publisher": { "@id": "https://www.wordsofplainness.org/#organization" },
      "isPartOf": { "@id": "https://www.wordsofplainness.org/#website" },
      "mainEntityOfPage": "https://www.wordsofplainness.org{{ page.url }}"
      {%- if date %},
      "datePublished": "{{ date | isoDate }}"
      {%- endif %}
      {%- if dateModified %},
      "dateModified": "{{ dateModified | isoDate }}"
      {%- endif %}
      {%- if og_image or image %},
      "image": "{{ og_image or image }}"
      {%- endif %}
    }
    </script>
    {% elif layout == "layouts/post.njk" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | dump | safe }},
      "description": {{ (description or title) | dump | safe }},
      "url": "https://www.wordsofplainness.org{{ page.url }}",
      "datePublished": "{{ page.date | isoDate }}",
      "dateModified": "{% if dateModified %}{{ dateModified | isoDate }}{% else %}{{ page.date | isoDate }}{% endif %}",
      "image": "{% if image %}https://www.wordsofplainness.org/assets/images/posts/{{ image }}{% else %}https://www.wordsofplainness.org/assets/images/wop-og-default.jpg{% endif %}",
      "author": { "@type": "Person", "name": {{ (author or "Brother Aaron") | dump | safe }} },
      "publisher": { "@id": "https://www.wordsofplainness.org/#organization" },
      "isPartOf": { "@id": "https://www.wordsofplainness.org/#website" },
      "mainEntityOfPage": "https://www.wordsofplainness.org{{ page.url }}"
    }
    </script>
    {% endif %}
    {% if page.url == "/volume-1/" or page.url == "/volume-2/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Book",
      "name": {{ title | dump | safe }},
      "description": {{ description | dump | safe }},
      "url": "https://www.wordsofplainness.org{{ page.url }}",
      "inLanguage": "en",
      "author": { "@type": "Person", "name": "Aaron Powner" },
      "publisher": { "@id": "https://www.wordsofplainness.org/#organization" }
    }
    </script>
    {% endif %}

