    {% if draft %}<meta name="robots" content="noindex,nofollow">{% elif noindex %}<meta name="robots" content="noindex">{% endif %}

    <!-- Canonical URL -->{# `canonical` overrides it: the /chat/ presentation
        pages are noindex duplicates of a public page and point at that page
        instead. This note is a NUNJUCKS comment opened on the line above and
        closed here: an HTML comment would render into every page on the site,
        and a comment on its own lines would add or drop a blank line. Either
        one shows up as a diff on the public pages, which must stay
        byte-identical. #}
    <link rel="canonical" href="https://www.wordsofplainness.org{{ canonical | default(page.url) }}">

