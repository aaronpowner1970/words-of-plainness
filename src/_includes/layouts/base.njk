<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description | default(site.description) }}">

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.wordsofplainness.org{{ page.url }}">

    <!-- Open Graph -->
    <meta property="og:type" content="{% if layout == 'layouts/chapter.njk' %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ og_title | default(title) | default(site.name) }}">
    <meta property="og:description" content="{{ description | default(site.description) }}">
    <meta property="og:url" content="https://www.wordsofplainness.org{{ page.url }}">
    <meta property="og:site_name" content="Words of Plainness">
    <meta property="og:image" content="https://www.wordsofplainness.org/assets/images/og-default.png">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ og_title | default(title) | default(site.name) }}">
    <meta name="twitter:description" content="{{ description | default(site.description) }}">
    <meta name="twitter:image" content="https://www.wordsofplainness.org/assets/images/og-default.png">

    <!-- JSON-LD Structured Data -->
    {% if layout == "layouts/chapter.njk" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "{{ og_title | default(title) }}",
      "description": "{{ description | default(site.description) }}",
      "url": "https://www.wordsofplainness.org{{ page.url }}",
      "author": {
        "@type": "Person",
        "name": "Aaron Powner"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Words of Plainness",
        "url": "https://www.wordsofplainness.org"
      },
      "isPartOf": {
        "@type": "WebSite",
        "name": "Words of Plainness",
        "url": "https://www.wordsofplainness.org"
      }
    }
    </script>
    {% endif %}

    {% block head %}{% endblock %}
    <title>{{ title }}{% if title %} | {% endif %}{{ site.name }}</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Source+Sans+Pro:wght@400;600&display=swap" rel="stylesheet">
    
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/assets/favicons/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicons/favicon-48x48.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon.png">
    <link rel="manifest" href="/assets/favicons/site.webmanifest">
    <meta name="theme-color" content="#C4943A">
    <meta name="google-site-verification" content="DDP9QSxaOLU2O-pWXrMitcruy3ZVvx32b0PuJrYDp0E" />
    
    <!-- RSS Feed -->
    <link rel="alternate" href="/posts/feed.xml" title="Words of Plainness — Posts" type="application/atom+xml">
    
    <!-- Styles -->
    <link rel="stylesheet" href="/css/styles.css?v={{ site.version }}">
    <link rel="stylesheet" href="/css/auth-modal.css">
    <link rel="stylesheet" href="/css/anthem-player.css">
    {% block styles %}{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %} data-api-url="{{ site.api.baseUrl }}">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    {% include "partials/header.njk" %}
    {% include "partials/mobile-menu.njk" %}
    
    <main id="main-content">
        {% block content %}
        {{ content | safe }}
        {% endblock %}
    </main>
    
    {% include "partials/footer.njk" %}

    <!-- Auth Modal -->
    <div id="authModal" role="dialog" aria-labelledby="authTitle" aria-modal="true" style="display:none">
        <div class="auth-modal-content">
            <div class="auth-modal-header">
                <h2 id="authTitle">Sign In</h2>
                <button class="auth-close" data-auth-close aria-label="Close">
                    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="auth-error hidden" id="authError"></div>
            <form class="auth-form" id="authForm">
                <div class="auth-field hidden" id="authNameField">
                    <label for="authName">Display Name</label>
                    <input type="text" id="authName" name="display_name" placeholder="How should we address you?">
                    <small class="auth-hint">How you'll appear to others (optional)</small>
                    <small class="auth-field-error hidden" data-field-error="display_name"></small>
                </div>
                <div class="auth-field hidden" id="authUsernameField">
                    <label for="authUsername">Username</label>
                    <input type="text" id="authUsername" name="username" placeholder="Choose a username">
                    <small class="auth-hint">Letters, numbers, and underscores only</small>
                    <small class="auth-field-error hidden" data-field-error="username"></small>
                </div>
                <div class="auth-field">
                    <label for="authEmail" id="authEmailLabel">Username or Email</label>
                    <input type="text" id="authEmail" name="email" required placeholder="Enter username or email">
                    <small class="auth-field-error hidden" data-field-error="email"></small>
                </div>
                <div class="auth-field">
                    <label for="authPassword">Password</label>
                    <input type="password" id="authPassword" name="password" required placeholder="Your password">
                    <small class="auth-field-error hidden" data-field-error="password"></small>
                </div>
                <div class="auth-field hidden" id="authPasswordConfirmField">
                    <label for="authPasswordConfirm">Confirm Password</label>
                    <input type="password" id="authPasswordConfirm" name="password_confirm" placeholder="Re-enter your password">
                    <small class="auth-field-error hidden" data-field-error="password_confirm"></small>
                </div>
                <div class="auth-field hidden" id="authNewsletterField">
                    <label class="auth-checkbox-label">
                        <input type="checkbox" id="authNewsletter" name="subscribe_newsletter" checked>
                        <span>Subscribe to our newsletter for ministry updates</span>
                    </label>
                </div>
                <button type="submit" class="auth-submit" id="authSubmit">Sign In</button>
            </form>
            <p class="auth-switch" id="authSwitchText">
                Don't have an account? <a href="#" id="switchToSignup">Sign up</a>
            </p>
        </div>
    </div>

    <!-- Anthem Audio (hidden — controlled by anthem-player.js) -->
    <audio id="anthemAudio" preload="metadata">
        <source src="https://media.wordsofplainness.org/web/AN_01_The_Marks_of_Your_Worth_Sacred_Americana.mp3" type="audio/mpeg">
    </audio>

    <!-- Global Font Size Widget -->
    <div class="wop-font-widget" id="wopFontWidget" aria-label="Text size">
        <button class="wop-font-btn" id="wopFontDecrease" aria-label="Decrease text size">A<sup>−</sup></button>
        <button class="wop-font-btn reset" id="wopFontReset" aria-label="Reset text size">A</button>
        <button class="wop-font-btn" id="wopFontIncrease" aria-label="Increase text size">A<sup>+</sup></button>
    </div>

    <!-- Core Scripts -->
    <script src="/js/font-size.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/api.js"></script>
    <script src="/js/engagement.js"></script>
    <script src="/js/auth-modal.js"></script>
    <script src="/js/contact-form.js"></script>
    <script src="/js/newsletter.js"></script>
    <script src="/js/anthem-player.js"></script>
    {% block scripts %}{% endblock %}

    <!-- =====================================================
         ARTICLES SEAL WIDGET
         Floating / draggable link to /articles/
         Suppressed on chapter-hero pages (chapters, card-
         chapters, /articles/ itself). Session-dismissed.
         ===================================================== -->
    <div id="articlesSealWidget" class="articles-seal-widget" role="complementary" aria-label="Articles of Interfaith Discipleship">
        <a href="/articles/" class="articles-seal-widget-link" title="Articles of Interfaith Discipleship — Christ-Centered Declarations of Shared Beliefs" draggable="false">
            <img src="/assets/images/articles_banner_shadow.png"
                 alt="Articles of Interfaith Discipleship"
                 class="articles-seal-widget-img"
                 draggable="false">
        </a>
        <button class="articles-seal-widget-close" id="articlesSealWidgetClose" aria-label="Close Articles seal">
            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
        <span class="articles-seal-widget-drag" aria-hidden="true">drag</span>
    </div>

    <script>
    (function() {
        'use strict';

        // Suppress on chapter, card-chapter, and /articles/ pages
        // All three layouts use .chapter-hero
        if (document.querySelector('.chapter-hero')) return;

        var widget = document.getElementById('articlesSealWidget');
        if (!widget) return;

        // Session dismissal — dismissed state clears on new session
        if (sessionStorage.getItem('wop-seal-dismissed') === '1') {
            widget.style.display = 'none';
            return;
        }

        // Size modifier: homepage + /writings/ get the large seal
        var path       = window.location.pathname;
        var isHomePage = path === '/' || path === '/index.html';
        var isLargeSeal = isHomePage || path === '/writings/' || path === '/writings';
        if (isLargeSeal) widget.classList.add('articles-seal-widget--home');

        // Restore position saved earlier in this session
        var savedPos = sessionStorage.getItem('wop-seal-pos');
        if (savedPos) {
            try {
                var pos = JSON.parse(savedPos);
                var maxLeft = window.innerWidth  - widget.offsetWidth  - 24;
                var maxTop  = window.innerHeight - widget.offsetHeight - 24;
                var safeLeft = Math.max(24, Math.min(maxLeft, parseInt(pos.left, 10)));
                var safeTop  = Math.max(24, Math.min(maxTop,  parseInt(pos.top,  10)));
                widget.style.left   = safeLeft + 'px';
                widget.style.top    = safeTop  + 'px';
                widget.style.bottom = 'auto';
                widget.style.right  = 'auto';
            } catch (e) {}
        }

        // Desktop homepage only: position to the right of the hero CTA buttons
        // (not on mobile — stacked layout has no room to the right;
        //  not on /writings/ — no .hero-cta element there)
        var isDesktop = !window.matchMedia('(pointer: coarse)').matches;
        if (isHomePage && !savedPos && isDesktop) {
            // Wait one frame so layout is fully rendered before measuring
            requestAnimationFrame(function() {
                var cta = document.querySelector('.hero-cta');
                if (!cta) return;
                var rect   = widget.getBoundingClientRect();
                var ctaRect = cta.getBoundingClientRect();
                var gap    = 48;  // px gap between CTA right edge and seal left edge
                var leftPos = ctaRect.right + gap;
                // Clamp: don't overflow right edge
                if (leftPos + rect.width > window.innerWidth - 24) {
                    leftPos = window.innerWidth - rect.width - 24;
                }
                // Vertically: align center of seal with center of CTA group
                var topPos = ctaRect.top + (ctaRect.height / 2) - (rect.height / 2);
                // Clamp: keep on screen
                topPos = Math.max(24, Math.min(window.innerHeight - rect.height - 24, topPos));
                widget.style.left   = leftPos + 'px';
                widget.style.top    = topPos  + 'px';
                widget.style.bottom = 'auto';
                widget.style.right  = 'auto';
            });
        }

        // 2-second delay, then fade in
        setTimeout(function() {
            widget.classList.add('articles-seal-widget--visible');
        }, 2000);

        // Close button
        var closeBtn = document.getElementById('articlesSealWidgetClose');
        closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            widget.classList.remove('articles-seal-widget--visible');
            widget.style.transform = 'scale(0.65)';
            widget.style.pointerEvents = 'none';
            setTimeout(function() { widget.style.display = 'none'; }, 500);
            sessionStorage.setItem('wop-seal-dismissed', '1');
        });

        // Drag — desktop (fine pointer) only
        var isTouch = window.matchMedia('(pointer: coarse)').matches;
        if (isTouch) return;

        var isDragging = false;
        var hasMoved   = false;
        var startX, startY, startLeft, startTop;
        var THRESHOLD  = 6; // px before drag activates

        widget.addEventListener('mousedown', function(e) {
            if (e.target.closest('#articlesSealWidgetClose')) return;
            isDragging = true;
            hasMoved   = false;
            startX     = e.clientX;
            startY     = e.clientY;
            var rect   = widget.getBoundingClientRect();
            startLeft  = rect.left;
            startTop   = rect.top;
            // Convert bottom/right to explicit top/left so we can freely position
            widget.style.transition = 'none';
            widget.style.left       = rect.left + 'px';
            widget.style.top        = rect.top  + 'px';
            widget.style.right      = 'auto';
            widget.style.bottom     = 'auto';
            widget.classList.add('articles-seal-widget--dragging');
            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup',   stopDrag);
            e.preventDefault();
        });

        function onDrag(e) {
            if (!isDragging) return;
            var dx = e.clientX - startX;
            var dy = e.clientY - startY;
            if (Math.abs(dx) > THRESHOLD || Math.abs(dy) > THRESHOLD) hasMoved = true;
            var newLeft = Math.max(0, Math.min(window.innerWidth  - widget.offsetWidth,  startLeft + dx));
            var newTop  = Math.max(0, Math.min(window.innerHeight - widget.offsetHeight, startTop  + dy));
            widget.style.left = newLeft + 'px';
            widget.style.top  = newTop  + 'px';
        }

        function stopDrag() {
            if (!isDragging) return;
            isDragging = false;
            widget.classList.remove('articles-seal-widget--dragging');
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup',   stopDrag);
            if (hasMoved) snapToGrid();
            // Save position for this session
            sessionStorage.setItem('wop-seal-pos', JSON.stringify({
                left: widget.style.left,
                top:  widget.style.top
            }));
        }

        function snapToGrid() {
            var wW     = widget.offsetWidth;
            var wH     = widget.offsetHeight;
            var wRect  = widget.getBoundingClientRect();
            var cx     = wRect.left + wW / 2;
            var cy     = wRect.top  + wH / 2;
            var vW     = window.innerWidth;
            var vH     = window.innerHeight;
            // Dynamic margins: 20% of each viewport dimension
            // Outer snap positions are inset from screen edges by this amount,
            // so the medallion never touches the edge regardless of screen size
            var mX = Math.round(vW * 0.20);
            var mY = Math.round(vH * 0.20);

            // Divide viewport into thirds to determine snap zone
            // col: 0 = left, 1 = center, 2 = right
            var col = cx < vW / 3 ? 0 : (cx < 2 * vW / 3 ? 1 : 2);
            // row: 0 = top,  1 = middle, 2 = bottom
            var row = cy < vH / 3 ? 0 : (cy < 2 * vH / 3 ? 1 : 2);

            var snapX = col === 0 ? mX
                      : col === 1 ? Math.round((vW - wW) / 2)
                      :             vW - wW - mX;

            var snapY = row === 0 ? mY
                      : row === 1 ? Math.round((vH - wH) / 2)
                      :             vH - wH - mY;

            widget.style.transition = 'left 0.3s ease, top 0.3s ease';
            widget.style.left   = snapX + 'px';
            widget.style.top    = snapY + 'px';
            widget.style.right  = 'auto';
            widget.style.bottom = 'auto';

            setTimeout(function() { widget.style.transition = ''; }, 350);
        }

        // Prevent link navigation when user has dragged
        var link = widget.querySelector('.articles-seal-widget-link');
        if (link) {
            link.addEventListener('click', function(e) {
                if (hasMoved) { e.preventDefault(); hasMoved = false; }
            });
        }

    }());
    </script>

    {% if page.url == '/' %}
    <!-- =====================================================
         LIVE GATHERING BADGE  (homepage only)
         Floating / draggable link to the #gathering section.
         Mirrors the Articles seal and stacks just above it.
         Session-dismissed; own position persistence.
         ===================================================== -->
    <div id="gatheringSealWidget" class="articles-seal-widget gathering-seal-widget articles-seal-widget--home" role="complementary" aria-label="The Live Gathering — weekly Christ-centered interfaith forum">
        <a href="#gathering" class="articles-seal-widget-link gathering-seal-widget-link" title="The Live Gathering — Wednesdays 7:00 PM Mountain Time" draggable="false">
            <img src="/assets/images/chat_banner_shadow.png"
                 alt="The Live Gathering — weekly Christ-centered interfaith forum"
                 class="articles-seal-widget-img"
                 draggable="false">
        </a>
        <button class="articles-seal-widget-close" id="gatheringSealWidgetClose" aria-label="Close Live Gathering badge">
            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
        <span class="articles-seal-widget-drag" aria-hidden="true">drag</span>
    </div>

    <script>
    (function() {
        'use strict';
        var widget = document.getElementById('gatheringSealWidget');
        if (!widget) return;
        var GAP = 18; // px gap above the Articles seal

        // Session dismissal
        if (sessionStorage.getItem('wop-gathering-dismissed') === '1') {
            widget.style.display = 'none';
            return;
        }

        var articles = document.getElementById('articlesSealWidget');
        function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

        // Default placement: centered just above the Articles seal's rect
        function placeDefault() {
            var w = widget.offsetWidth, h = widget.offsetHeight;
            if (articles && articles.style.display !== 'none' && articles.offsetWidth > 0) {
                var r = articles.getBoundingClientRect();
                widget.style.left = clamp(r.left + (r.width / 2) - (w / 2), 12, window.innerWidth - w - 12) + 'px';
                widget.style.top  = clamp(r.bottom + GAP, 12, window.innerHeight - h - 12) + 'px';
            } else {
                widget.style.left = (window.innerWidth - w - 24) + 'px';
                widget.style.top  = (window.innerHeight - h - 24 - 180 - GAP) + 'px';
            }
            widget.style.right = 'auto';
            widget.style.bottom = 'auto';
        }

        var savedPos = sessionStorage.getItem('wop-gathering-pos');
        if (savedPos) {
            try {
                var pos = JSON.parse(savedPos);
                var maxLeft = window.innerWidth - widget.offsetWidth - 12;
                var maxTop  = window.innerHeight - widget.offsetHeight - 12;
                widget.style.left = clamp(parseInt(pos.left, 10), 12, maxLeft) + 'px';
                widget.style.top  = clamp(parseInt(pos.top, 10), 12, maxTop) + 'px';
                widget.style.right = 'auto';
                widget.style.bottom = 'auto';
            } catch (e) { placeDefault(); }
        } else {
            // Two frames so the Articles seal finishes its own positioning first
            requestAnimationFrame(function() { requestAnimationFrame(placeDefault); });
        }

        // Fade in just after the Articles seal so the stack cascades
        setTimeout(function() {
            widget.classList.add('articles-seal-widget--visible');
        }, 2300);

        // Close
        document.getElementById('gatheringSealWidgetClose').addEventListener('click', function(e) {
            e.stopPropagation(); e.preventDefault();
            widget.classList.remove('articles-seal-widget--visible');
            widget.style.transform = 'scale(0.65)';
            widget.style.pointerEvents = 'none';
            setTimeout(function() { widget.style.display = 'none'; }, 500);
            sessionStorage.setItem('wop-gathering-dismissed', '1');
        });

        // Drag — desktop (fine pointer) only
        if (window.matchMedia('(pointer: coarse)').matches) return;

        var isDragging = false, hasMoved = false, startX, startY, startLeft, startTop;
        var THRESHOLD = 6;

        widget.addEventListener('mousedown', function(e) {
            if (e.target.closest('#gatheringSealWidgetClose')) return;
            isDragging = true; hasMoved = false;
            startX = e.clientX; startY = e.clientY;
            var rect = widget.getBoundingClientRect();
            startLeft = rect.left; startTop = rect.top;
            widget.style.transition = 'none';
            widget.style.left = rect.left + 'px';
            widget.style.top  = rect.top + 'px';
            widget.style.right = 'auto'; widget.style.bottom = 'auto';
            widget.classList.add('articles-seal-widget--dragging');
            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup', stopDrag);
            e.preventDefault();
        });

        function onDrag(e) {
            if (!isDragging) return;
            var dx = e.clientX - startX, dy = e.clientY - startY;
            if (Math.abs(dx) > THRESHOLD || Math.abs(dy) > THRESHOLD) hasMoved = true;
            widget.style.left = clamp(startLeft + dx, 0, window.innerWidth - widget.offsetWidth) + 'px';
            widget.style.top  = clamp(startTop + dy, 0, window.innerHeight - widget.offsetHeight) + 'px';
        }

        function stopDrag() {
            if (!isDragging) return;
            isDragging = false;
            widget.classList.remove('articles-seal-widget--dragging');
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup', stopDrag);
            if (hasMoved) snapToGrid();
            sessionStorage.setItem('wop-gathering-pos', JSON.stringify({ left: widget.style.left, top: widget.style.top }));
        }

        function snapToGrid() {
            var wW = widget.offsetWidth, wH = widget.offsetHeight;
            var r = widget.getBoundingClientRect();
            var cx = r.left + wW / 2, cy = r.top + wH / 2;
            var vW = window.innerWidth, vH = window.innerHeight;
            var mX = Math.round(vW * 0.20), mY = Math.round(vH * 0.20);
            var col = cx < vW / 3 ? 0 : (cx < 2 * vW / 3 ? 1 : 2);
            var row = cy < vH / 3 ? 0 : (cy < 2 * vH / 3 ? 1 : 2);
            var snapX = col === 0 ? mX : col === 1 ? Math.round((vW - wW) / 2) : vW - wW - mX;
            var snapY = row === 0 ? mY : row === 1 ? Math.round((vH - wH) / 2) : vH - wH - mY;
            widget.style.transition = 'left 0.3s ease, top 0.3s ease';
            widget.style.left = snapX + 'px'; widget.style.top = snapY + 'px';
            widget.style.right = 'auto'; widget.style.bottom = 'auto';
            setTimeout(function() { widget.style.transition = ''; }, 350);
        }

        var link = widget.querySelector('.gathering-seal-widget-link');
        if (link) {
            link.addEventListener('click', function(e) {
                if (hasMoved) { e.preventDefault(); hasMoved = false; }
            });
        }
    }());
    </script>
    {% endif %}

    {% if page.url == '/articles/' %}
    <!-- =====================================================
         LIVE GATHERING BADGE  (/articles/ only)
         Floating / draggable / dismissible link to the homepage
         #gathering section. Reuses the Articles-seal styling.
         Default placement: the right gutter, just below the hero.
         Session-dismissed; own position persistence.
         ===================================================== -->
    <div id="articlesGatheringSealWidget" class="articles-seal-widget gathering-seal-widget articles-seal-widget--home" role="complementary" aria-label="The Live Gathering — weekly Christ-centered interfaith forum">
        <a href="/#gathering" class="articles-seal-widget-link gathering-seal-widget-link" title="The Live Gathering — Wednesdays 7:00 PM Mountain Time" draggable="false">
            <img src="/assets/images/chat_banner_shadow.png"
                 alt="The Live Gathering — weekly Christ-centered interfaith forum"
                 class="articles-seal-widget-img"
                 draggable="false">
        </a>
        <button class="articles-seal-widget-close" id="articlesGatheringSealWidgetClose" aria-label="Close Live Gathering badge">
            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
        <span class="articles-seal-widget-drag" aria-hidden="true">drag</span>
    </div>

    <script>
    (function() {
        'use strict';
        var widget = document.getElementById('articlesGatheringSealWidget');
        if (!widget) return;

        // Session dismissal
        if (sessionStorage.getItem('wop-aoid-gathering-dismissed') === '1') {
            widget.style.display = 'none';
            return;
        }

        function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

        // Default placement: centered in the right gutter, just below the hero.
        // If the gutter is too narrow (smaller desktops), keep the CSS default
        // (bottom-right). Touch devices use the coarse-pointer CSS rules.
        function placeDefault() {
            var w = widget.offsetWidth, h = widget.offsetHeight;
            var layout = document.querySelector('.articles-layout');
            var hero = document.querySelector('.articles-hero') || document.querySelector('.chapter-hero');
            if (!layout) return;
            var lr = layout.getBoundingClientRect();
            var gutter = window.innerWidth - lr.right;
            if (gutter < w + 24) return;   // not enough room — keep CSS default
            var left = lr.right + Math.max(12, (gutter - w) / 2);
            var top  = (hero ? hero.getBoundingClientRect().bottom : 100) + 16;
            widget.style.left = clamp(left, 12, window.innerWidth - w - 12) + 'px';
            widget.style.top  = clamp(top, 84, window.innerHeight - h - 12) + 'px';
            widget.style.right = 'auto';
            widget.style.bottom = 'auto';
        }

        var savedPos = sessionStorage.getItem('wop-aoid-gathering-pos');
        if (savedPos) {
            try {
                var pos = JSON.parse(savedPos);
                var maxLeft = window.innerWidth - widget.offsetWidth - 12;
                var maxTop  = window.innerHeight - widget.offsetHeight - 12;
                widget.style.left = clamp(parseInt(pos.left, 10), 12, maxLeft) + 'px';
                widget.style.top  = clamp(parseInt(pos.top, 10), 12, maxTop) + 'px';
                widget.style.right = 'auto';
                widget.style.bottom = 'auto';
            } catch (e) { placeDefault(); }
        } else {
            requestAnimationFrame(function() { requestAnimationFrame(placeDefault); });
        }

        // Fade in
        setTimeout(function() {
            widget.classList.add('articles-seal-widget--visible');
        }, 1500);

        // Close / dismiss
        document.getElementById('articlesGatheringSealWidgetClose').addEventListener('click', function(e) {
            e.stopPropagation(); e.preventDefault();
            widget.classList.remove('articles-seal-widget--visible');
            widget.style.transform = 'scale(0.65)';
            widget.style.pointerEvents = 'none';
            setTimeout(function() { widget.style.display = 'none'; }, 500);
            sessionStorage.setItem('wop-aoid-gathering-dismissed', '1');
        });

        // Drag — desktop (fine pointer) only
        if (window.matchMedia('(pointer: coarse)').matches) return;

        var isDragging = false, hasMoved = false, startX, startY, startLeft, startTop;
        var THRESHOLD = 6;

        widget.addEventListener('mousedown', function(e) {
            if (e.target.closest('#articlesGatheringSealWidgetClose')) return;
            isDragging = true; hasMoved = false;
            startX = e.clientX; startY = e.clientY;
            var rect = widget.getBoundingClientRect();
            startLeft = rect.left; startTop = rect.top;
            widget.style.transition = 'none';
            widget.style.left = rect.left + 'px';
            widget.style.top  = rect.top + 'px';
            widget.style.right = 'auto'; widget.style.bottom = 'auto';
            widget.classList.add('articles-seal-widget--dragging');
            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup', stopDrag);
            e.preventDefault();
        });

        function onDrag(e) {
            if (!isDragging) return;
            var dx = e.clientX - startX, dy = e.clientY - startY;
            if (Math.abs(dx) > THRESHOLD || Math.abs(dy) > THRESHOLD) hasMoved = true;
            widget.style.left = clamp(startLeft + dx, 0, window.innerWidth - widget.offsetWidth) + 'px';
            widget.style.top  = clamp(startTop + dy, 0, window.innerHeight - widget.offsetHeight) + 'px';
        }

        function stopDrag() {
            if (!isDragging) return;
            isDragging = false;
            widget.classList.remove('articles-seal-widget--dragging');
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup', stopDrag);
            if (hasMoved) snapToGrid();
            sessionStorage.setItem('wop-aoid-gathering-pos', JSON.stringify({ left: widget.style.left, top: widget.style.top }));
        }

        function snapToGrid() {
            var wW = widget.offsetWidth, wH = widget.offsetHeight;
            var r = widget.getBoundingClientRect();
            var cx = r.left + wW / 2, cy = r.top + wH / 2;
            var vW = window.innerWidth, vH = window.innerHeight;
            var mX = Math.round(vW * 0.20), mY = Math.round(vH * 0.20);
            var col = cx < vW / 3 ? 0 : (cx < 2 * vW / 3 ? 1 : 2);
            var row = cy < vH / 3 ? 0 : (cy < 2 * vH / 3 ? 1 : 2);
            var snapX = col === 0 ? mX : col === 1 ? Math.round((vW - wW) / 2) : vW - wW - mX;
            var snapY = row === 0 ? mY : row === 1 ? Math.round((vH - wH) / 2) : vH - wH - mY;
            widget.style.transition = 'left 0.3s ease, top 0.3s ease';
            widget.style.left = snapX + 'px'; widget.style.top = snapY + 'px';
            widget.style.right = 'auto'; widget.style.bottom = 'auto';
            setTimeout(function() { widget.style.transition = ''; }, 350);
        }

        var link = widget.querySelector('.gathering-seal-widget-link');
        if (link) {
            link.addEventListener('click', function(e) {
                if (hasMoved) { e.preventDefault(); hasMoved = false; }
            });
        }
    }());
    </script>
    {% endif %}

</body>
</html>
