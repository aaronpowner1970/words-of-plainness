    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="strict-origin">
    {# Safe browser storage (CODE-SITE-26, SITE step 43). First script on every page, so
       every later script can use it. When a browser blocks storage, reading
       window.localStorage or window.sessionStorage itself throws a SecurityError; these
       calls never throw. get returns null, set and remove return false, keys returns [],
       available returns false. When storage works they pass keys and values straight
       through to the browser, so what is stored is exactly what was stored before.
       kind: 'session' for sessionStorage, anything else for localStorage. #}
    <script>
    window.wopStorage = (function () {
        'use strict';
        function area(kind) {
            try { return (kind === 'session' ? window.sessionStorage : window.localStorage) || null; } catch (e) { return null; }
        }
        return {
            available: function (kind) { var s = area(kind); if (!s) return false; try { void s.length; return true; } catch (e) { return false; } },
            get: function (key, kind) { var s = area(kind); if (!s) return null; try { return s.getItem(key); } catch (e) { return null; } },
            set: function (key, value, kind) { var s = area(kind); if (!s) return false; try { s.setItem(key, value); return true; } catch (e) { return false; } },
            remove: function (key, kind) { var s = area(kind); if (!s) return false; try { s.removeItem(key); return true; } catch (e) { return false; } },
            keys: function (prefix, kind) {
                var s = area(kind), out = [];
                if (!s) return out;
                try { for (var i = 0; i < s.length; i++) { var k = s.key(i); if (k !== null && (!prefix || k.indexOf(prefix) === 0)) out.push(k); } } catch (e) { /* unreadable */ }
                return out;
            }
        };
    })();
    </script>
