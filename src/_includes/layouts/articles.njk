.pod-modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-48%);width:min(580px,92vw);max-height:88vh;overflow-y:auto;background:#2a1618;color:#f3e9e0;border:1px solid rgba(212,175,105,.35);border-radius:14px;padding:30px 26px 24px;box-shadow:0 24px 60px rgba(0,0,0,.5);opacity:0;visibility:hidden;transition:opacity .25s,transform .25s;z-index:1201;}
