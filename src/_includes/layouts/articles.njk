{% block scripts %}
<!-- Apparatus data (build-time JSON embed) -->
<script type="application/json" id="apparatusData">{{ (apparatusData if apparatusData else {}) | dump | safe }}</script>
<script src="/js/read-aloud-articles.js?v={{ site.version }}" defer></script>
<script src="/js/articles-slides-data.js?v={{ site.version }}" defer></script>
<script src="/js/articles-slides.js?v={{ site.version }}" defer></script>
<script src="/js/articles-panel.js?v={{ site.version }}" defer></script>
<script src="/js/articles-godeeper.js?v={{ site.version }}" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const progressFill = document.getElementById('readingProgressFill');
    if (progressFill) {
        window.addEventListener('scroll', function() {
            const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
            const progress = scrollHeight > 0 ? (window.scrollY / scrollHeight) * 100 : 0;
            progressFill.style.width = progress + '%';
        });
    }

    const bookmarkBtn = document.getElementById('bookmarkBtn');
    const pageId = 'articles-of-interfaith-discipleship';
    if (bookmarkBtn) {
        try {
            if (localStorage.getItem('wop-bookmark-flag-' + pageId) === 'true') {
                bookmarkBtn.classList.add('active');
            }
        } catch(e) {}
        bookmarkBtn.addEventListener('click', function() {
            let isBookmarked = false;
            try { isBookmarked = localStorage.getItem('wop-bookmark-flag-' + pageId) === 'true'; } catch(e) {}
            const nowBookmarked = !isBookmarked;
            try { localStorage.setItem('wop-bookmark-flag-' + pageId, nowBookmarked ? 'true' : 'false'); } catch(e) {}
            bookmarkBtn.classList.toggle('active', nowBookmarked);
            const toast = document.getElementById('bookmarkToast');
            if (toast) { toast.classList.remove('hidden'); setTimeout(() => toast.classList.add('hidden'), 2000); }
        });
    }

    const shareBtn = document.getElementById('shareBtn');
    if (shareBtn) {
        shareBtn.addEventListener('click', async function() {
            try {
                if (navigator.share) {
                    await navigator.share({ title: document.title, url: window.location.href });
                } else {
                    await navigator.clipboard.writeText(window.location.href);
                    const span = shareBtn.querySelector('span');
                    if (span) { const orig = span.textContent; span.textContent = 'Copied!'; setTimeout(() => { span.textContent = orig; }, 2000); }
                }
            } catch(e) {}
        });
    }

    const btnLT = document.getElementById('btnLearningTools');
    const ddTop = document.getElementById('featuresDropdown');
    if (btnLT && ddTop) {
        btnLT.addEventListener('click', function(e) { e.stopPropagation(); ddTop.classList.toggle('open'); });
        document.addEventListener('click', function() { ddTop.classList.remove('open'); });
    }

    const btnLTB = document.getElementById('btnLearningToolsBottom');
    const ddBot = document.getElementById('bottomFeaturesDropdown');
    if (btnLTB && ddBot) {
        btnLTB.addEventListener('click', function(e) { e.stopPropagation(); ddBot.classList.toggle('open'); });
        document.addEventListener('click', function() { ddBot.classList.remove('open'); });
    }

    // ── Musical Testimony modal (One Voice, One Mind) ──
    (function () {
        var mtModal = document.getElementById('mtModal');
        var mtBackdrop = document.getElementById('mtBackdrop');
        var mtAudio = document.getElementById('mtAudio');
        if (!mtModal || !mtBackdrop) return;
        function openMt(e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            mtModal.classList.add('open');
            mtBackdrop.classList.add('open');
            mtModal.setAttribute('aria-hidden', 'false');
            mtBackdrop.setAttribute('aria-hidden', 'false');
            document.getElementById('featuresDropdown')?.classList.remove('open');
            document.getElementById('bottomFeaturesDropdown')?.classList.remove('open');
        }
        function closeMt() {
            mtModal.classList.remove('open');
            mtBackdrop.classList.remove('open');
            mtModal.setAttribute('aria-hidden', 'true');
            mtBackdrop.setAttribute('aria-hidden', 'true');
            if (mtAudio) { mtAudio.pause(); }
        }
        document.getElementById('btnMusicalTestimony')?.addEventListener('click', openMt);
        document.getElementById('btnMusicalTestimonyBottom')?.addEventListener('click', openMt);
        document.getElementById('mtClose')?.addEventListener('click', closeMt);
        mtBackdrop.addEventListener('click', closeMt);
        document.addEventListener('keydown', function (e) {
            if ((e.key === 'Escape' || e.key === 'Esc') && mtModal.classList.contains('open')) closeMt();
        });
    })();

    // ── Visual Summary modal (Articles infographic, lazy-loaded) ──
    (function () {
        var vsModal = document.getElementById('vsModal');
        var vsBackdrop = document.getElementById('vsBackdrop');
        var vsImg = document.getElementById('vsImg');
        if (!vsModal || !vsBackdrop) return;
        var loaded = false;
        function openVs(e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            if (!loaded && vsImg && vsImg.dataset.src) { vsImg.src = vsImg.dataset.src; loaded = true; }
            vsModal.classList.add('open');
            vsBackdrop.classList.add('open');
            vsModal.setAttribute('aria-hidden', 'false');
            vsBackdrop.setAttribute('aria-hidden', 'false');
            document.getElementById('featuresDropdown')?.classList.remove('open');
            document.getElementById('bottomFeaturesDropdown')?.classList.remove('open');
        }
        function closeVs() {
            vsModal.classList.remove('open');
            vsBackdrop.classList.remove('open');
            vsModal.setAttribute('aria-hidden', 'true');
            vsBackdrop.setAttribute('aria-hidden', 'true');
        }
        document.getElementById('btnVisualSummary')?.addEventListener('click', openVs);
        document.getElementById('btnVisualSummaryBottom')?.addEventListener('click', openVs);
        document.getElementById('vsClose')?.addEventListener('click', closeVs);
        vsBackdrop.addEventListener('click', closeVs);
        document.addEventListener('keydown', function (e) {
            if ((e.key === 'Escape' || e.key === 'Esc') && vsModal.classList.contains('open')) closeVs();
        });
    })();

    // ── Articles Podcast modal (3-episode dramatized series) ──
    (function () {
        var podModal = document.getElementById('podModal');
        var podBackdrop = document.getElementById('podBackdrop');
        var podAudio = document.getElementById('podAudio');
        var podNowTitle = document.getElementById('podNowTitle');
        if (!podModal || !podBackdrop) return;
        function openPod(e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            podModal.classList.add('open');
            podBackdrop.classList.add('open');
            podModal.setAttribute('aria-hidden', 'false');
            podBackdrop.setAttribute('aria-hidden', 'false');
            document.getElementById('featuresDropdown')?.classList.remove('open');
            document.getElementById('bottomFeaturesDropdown')?.classList.remove('open');
        }
        function closePod() {
            podModal.classList.remove('open');
            podBackdrop.classList.remove('open');
            podModal.setAttribute('aria-hidden', 'true');
            podBackdrop.setAttribute('aria-hidden', 'true');
            if (podAudio) { podAudio.pause(); }
        }
        document.getElementById('btnArticlesPodcast')?.addEventListener('click', openPod);
        document.getElementById('btnArticlesPodcastBottom')?.addEventListener('click', openPod);
        document.getElementById('podClose')?.addEventListener('click', closePod);
        podBackdrop.addEventListener('click', closePod);
        document.addEventListener('keydown', function (e) {
            if ((e.key === 'Escape' || e.key === 'Esc') && podModal.classList.contains('open')) closePod();
        });
        podModal.querySelectorAll('.pod-ep').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var src = btn.getAttribute('data-pod-src');
                var title = btn.getAttribute('data-pod-title');
                if (!src || !podAudio) return;
                if (podAudio.getAttribute('src') !== src) {
                    podAudio.setAttribute('src', src);
                    podAudio.load();
                    if (podNowTitle) podNowTitle.textContent = title || '';
                }
                podModal.querySelectorAll('.pod-ep').forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                podAudio.play().catch(function () {});
            });
        });
    })();

    const backToTop = document.getElementById('backToTop');
    if (backToTop) {
        window.addEventListener('scroll', function() { backToTop.classList.toggle('visible', window.scrollY > 400); });
        backToTop.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });
    }

    document.getElementById('fontDecrease')?.addEventListener('click', () => window.WopFontSize?.decrease());
    document.getElementById('fontReset')?.addEventListener('click',    () => window.WopFontSize?.reset());
    document.getElementById('fontIncrease')?.addEventListener('click', () => window.WopFontSize?.increase());

    // ── R·J·W reflection persistence (Articles) ──────────────────────
    // localStorage key  wop-rjw-{pauseId}::reflect  + POST /progress/pause-responses/
    // for signed-in readers (chapter_slug "articles-of-interfaith-discipleship").
    // The "aoid-" pauseId namespace buckets these under the Articles card in the
    // journal and is skipped by the chapter R·J·W flush. A status line confirms
    // saves and, for guests, invites sign-in (device-local until then).
    (function () {
        var ARTICLES_SLUG = 'articles-of-interfaith-discipleship';

        function pauseIdFor(ta) {
            var articleId = (ta.dataset.rjwKey || '').replace(/^rjw-/, '');
            return articleId ? 'aoid-' + articleId : null;
        }
        function storageKey(pauseId) { return 'wop-rjw-' + pauseId + '::reflect'; }

        function syncToApi(pauseId, value) {
            if (!window.API || !API.isAuthenticated()) return Promise.resolve('local');
            if (!value || !value.trim()) return Promise.resolve('empty');
            return API.savePauseResponse({
                pause_id: pauseId, chapter_slug: ARTICLES_SLUG,
                tab_type: 'reflect', response_text: value, include_in_document: false
            }).then(function () { return 'synced'; });
        }

        function setStatus(el, state) {
            if (!el) return;
            el.className = 'rjw-status rjw-status--' + state;
            if (state === 'saving')      el.innerHTML = 'Saving…';
            else if (state === 'synced') el.innerHTML = 'Saved to your journal ✓';
            else if (state === 'local')  el.innerHTML = 'Saved on this device — <button type="button" class="rjw-signin-link">sign in</button> to keep it in your journal';
            else if (state === 'error')  el.innerHTML = 'Saved on this device · will sync to your journal when reconnected';
            else                         el.innerHTML = '';
        }

        var textareas = document.querySelectorAll('.rjw-textarea');

        textareas.forEach(function (ta) {
            var pauseId = pauseIdFor(ta);
            if (!pauseId) return;
            var key = storageKey(pauseId);

            var statusEl = document.createElement('p');
            statusEl.className = 'rjw-status';
            statusEl.setAttribute('aria-live', 'polite');
            ta.insertAdjacentElement('afterend', statusEl);
            statusEl.addEventListener('click', function (e) {
                if (!e.target.closest('.rjw-signin-link')) return;
                var modal = document.getElementById('authModal');
                if (modal) modal.style.display = 'flex';
            });

            // One-time migration from the pre-fix scheme (wop-rjw-A01, no ::reflect)
            try {
                if (!localStorage.getItem(key)) {
                    var legacyKey = 'wop-rjw-' + (ta.dataset.rjwKey || '').replace(/^rjw-/, '');
                    var legacyVal = localStorage.getItem(legacyKey);
                    if (legacyVal && legacyVal.trim()) {
                        localStorage.setItem(key, legacyVal);
                        localStorage.removeItem(legacyKey);
                    }
                }
            } catch (e) {}

            try { ta.value = localStorage.getItem(key) || ''; } catch (e) {}

            var timer;
            ta.addEventListener('input', function () {
                clearTimeout(timer);
                if (window.API && API.isAuthenticated()) setStatus(statusEl, 'saving');
                timer = setTimeout(function () {
                    try { localStorage.setItem(key, ta.value); } catch (e) {}
                    if (!ta.value.trim()) { setStatus(statusEl, ''); return; }
                    syncToApi(pauseId, ta.value)
                        .then(function (r) { setStatus(statusEl, r === 'synced' ? 'synced' : 'local'); })
                        .catch(function () { setStatus(statusEl, 'error'); });
                }, 600);
            });
        });

        // Guest signs in while on this page → push entries up and confirm.
        document.addEventListener('wop:auth-login', function () {
            textareas.forEach(function (ta) {
                var pauseId = pauseIdFor(ta);
                if (!pauseId) return;
                var statusEl = ta.nextElementSibling;
                var val = '';
                try { val = localStorage.getItem(storageKey(pauseId)) || ''; } catch (e) {}
                if (!val.trim()) return;
                syncToApi(pauseId, val).then(function () {
                    if (statusEl && statusEl.classList.contains('rjw-status')) setStatus(statusEl, 'synced');
                });
            });
        });
    })();

    const fab = document.getElementById('floatingActionBar');
    if (fab) {
        let lastScroll = 0;
        window.addEventListener('scroll', function() {
            const current = window.scrollY;
            fab.classList.toggle('hidden', current > lastScroll && current > 200);
            lastScroll = current;
        }, { passive: true });
    }

    // ── Keep the floating reader toolbar clear of the Pathways band ──
    (function () {
        var toolbar = document.getElementById('bottomToolbar');
        var band = document.querySelector('.pw-band');
        if (!toolbar || !band || !('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
            toolbar.classList.toggle('tb-stowed', entries[0].isIntersecting);
        }, { threshold: 0 });
        io.observe(band);
    })();

    // ── Of Common Ground panels (opened from the contents drawer) ──
    (function () {
        var backdrop = document.getElementById('ocgBackdrop');
        var panels = Array.prototype.slice.call(document.querySelectorAll('.ocg-panel'));
        if (!backdrop || !panels.length) return;

        function closeAll() {
            panels.forEach(function (p) {
                p.classList.remove('ocg-open');
                p.setAttribute('aria-hidden', 'true');
            });
            backdrop.classList.remove('ocg-open');
            backdrop.setAttribute('aria-hidden', 'true');
        }

        function open(id) {
            var panel = document.getElementById(id);
            if (!panel) return;
            closeAll();
            panel.classList.add('ocg-open');
            panel.setAttribute('aria-hidden', 'false');
            backdrop.classList.add('ocg-open');
            backdrop.setAttribute('aria-hidden', 'false');
            panel.focus({ preventScroll: true });
        }

        panels.forEach(function (p) {
            p.querySelectorAll('[data-ocg-close]').forEach(function (btn) {
                btn.addEventListener('click', closeAll);
            });
        });
        backdrop.addEventListener('click', closeAll);
        document.addEventListener('keydown', function (e) {
            if ((e.key === 'Escape' || e.key === 'Esc') &&
                panels.some(function (p) { return p.classList.contains('ocg-open'); })) {
                closeAll();
            }
        });

        window.WopOcgPanels = { open: open, closeAll: closeAll };
    })();

    // ── Articles Navigation Drawer ──────────────────────────────────
    (function () {
        var anTab    = document.getElementById('anTab');
        var anDrawer = document.getElementById('anDrawer');
        var anClose  = document.getElementById('anClose');
        if (!anTab || !anDrawer) return;

        var drawerOpen = false;

        function openDrawer() {
            drawerOpen = true;
            anDrawer.classList.add('an-open');
            anDrawer.setAttribute('aria-hidden', 'false');
            anTab.classList.add('an-is-open');
            anTab.setAttribute('aria-expanded', 'true');
        }

        function closeDrawer() {
            drawerOpen = false;
            anDrawer.classList.remove('an-open');
            anDrawer.setAttribute('aria-hidden', 'true');
            anTab.classList.remove('an-is-open');
            anTab.setAttribute('aria-expanded', 'false');
        }

        // Tab toggles drawer
        anTab.addEventListener('click', function (e) {
            e.stopPropagation();
            drawerOpen ? closeDrawer() : openDrawer();
        });

        // Close button
        if (anClose) {
            anClose.addEventListener('click', function (e) {
                e.stopPropagation();
                closeDrawer();
            });
        }

        // Click outside closes drawer
        document.addEventListener('click', function (e) {
            if (!drawerOpen) return;
            if (anDrawer.contains(e.target)) return;
            if (anTab.contains(e.target)) return;
            closeDrawer();
        });

        // Escape key
        document.addEventListener('keydown', function (e) {
            if ((e.key === 'Escape' || e.key === 'Esc') && drawerOpen) {
                closeDrawer();
                anTab.focus();
            }
        });

        // "Of Common Ground" entries open their panel and close the drawer
        anDrawer.querySelectorAll('[data-ocg-open]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                closeDrawer();
                if (window.WopOcgPanels) window.WopOcgPanels.open(btn.getAttribute('data-ocg-open'));
            });
        });

        // Smooth scroll on nav link click
        anDrawer.querySelectorAll('.an-link').forEach(function (link) {
            link.addEventListener('click', function (e) {
                var href = link.getAttribute('href');
                if (!href || href.charAt(0) !== '#') { return; }   // panel buttons / external companion links handled elsewhere
                e.preventDefault();
                var targetId = href.slice(1);
                var targetEl = document.getElementById(targetId);
                if (targetEl) {
                    targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
                closeDrawer();
            });
        });

        // IntersectionObserver: highlight active article in the drawer list
        var sections = document.querySelectorAll('.article-section');
        var navLinks = anDrawer.querySelectorAll('.an-link');

        if (sections.length && 'IntersectionObserver' in window) {
            var anObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    var id = entry.target.id;
                    navLinks.forEach(function (l) {
                        l.classList.toggle('an-active', l.getAttribute('href') === '#' + id);
                    });
                });
            }, { rootMargin: '-15% 0px -65% 0px', threshold: 0 });

            sections.forEach(function (s) { anObserver.observe(s); });
        }
    })();
});
</script>

{% endblock %}
