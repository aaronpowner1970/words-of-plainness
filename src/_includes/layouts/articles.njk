{% include "components/fab-lantern.njk" %}
</div>

<!-- Annotation Panel -->
<div class="ap-backdrop" id="apBackdrop" aria-hidden="true"></div>
<aside class="ap-panel" id="apPanel" role="complementary" aria-label="Span annotation" aria-hidden="true">
    <header class="ap-header">
        <div class="ap-header-left">
            <span class="ap-type-badge" id="apTypeBadge"></span>
            <span class="ap-article-label" id="apArticleLabel"></span>
        </div>
        <button class="ap-close" id="apClose" aria-label="Close annotation panel" type="button">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </header>
    <div class="ap-body" id="apBody">
        <!-- Quoted span text -->
        <div class="ap-span-text" id="apSpanText"></div>
        <!-- Named-concept definition -->
        <div class="ap-definition-block ap-hidden" id="apDefinitionBlock">
            <h4 class="ap-section-title">Definition</h4>
            <p class="ap-definition" id="apDefinition"></p>
        </div>
        <!-- Panel commentary -->
        <div class="ap-comment-block ap-hidden" id="apCommentBlock">
            <h4 class="ap-section-title">Commentary</h4>
            <p class="ap-comment" id="apComment"></p>
        </div>
        <!-- Anchor tabs (Biblical / Restoration) -->
        <div class="ap-anchor-tabs-block ap-hidden" id="apAnchorTabsBlock">
            <div class="ap-anchor-tab-bar" role="tablist">
                <button class="ap-anchor-tab ap-anchor-tab--active" id="apTabBiblical"
                        role="tab" aria-selected="true" aria-controls="apBiblicalPane"
                        data-pane="apBiblicalPane">Biblical Witness</button>
                <button class="ap-anchor-tab" id="apTabRestoration"
                        role="tab" aria-selected="false" aria-controls="apRestorationPane"
                        data-pane="apRestorationPane">Restoration Witness</button>
            </div>
            <div class="ap-anchor-pane" id="apBiblicalPane" role="tabpanel" aria-labelledby="apTabBiblical">
                <ul class="ap-anchor-list" id="apBiblicalList"></ul>
                <p class="ap-anchor-pane-empty ap-hidden" id="apBiblicalEmpty">No biblical anchors for this span.</p>
            </div>
            <div class="ap-anchor-pane ap-hidden" id="apRestorationPane" role="tabpanel" aria-labelledby="apTabRestoration">
                <ul class="ap-anchor-list" id="apRestorationList"></ul>
                <p class="ap-anchor-pane-empty ap-hidden" id="apRestorationEmpty">No Restoration anchors for this span.</p>
            </div>
        </div>
        <!-- Cross-references -->
        <div class="ap-crossref-block ap-hidden" id="apCrossrefBlock">
            <h4 class="ap-section-title">See Also</h4>
            <ul class="ap-crossref-list" id="apCrossrefList"></ul>
        </div>
    </div>
</aside>

