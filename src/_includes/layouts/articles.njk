                <span>Musical Testimony</span>
            </button>
            <button class="dropdown-item" id="btnVisualSummaryBottom" type="button">
                <svg viewBox="0 0 24 24" width="18" height="18"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><polyline points="21 15 16 10 5 21" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                <span>Visual Summary</span>
            </button>
            <button class="dropdown-item articles-placeholder" disabled aria-disabled="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><line x1="8" y1="21" x2="16" y2="21" stroke="currentColor" stroke-width="2"/><line x1="12" y1="17" x2="12" y2="21" stroke="currentColor" stroke-width="2"/></svg>
                <span>Study Slides</span>
                <span class="placeholder-badge">Coming soon</span>
            </button>
            <button class="dropdown-item articles-placeholder" disabled aria-disabled="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 20h9" stroke="currentColor" stroke-width="2" fill="none"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                <span>Personal Reflection</span>
                <span class="placeholder-badge">Coming soon</span>
            </button>
            <hr class="dropdown-divider">
            <a class="dropdown-item" href="https://media.wordsofplainness.org/web/Articles_of_Interfaith_Discipleship.pdf" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke="currentColor" stroke-width="2" fill="none"/><polyline points="7 10 12 15 17 10" stroke="currentColor" stroke-width="2" fill="none"/><line x1="12" y1="15" x2="12" y2="3" stroke="currentColor" stroke-width="2"/></svg>
                <span>Download PDF</span>
            </a>
            <hr class="dropdown-divider">
            <a class="dropdown-item" href="/search/">
                <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2" fill="none"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2"/></svg>
                <span>Search All Chapters</span>
            </a>
            <a class="dropdown-item" href="/how-to-use/">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>How to Use This Website</span>
            </a>
        </div>
    </div>
</section>

<div data-pagefind-ignore>
{% include "components/discord-section.njk" %}
{% include "components/bottom-toolbar.njk" %}
{% include "components/back-to-top.njk" %}
{% include "components/fab-lantern.njk" %}
</div>

<!-- Articles Navigation Drawer -->
<button class="an-tab" id="anTab"
        aria-label="Open articles navigation"
        aria-expanded="false"
        aria-controls="anDrawer"
        type="button">
    <span class="an-tab-label">13 Articles</span>
    <svg class="an-tab-chevron" viewBox="0 0 24 24" width="11" height="11"
         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
</button>

<aside class="an-drawer" id="anDrawer"
       role="navigation"
       aria-label="Articles navigation"
       aria-hidden="true">
    <div class="an-drawer-header">
        <span class="an-drawer-title">Thirteen Articles</span>
        <button class="an-drawer-close" id="anClose"
                aria-label="Close navigation" type="button">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    </div>
    <nav class="an-drawer-nav" aria-label="Jump to article">
        <ol class="an-drawer-list">
            <li><a href="#of-plainness"              class="an-link"><span class="an-num">1</span>Of Plainness</a></li>
            <li><a href="#of-god"                    class="an-link"><span class="an-num">2</span>Of God</a></li>
            <li><a href="#of-creation-and-life"      class="an-link"><span class="an-num">3</span>Of Creation and Life</a></li>
            <li><a href="#of-gods-word"              class="an-link"><span class="an-num">4</span>Of God’s Word</a></li>
            <li><a href="#of-jesus-christ"           class="an-link"><span class="an-num">5</span>Of Jesus Christ</a></li>
            <li><a href="#of-salvation"              class="an-link"><span class="an-num">6</span>Of Salvation</a></li>
            <li><a href="#of-the-kingdom-at-hand"    class="an-link"><span class="an-num">7</span>Of the Kingdom at Hand</a></li>
            <li><a href="#of-fellow-believers"       class="an-link"><span class="an-num">8</span>Of Fellow Believers</a></li>
            <li><a href="#of-finding-our-way"        class="an-link"><span class="an-num">9</span>Of Finding Our Way</a></li>
            <li><a href="#of-living-by-grace"        class="an-link"><span class="an-num">10</span>Of Living by Grace</a></li>
            <li><a href="#of-covenants-and-commitments"    class="an-link"><span class="an-num">11</span>Of Covenants and Commitments</a></li>
            <li><a href="#of-immortality-and-eternal-life" class="an-link"><span class="an-num">12</span>Of Immortality and Eternal Life</a></li>
            <li><a href="#of-our-confidence"         class="an-link"><span class="an-num">13</span>Of Our Confidence</a></li>
        </ol>

        <div class="an-companions">
            <p class="an-companions-heading">Companion Essays</p>
            <ul class="an-drawer-list an-companions-list">
                <li><a href="https://www.wordsofplainness.org/studies/merognosticism/" class="an-link an-companion-link" target="_blank" rel="noopener"><span class="an-num">†</span>Merognosticism</a></li>
                <li><a href="https://www.wordsofplainness.org/studies/broken-vessels/" class="an-link an-companion-link" target="_blank" rel="noopener"><span class="an-num">†</span>Broken Vessels</a></li>
                <li><a href="https://www.wordsofplainness.org/studies/contention-and-the-reach-of-christ/" class="an-link an-companion-link" target="_blank" rel="noopener"><span class="an-num">†</span>Contention &amp; the Reach of Christ</a></li>
                <li><a href="https://www.wordsofplainness.org/studies/lord-is-it-i/" class="an-link an-companion-link" target="_blank" rel="noopener"><span class="an-num">†</span>Lord, Is It I?</a></li>
            </ul>
        </div>
    </nav>
</aside>

<!-- Annotation Panel -->
<div class="ap-backdrop" id="apBackdrop" aria-hidden="true"></div>
<aside class="ap-panel" id="apPanel" role="complementary" aria-label="Span annotation" aria-hidden="true">
    <header class="ap-header">
        <div class="ap-header-left">
            <span class="ap-type-badge" id="apTypeBadge"></span>
            <span class="ap-article-label" id="apArticleLabel"></span>
        </div>
        <button class="ap-close" id="apClose" aria-label="Close annotation panel" type="button">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </header>
    <div class="ap-body" id="apBody">
        <!-- Quoted span text -->
        <div class="ap-span-text" id="apSpanText"></div>
        <!-- Named-concept definition -->
        <div class="ap-definition-block ap-hidden" id="apDefinitionBlock">
            <h4 class="ap-section-title">Definition</h4>
            <p class="ap-definition" id="apDefinition"></p>
        </div>
        <!-- Panel commentary -->
        <div class="ap-comment-block ap-hidden" id="apCommentBlock">
            <h4 class="ap-section-title">Commentary</h4>
            <p class="ap-comment" id="apComment"></p>
        </div>
        <!-- Anchor tabs (Biblical / Restoration) -->
        <div class="ap-anchor-tabs-block ap-hidden" id="apAnchorTabsBlock">
            <div class="ap-anchor-tab-bar" role="tablist">
                <button class="ap-anchor-tab ap-anchor-tab--active" id="apTabBiblical"
                        role="tab" aria-selected="true" aria-controls="apBiblicalPane"
                        data-pane="apBiblicalPane">Biblical Witness</button>
                <button class="ap-anchor-tab" id="apTabRestoration"
                        role="tab" aria-selected="false" aria-controls="apRestorationPane"
                        data-pane="apRestorationPane">Restoration Witness</button>
            </div>
            <div class="ap-anchor-pane" id="apBiblicalPane" role="tabpanel" aria-labelledby="apTabBiblical">
                <ul class="ap-anchor-list" id="apBiblicalList"></ul>
                <p class="ap-anchor-pane-empty ap-hidden" id="apBiblicalEmpty">No biblical anchors for this span.</p>
            </div>
            <div class="ap-anchor-pane ap-hidden" id="apRestorationPane" role="tabpanel" aria-labelledby="apTabRestoration">
                <ul class="ap-anchor-list" id="apRestorationList"></ul>
                <p class="ap-anchor-pane-empty ap-hidden" id="apRestorationEmpty">No Restoration anchors for this span.</p>
            </div>
        </div>
        <!-- Cross-references -->
        <div class="ap-crossref-block ap-hidden" id="apCrossrefBlock">
            <h4 class="ap-section-title">See Also</h4>
            <ul class="ap-crossref-list" id="apCrossrefList"></ul>
        </div>
    </div>
</aside>

<!-- Musical Testimony Modal (One Voice, One Mind) -->
<style>
.mt-backdrop{position:fixed;inset:0;background:rgba(20,10,12,.62);opacity:0;visibility:hidden;transition:opacity .25s;z-index:1200;}
.mt-backdrop.open{opacity:1;visibility:visible;}
.mt-modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-48%);width:min(560px,92vw);max-height:86vh;overflow-y:auto;background:#2a1618;color:#f3e9e0;border:1px solid rgba(212,175,105,.35);border-radius:14px;padding:30px 26px 24px;box-shadow:0 24px 60px rgba(0,0,0,.5);opacity:0;visibility:hidden;transition:opacity .25s,transform .25s;z-index:1201;}
.mt-modal.open{opacity:1;visibility:visible;transform:translate(-50%,-50%);}
.mt-close{position:absolute;top:12px;right:14px;background:none;border:none;color:#d9c4b0;font-size:20px;line-height:1;cursor:pointer;}
.mt-close:hover{color:#fff;}
.mt-eyebrow{margin:0 0 4px;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#d4af69;}
.mt-title{margin:0 0 2px;font-family:'Cinzel',serif;font-size:1.5rem;color:#fff;}
.mt-label{margin:0 0 16px;font-size:.85rem;color:#c8b3a3;font-style:italic;}
.mt-audio{width:100%;margin:0 0 4px;}
.mt-lyrics{border-top:1px solid rgba(212,175,105,.25);margin-top:14px;}
.mt-lyrics>summary{cursor:pointer;font-size:.9rem;color:#d4af69;list-style:none;padding:10px 0 6px;}
.mt-lyrics>summary::-webkit-details-marker{display:none;}
.mt-lyrics-body{font-size:.92rem;line-height:1.5;color:#ecdfd4;max-height:42vh;overflow-y:auto;padding:4px 2px 6px;}
.mt-lyrics-body .section{margin:14px 0 4px;color:#d4af69;font-size:.8rem;letter-spacing:.04em;}
.mt-lyrics-body .verse,.mt-lyrics-body .chorus{margin:0 0 8px;}
.mt-lyrics-body .chorus{padding-left:12px;border-left:2px solid rgba(212,175,105,.4);font-style:italic;}
.mt-music-link{display:inline-block;margin-top:12px;color:#d4af69;text-decoration:none;font-size:.88rem;}
.mt-music-link:hover{text-decoration:underline;}
</style>
<div class="mt-backdrop" id="mtBackdrop" aria-hidden="true"></div>
<div class="mt-modal" id="mtModal" role="dialog" aria-modal="true" aria-labelledby="mtTitle" aria-hidden="true">
    <button class="mt-close" id="mtClose" aria-label="Close musical testimony" type="button">&#10005;</button>
    <p class="mt-eyebrow">Musical Testimony</p>
    <h2 class="mt-title" id="mtTitle">One Voice, One Mind</h2>
    <p class="mt-label">Interfaith Anthem &middot; Cinematic Inspirational</p>
    <audio class="mt-audio" id="mtAudio" controls preload="none" src="https://media.wordsofplainness.org/web/AN_01_One_Voice_One_Mind_Cinematic_Inspirational.mp3"></audio>
    <details class="mt-lyrics">
        <summary>Lyrics</summary>
        <div class="mt-lyrics-body">
            {%- for item in ministryMusic.collection -%}
            {%- if item.file == "AN_01_One_Voice_One_Mind_Cinematic_Inspirational.mp3" -%}
            {{ item.lyrics | safe }}
            {%- endif -%}
            {%- endfor -%}
        </div>
    </details>
    <a class="mt-music-link" href="/music/">More music &rarr;</a>
</div>

<!-- Visual Summary Modal (Articles infographic) -->
<style>
.vs-backdrop{position:fixed;inset:0;background:rgba(20,10,12,.72);opacity:0;visibility:hidden;transition:opacity .25s;z-index:1200;}
.vs-backdrop.open{opacity:1;visibility:visible;}
.vs-modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-48%);width:min(760px,94vw);max-height:90vh;overflow-y:auto;background:#2a1618;color:#f3e9e0;border:1px solid rgba(212,175,105,.35);border-radius:14px;padding:26px 22px 20px;box-shadow:0 24px 60px rgba(0,0,0,.5);opacity:0;visibility:hidden;transition:opacity .25s,transform .25s;z-index:1201;}
.vs-modal.open{opacity:1;visibility:visible;transform:translate(-50%,-50%);}
.vs-close{position:absolute;top:12px;right:14px;background:none;border:none;color:#d9c4b0;font-size:20px;line-height:1;cursor:pointer;}
.vs-close:hover{color:#fff;}
.vs-eyebrow{margin:0 0 4px;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#d4af69;}
.vs-title{margin:0 0 14px;font-family:'Cinzel',serif;font-size:1.5rem;color:#fff;}
.vs-figure{margin:0;}
.vs-img{width:100%;height:auto;border-radius:8px;display:block;background:rgba(0,0,0,.2);min-height:120px;}
.vs-fulllink{display:inline-block;margin-top:12px;color:#d4af69;text-decoration:none;font-size:.88rem;}
.vs-fulllink:hover{text-decoration:underline;}
</style>
<div class="vs-backdrop" id="vsBackdrop" aria-hidden="true"></div>
<div class="vs-modal" id="vsModal" role="dialog" aria-modal="true" aria-labelledby="vsTitle" aria-hidden="true">
    <button class="vs-close" id="vsClose" aria-label="Close visual summary" type="button">&#10005;</button>
    <p class="vs-eyebrow">Visual Summary</p>
    <h2 class="vs-title" id="vsTitle">The Thirteen Articles at a Glance</h2>
    <figure class="vs-figure">
        <img class="vs-img" id="vsImg" alt="Infographic summarizing the Articles of Interfaith Discipleship"
             data-src="https://media.wordsofplainness.org/web/Articles_of_Interfaith_Discipleship_Infographic.png">
    </figure>
    <a class="vs-fulllink" id="vsFullLink" href="https://media.wordsofplainness.org/web/Articles_of_Interfaith_Discipleship_Infographic.png" target="_blank" rel="noopener">Open full resolution &#8599;</a>
</div>

{% endblock %}

{% block scripts %}
<!-- Apparatus data (build-time JSON embed) -->
<script type="application/json" id="apparatusData">{{ (apparatusData if apparatusData else {}) | dump | safe }}</script>
<script src="/js/read-aloud-articles.js" defer></script>
<script src="/js/articles-panel.js" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const progressFill = document.getElementById('readingProgressFill');
    if (progressFill) {
        window.addEventListener('scroll', function() {
            const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
            const progress = scrollHeight > 0 ? (window.scrollY / scrollHeight) * 100 : 0;
            progressFill.style.width = progress + '%';
        });
    }

    const bookmarkBtn = document.getElementById('bookmarkBtn');
    const pageId = 'articles-of-interfaith-discipleship';
    if (bookmarkBtn) {
        try {
            if (localStorage.getItem('wop-bookmark-flag-' + pageId) === 'true') {
                bookmarkBtn.classList.add('active');
            }
        } catch(e) {}
        bookmarkBtn.addEventListener('click', function() {
            let isBookmarked = false;
            try { isBookmarked = localStorage.getItem('wop-bookmark-flag-' + pageId) === 'true'; } catch(e) {}
            const nowBookmarked = !isBookmarked;
            try { localStorage.setItem('wop-bookmark-flag-' + pageId, nowBookmarked ? 'true' : 'false'); } catch(e) {}
            bookmarkBtn.classList.toggle('active', nowBookmarked);
            const toast = document.getElementById('bookmarkToast');
            if (toast) { toast.classList.remove('hidden'); setTimeout(() => toast.classList.add('hidden'), 2000); }
        });
    }

    const shareBtn = document.getElementById('shareBtn');
    if (shareBtn) {
        shareBtn.addEventListener('click', async function() {
            try {
                if (navigator.share) {
                    await navigator.share({ title: document.title, url: window.location.href });
                } else {
                    await navigator.clipboard.writeText(window.location.href);
                    const span = shareBtn.querySelector('span');
                    if (span) { const orig = span.textContent; span.textContent = 'Copied!'; setTimeout(() => { span.textContent = orig; }, 2000); }
                }
            } catch(e) {}
        });
    }

    const btnLT = document.getElementById('btnLearningTools');
    const ddTop = document.getElementById('featuresDropdown');
    if (btnLT && ddTop) {
        btnLT.addEventListener('click', function(e) { e.stopPropagation(); ddTop.classList.toggle('open'); });
        document.addEventListener('click', function() { ddTop.classList.remove('open'); });
    }

    const btnLTB = document.getElementById('btnLearningToolsBottom');
    const ddBot = document.getElementById('bottomFeaturesDropdown');
    if (btnLTB && ddBot) {
        btnLTB.addEventListener('click', function(e) { e.stopPropagation(); ddBot.classList.toggle('open'); });
        document.addEventListener('click', function() { ddBot.classList.remove('open'); });
    }

    // ── Musical Testimony modal (One Voice, One Mind) ──
    (function () {
        var mtModal = document.getElementById('mtModal');
        var mtBackdrop = document.getElementById('mtBackdrop');
        var mtAudio = document.getElementById('mtAudio');
        if (!mtModal || !mtBackdrop) return;
        function openMt(e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            mtModal.classList.add('open');
            mtBackdrop.classList.add('open');
            mtModal.setAttribute('aria-hidden', 'false');
            mtBackdrop.setAttribute('aria-hidden', 'false');
            document.getElementById('featuresDropdown')?.classList.remove('open');
            document.getElementById('bottomFeaturesDropdown')?.classList.remove('open');
        }
        function closeMt() {
            mtModal.classList.remove('open');
            mtBackdrop.classList.remove('open');
            mtModal.setAttribute('aria-hidden', 'true');
            mtBackdrop.setAttribute('aria-hidden', 'true');
            if (mtAudio) { mtAudio.pause(); }
        }
        document.getElementById('btnMusicalTestimony')?.addEventListener('click', openMt);
        document.getElementById('btnMusicalTestimonyBottom')?.addEventListener('click', openMt);
        document.getElementById('mtClose')?.addEventListener('click', closeMt);
        mtBackdrop.addEventListener('click', closeMt);
        document.addEventListener('keydown', function (e) {
            if ((e.key === 'Escape' || e.key === 'Esc') && mtModal.classList.contains('open')) closeMt();
        });
    })();

    // ── Visual Summary modal (Articles infographic, lazy-loaded) ──
    (function () {
        var vsModal = document.getElementById('vsModal');
        var vsBackdrop = document.getElementById('vsBackdrop');
        var vsImg = document.getElementById('vsImg');
        if (!vsModal || !vsBackdrop) return;
        var loaded = false;
        function openVs(e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            if (!loaded && vsImg && vsImg.dataset.src) { vsImg.src = vsImg.dataset.src; loaded = true; }
            vsModal.classList.add('open');
            vsBackdrop.classList.add('open');
            vsModal.setAttribute('aria-hidden', 'false');
            vsBackdrop.setAttribute('aria-hidden', 'false');
            document.getElementById('featuresDropdown')?.classList.remove('open');
            document.getElementById('bottomFeaturesDropdown')?.classList.remove('open');
        }
        function closeVs() {
            vsModal.classList.remove('open');
            vsBackdrop.classList.remove('open');
            vsModal.setAttribute('aria-hidden', 'true');
            vsBackdrop.setAttribute('aria-hidden', 'true');
        }
        document.getElementById('btnVisualSummary')?.addEventListener('click', openVs);
        document.getElementById('btnVisualSummaryBottom')?.addEventListener('click', openVs);
        document.getElementById('vsClose')?.addEventListener('click', closeVs);
        vsBackdrop.addEventListener('click', closeVs);
        document.addEventListener('keydown', function (e) {
            if ((e.key === 'Escape' || e.key === 'Esc') && vsModal.classList.contains('open')) closeVs();
        });
    })();

    const backToTop = document.getElementById('backToTop');
    if (backToTop) {
        window.addEventListener('scroll', function() { backToTop.classList.toggle('visible', window.scrollY > 400); });
        backToTop.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });
    }

    document.getElementById('fontDecrease')?.addEventListener('click', () => window.WopFontSize?.decrease());
    document.getElementById('fontReset')?.addEventListener('click',    () => window.WopFontSize?.reset());
    document.getElementById('fontIncrease')?.addEventListener('click', () => window.WopFontSize?.increase());

    // RJW reflection persistence
    document.querySelectorAll('.rjw-textarea').forEach(function(ta) {
        var key = ta.dataset.rjwKey;
        if (!key) return;
        try { ta.value = localStorage.getItem('wop-' + key) || ''; } catch(e) {}
        var timer;
        ta.addEventListener('input', function() {
            clearTimeout(timer);
            timer = setTimeout(function() {
                try { localStorage.setItem('wop-' + key, ta.value); } catch(e) {}
            }, 400);
        });
    });

    const fab = document.getElementById('floatingActionBar');
    if (fab) {
        let lastScroll = 0;
        window.addEventListener('scroll', function() {
            const current = window.scrollY;
            fab.classList.toggle('hidden', current > lastScroll && current > 200);
            lastScroll = current;
        }, { passive: true });
    }

    // ── Articles Navigation Drawer ──────────────────────────────────
    (function () {
        var anTab    = document.getElementById('anTab');
        var anDrawer = document.getElementById('anDrawer');
        var anClose  = document.getElementById('anClose');
        if (!anTab || !anDrawer) return;

        var drawerOpen = false;

        function openDrawer() {
            drawerOpen = true;
            anDrawer.classList.add('an-open');
            anDrawer.setAttribute('aria-hidden', 'false');
            anTab.classList.add('an-is-open');
            anTab.setAttribute('aria-expanded', 'true');
        }

        function closeDrawer() {
            drawerOpen = false;
            anDrawer.classList.remove('an-open');
            anDrawer.setAttribute('aria-hidden', 'true');
            anTab.classList.remove('an-is-open');
            anTab.setAttribute('aria-expanded', 'false');
        }

        // Tab toggles drawer
        anTab.addEventListener('click', function (e) {
            e.stopPropagation();
            drawerOpen ? closeDrawer() : openDrawer();
        });

        // Close button
        if (anClose) {
            anClose.addEventListener('click', function (e) {
                e.stopPropagation();
                closeDrawer();
            });
        }

        // Click outside closes drawer
        document.addEventListener('click', function (e) {
            if (!drawerOpen) return;
            if (anDrawer.contains(e.target)) return;
            if (anTab.contains(e.target)) return;
            closeDrawer();
        });

        // Escape key
        document.addEventListener('keydown', function (e) {
            if ((e.key === 'Escape' || e.key === 'Esc') && drawerOpen) {
                closeDrawer();
                anTab.focus();
            }
        });

        // Smooth scroll on nav link click
        anDrawer.querySelectorAll('.an-link').forEach(function (link) {
            link.addEventListener('click', function (e) {
                var href = link.getAttribute('href');
                if (href.charAt(0) !== '#') { return; }   // external companion links open normally
                e.preventDefault();
                var targetId = href.slice(1);
                var targetEl = document.getElementById(targetId);
                if (targetEl) {
                    targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
                closeDrawer();
            });
        });

        // IntersectionObserver: highlight active article in the drawer list
        var sections = document.querySelectorAll('.article-section');
        var navLinks = anDrawer.querySelectorAll('.an-link');

        if (sections.length && 'IntersectionObserver' in window) {
            var anObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    var id = entry.target.id;
                    navLinks.forEach(function (l) {
                        l.classList.toggle('an-active', l.getAttribute('href') === '#' + id);
                    });
                });
            }, { rootMargin: '-15% 0px -65% 0px', threshold: 0 });

            sections.forEach(function (s) { anObserver.observe(s); });
        }
    })();
});
</script>

{% if ministryMusic.ambient and ministryMusic.ambient.length > 0 %}
<script>
    window.WOP_AMBIENT_TRACKS = [
        {% for track in ministryMusic.ambient %}
        { file: "https://media.wordsofplainness.org/web/{{ track.file }}", title: "{{ track.title }}", duration: "{{ track.duration }}" }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];
</script>
<script src="/js/ambient-player.js"></script>
{% endif %}
{% endblock %}
