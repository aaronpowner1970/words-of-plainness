<!-- Header Partial -->
<!-- This will be populated from the current site header -->

<header class="header">
    <div class="header-inner">
        <a href="/" class="logo">
            <img src="/assets/images/lantern_logo_line_art.png" alt="" class="header-lantern" width="54" height="54">
            <span class="logo-text">
                <span class="logo-title">WORDS OF PLAINNESS</span>
                <span class="logo-subtitle">{{ site.tagline }}</span>
            </span>
        </a>
        
        <nav class="nav-desktop">
            <ul class="nav-links">
                {% for item in navigation.main %}
                {% if item.url != "/new-here/" %}
                  {% if item.children %}
                  <li class="nav-has-dropdown">
                    {% set isChildActive = false %}
                    {% for child in item.children %}
                      {% if child.url in page.url %}{% set isChildActive = true %}{% endif %}
                    {% endfor %}
                    <button class="nav-dropdown-trigger{% if isChildActive %} active{% endif %}" aria-expanded="false" aria-haspopup="true">
                      {{ item.title }}
                      <svg class="nav-dropdown-arrow" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>
                    <div class="nav-dropdown" role="menu">
                      {% for child in item.children %}
                      <a href="{{ child.url }}" class="nav-dropdown-item{% if child.url in page.url %} active{% endif %}" role="menuitem">
                        <span class="nav-dropdown-title">{{ child.title }}</span>
                        <span class="nav-dropdown-desc">{{ child.descriptor }}</span>
                      </a>
                      {% endfor %}
                    </div>
                  </li>
                  {% else %}
                  <li><a href="{{ item.url }}"{% if (item.url == "/" and page.url == "/") or (item.url != "/" and item.url in page.url) %} class="active"{% endif %}>{{ item.title }}</a></li>
                  {% endif %}
                {% endif %}
                {% endfor %}
            </ul>
            <a href="/new-here/" class="btn-new-here">New Here?</a>

            <!-- Auth Buttons (shown when logged out) -->
            <div class="nav-auth-buttons" id="navAuthButtons">
                <button class="btn-sign-in" id="signInBtn">Sign In</button>
                <button class="btn-join-free" id="joinFreeBtn">Join Free</button>
            </div>

            <!-- User Menu (shown when logged in, hidden by default) -->
            <div class="user-menu hidden" id="userMenu">
                <button class="user-menu-toggle" id="userMenuToggle">
                    <span class="user-avatar" id="userAvatar"></span>
                    <span class="user-display-name" id="userName"></span>
                    <span class="user-menu-arrow">&#9660;</span>
                </button>
                <div class="user-dropdown" id="userDropdown">
                    <div class="user-dropdown-header">
                        <p class="user-dropdown-name" id="userDropdownName"></p>
                        <p class="user-dropdown-email" id="userDropdownEmail"></p>
                    </div>
                    <a class="user-dropdown-item" href="/my-reflections/">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        My Reflections &amp; Goals
                    </a>
                    <button class="user-dropdown-item" id="logoutBtn" data-action="logout">
                        Sign Out
                    </button>
                </div>
            </div>
        </nav>
        
        <button class="nav-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>

<script>
// Listen nav dropdown — dual activation: click + hover (250ms delay)
(function() {
  const container = document.querySelector('.nav-has-dropdown');
  if (!container) return;

  const trigger = container.querySelector('.nav-dropdown-trigger');
  let hoverTimer = null;

  function open() {
    container.classList.add('open');
    trigger.setAttribute('aria-expanded', 'true');
  }

  function close() {
    container.classList.remove('open');
    trigger.setAttribute('aria-expanded', 'false');
  }

  function toggle() {
    if (container.classList.contains('open')) close();
    else open();
  }

  // Click: toggle immediately, no navigation
  trigger.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    clearTimeout(hoverTimer);
    toggle();
  });

  // Hover: open after 250ms delay
  container.addEventListener('mouseenter', function() {
    hoverTimer = setTimeout(open, 250);
  });

  container.addEventListener('mouseleave', function() {
    clearTimeout(hoverTimer);
    close();
  });

  // Close on outside click
  document.addEventListener('click', function(e) {
    if (!container.contains(e.target)) close();
  });

  // Close on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') close();
  });
})();

// Mobile menu: Listen children expand/collapse
document.querySelectorAll('.mobile-menu-parent').forEach(function(btn) {
  btn.addEventListener('click', function() {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    const children = btn.nextElementSibling;
    if (children) {
      children.style.display = expanded ? 'none' : 'block';
    }
  });
});
</script>
