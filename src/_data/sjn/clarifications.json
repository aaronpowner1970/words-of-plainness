  "cases": [
    {
      "id": "ICC-001",
      "public_title": "Faith Alone, but Not Faith Without Fruit",
      "short_label": "Baptist sola fide and church discipline",
      "case_type": "APPARENT_TENSION_RESOLUTION",
      "primary_tradition_family": "Baptist",
      "subtradition_scope": "Southern Baptist + confessional/Reformed Baptist core; Free Will Baptist variation note",
      "counted": false,
      "quantitative_impact": "NONE — NOT COUNTED",
      "primary_hazard": "SLOGAN_COMPRESSION",
      "additional_hazards": [
        "APPARENT_CONTRADICTION",
        "ECCLESIAL_VS_SOTERIOLOGICAL",
        "FAMILY_VARIATION"
      ],
      "auto_priority": "HIGH",
      "display_mode": "AUTO_CUE_MANUAL_EXPANSION",
      "max_auto_cues": 1,
      "review_state": "APPROVED",
      "app_availability": "HOLD — LENS BALANCE (awaiting ICC-002)",
      "answer_authority": "APPROVED_CASE",
      "public_release": false,
      "release_hold_reason": "HOLD — LENS BALANCE (awaiting ICC-002)",
      "learner_question": "If Baptists teach justification by faith alone, why can persistent sin or heresy result in church discipline or excommunication?",
      "key_distinction": "Distinguish justification/standing before God from the congregation's judgment of visible profession, discipleship, and membership.",
      "resolution_summary": "In Southern and confessional/Reformed Baptist theology, works do not merit justification. Repentance, sanctification, perseverance, and obedience are expected fruits/evidences of regeneration. Church discipline therefore addresses visible profession and ecclesial fellowship rather than functioning as a church cancellation of God's justification.",
      "internal_variation": "Southern and confessional/Reformed Baptists typically resolve the tension through perseverance and evidentiary fruit. Free Will Baptists likewise deny salvation by works but allow that a genuinely saved person may later make shipwreck of faith and be lost.",
      "interfaith_significance": "The case shows why 'faith alone' is not equivalent to 'conduct does not matter.' It reveals substantial shared Christian concern for repentance, holiness, perseverance, accountability, and discipleship while preserving real differences in the theology of justification and security.",
      "does_not_prove": "It does not make Baptist and Latter-day Saint soteriology identical; it does not claim all Baptists share one perseverance model; and it does not treat excommunication as a direct determination of God's hidden judgment of regeneration.",
      "learner_cue_copy": "How can faith alone and church discipline both fit Baptist theology? See the distinction.",
      "explorer_category": "Salvation & discipleship",
      "anchor": {
        "type": "explorer_category",
        "value": "Salvation & discipleship",
        "related_predicate_ids": []
      },
      "author": {
