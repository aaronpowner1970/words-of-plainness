---
permalink: /posts/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Words of Plainness — Posts</title>
  <subtitle>Updates, reflections, and news from the Words of Plainness ministry</subtitle>
  <link href="{{ '/posts/feed.xml' | absoluteUrl }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/posts/' | absoluteUrl }}" rel="alternate" type="text/html"/>
  <id>{{ '/posts/' | absoluteUrl }}</id>
  <updated>{{ collections.posts | newestDate }}</updated>
  <author>
    <name>Brother Aaron</name>
  </author>
  <icon>{{ '/assets/favicons/favicon-32x32.png' | absoluteUrl }}</icon>
  {%- for post in collections.posts %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | absoluteUrl }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absoluteUrl }}</id>
    <published>{{ post.date | rfc3339Date }}</published>
    <updated>{{ post.date | rfc3339Date }}</updated>
    {%- if post.data.description %}
    <summary>{{ post.data.description }}</summary>
    {%- endif %}
    <author>
      <name>{{ post.data.author | default("Brother Aaron") }}</name>
    </author>
    {%- if post.data.tags %}
    {%- for tag in post.data.tags %}
    {%- if tag != "post" %}
    <category term="{{ tag }}"/>
    {%- endif %}
    {%- endfor %}
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>
