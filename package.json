{
  "name": "words-of-plainness",
  "version": "2.0.0",
  "description": "Words of Plainness - A Christ-Centered Ministry",
  "author": "Aaron Powner",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "eleventy --serve",
    "prebuild": "node scripts/sjn-verify-data.js && node scripts/sjn-verify-artwork.js && node scripts/lyrics-validate-prebuild.js && node scripts/check-narration-ids.js",
    "build": "eleventy",
    "postbuild": "npx pagefind --site _site",
    "debug": "DEBUG=Eleventy* eleventy",
    "clean": "rm -rf _site",
    "sjn:pipeline": "python scripts/sjn-build-data.py",
    "sjn:verify": "node scripts/sjn-verify-data.js",
    "sjn:artwork": "node scripts/sjn-verify-artwork.js",
    "aoid:floors": "node scripts/aoid-verify-floors.js",
    "aoid:counts": "node scripts/aoid-build-floor-counts.js --check"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "js-yaml": "^4.1.0",
    "pagefind": "^1.4.0"
  },
  "keywords": [
    "eleventy",
    "static-site",
    "ministry",
    "christian"
  ],
  "dependencies": {
    "music-metadata": "7.14.0"
  }
}
