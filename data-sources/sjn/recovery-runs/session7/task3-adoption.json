  "migration_order": [
   "every row gets the four columns",
   "NOT_APPLICABLE mechanically where the bare tier is CONCILIAR or CONFESSIONAL and the row is not a catechism by title",
   "ADOPTED only for the rows the author named, each with its adoption_act",
   "BSR-EO-01 and BSR-EO-02 ISSUED_UNADOPTED",
   "everything else UNVERIFIED"
  ],
  "second_tier": "OFFICIAL_EXPOSITION",
  "assert": "OFFICIAL_EXPOSITION ranks directly below CATECHETICAL in APP CONFIG authority_tier_rank; the harness asserts it and stops if it does not",
  "disclosure": {
   "UNVERIFIED": "adoption unverified",
   "ISSUED_UNADOPTED": "not officially adopted",
   "catechism_qualifier": "catechism, not synodally adopted",
   "adopted_narrow_scope": "the card names the adopting body and its reach, e.g. \"approved by the Russian Holy Synod (one church)\""
  }
 },
