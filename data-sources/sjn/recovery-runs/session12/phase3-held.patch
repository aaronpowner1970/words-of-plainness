+    def get(self, url):
+        html = self.pages.get(url, "")
+
+        class FR:
+            ok = bool(html); status = 200 if html else 404; error = "" if html else "missing"; final_url = url
+            redirects = []; cross_host_redirect = ""; content_type = "text/html"
+        FR.html = html
+        return FR()
